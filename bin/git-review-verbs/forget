#!/usr/bin/env sh
#
# git review forget — discard the persistent state a review leaves behind: the
# --delta markers (--delta), a review paused with git review save (--saved), or a
# walkthrough you drafted for someone else's PR (--draft). Exactly one mode is
# required.
#
# All three outlive the review/<branch> and review-fixes/<branch> branches on
# purpose — a later --delta keeps working, a paused review waits to be resumed,
# and a draft is prose you wrote by hand that a re-review can read again — so
# git review clean deliberately leaves them alone. This command is how you throw
# them away. To delete the review branches themselves, use git review clean.
#
set -eu

prog="git review forget"

usage() {
	cat <<EOF
usage: $prog --delta ([--] <branch> | --all | --stale [--dry-run])
       $prog --saved ([--] <branch> | --all) [--dry-run]
       $prog --draft ([--] <branch> | --all | --reviewed) [--dry-run]

Discard the persistent state a review leaves behind. Choose one mode:

  --delta   forget the recorded last-reviewed tip used by git review start --delta
  --saved   discard a review paused with git review save: delete
            review-saved/<branch>, its banked edits and metadata, and roll back
            the --delta marker it left
  --draft   delete a walkthrough you drafted with git review walkthrough draft

--delta targets:
  <branch>     forget the marker(s) for one source branch (remote and --local)
  --all        forget every recorded marker
  --stale      forget only markers whose branch no longer exists: remote markers
               when <remote>/<branch> is gone (fetches and prunes first), local
               markers when the local <branch> is gone
  --dry-run    with --stale, list what would be forgotten without forgetting it

--saved targets:
  <branch>     discard the saved review for one source branch
  --all        discard every saved review
  --dry-run    list what would be discarded without discarding it

--draft targets:
  <branch>     delete the draft written for one branch
  --all        delete every draft
  --reviewed   delete only the drafts whose review is over: the ones written
               against a tip your last completed review of that branch covered
  --dry-run    list what would be deleted without deleting it
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

mode=""
arg=""
all=0
stale=0
reviewed=0
dryrun=0

# set_mode <kind>: pick which kind of state to discard. Repeating one flag is
# harmless; naming two different ones is ambiguous and is refused.
set_mode() {
	if [ -n "$mode" ] && [ "$mode" != "$1" ]; then
		die "use only one of --delta, --saved and --draft"
	fi
	mode="$1"
}

# The one positional (the branch), taken the same way whether it arrived before
# "--" or after it, so the two spellings cannot disagree on the shape.
take_positional() {
	if [ -n "$arg" ]; then
		echo "error: unexpected argument $1" >&2
		usage >&2
		exit 1
	fi
	arg="$1"
}
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--delta) set_mode delta ;;
	--saved) set_mode saved ;;
	--draft) set_mode draft ;;
	--all) all=1 ;;
	--stale) stale=1 ;;
	--reviewed) reviewed=1 ;;
	--dry-run) dryrun=1 ;;
	# Ends option parsing, as git does and walkthrough draft already does. Uniformity,
	# not safety — git refuses a ref name starting with "-", so no branch can arrive
	# disguised as a flag. Fixes a caller that spells arguments defensively from
	# having to know which verb accepts "--" and which answers "unknown option --".
	# Must stay above the -* arm, which would otherwise claim it.
	--)
		shift
		while [ $# -gt 0 ]; do
			take_positional "$1"
			shift
		done
		break
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*) take_positional "$1" ;;
	esac
	shift
done

# The mode selects which kind of state to discard; without it the request is
# ambiguous (markers? a saved review?), so there is no safe default.
if [ -z "$mode" ]; then
	usage >&2
	exit 1
fi

# ── --saved ─────────────────────────────────────────────────────────────────────
if [ "$mode" = saved ]; then
	[ "$stale" -eq 0 ] || die "--stale only applies to --delta"
	[ "$reviewed" -eq 0 ] || die "--reviewed only applies to --draft"

	if [ -n "$arg" ] && [ "$all" -eq 1 ]; then
		die "use either <branch> or --all, not both"
	fi
	if [ -z "$arg" ] && [ "$all" -eq 0 ]; then
		usage >&2
		exit 1
	fi

	git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

	# Only for walk_saved_draft_path: a saved review may carry the reviewer's own
	# walkthrough draft, and discarding the review discards that too. Sourcing is
	# free of side effects — the library defines functions and nothing else.
	# shellcheck source=../git-review-lib.sh
	. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

	# Resolved once in this shell rather than per "$(walk_saved_draft_path ...)",
	# which --all calls once per saved review (see walk_gitdir_init).
	walk_gitdir_init

	cur="$(git symbolic-ref --quiet --short HEAD || true)"

	# forget_saved_one <src>: discard the saved review for one source branch.
	forget_saved_one() {
		src="$1"
		saved="review-saved/$src"
		if ! git rev-parse --verify --quiet "refs/heads/$saved" >/dev/null; then
			echo "no saved review for $src" >&2
			return
		fi
		if [ "$dryrun" -eq 1 ]; then
			echo "would discard saved review of $src"
			return
		fi
		if [ "$saved" = "$cur" ]; then
			echo "skipping $src (its branch is currently checked out)" >&2
			return
		fi

		# Roll the --delta marker back to the last actual review before the metadata
		# disappears with the branch. Local reviews track their marker in a separate
		# config section, matching git review start / git review abort.
		if [ "$(git config "branch.$saved.reviewlocal" || true)" = "1" ]; then
			markerkey="reviewworkflowlocal.$src.reviewed"
		else
			markerkey="reviewworkflow.$src.reviewed"
		fi
		prevreviewed="$(git config "branch.$saved.reviewprevreviewed" || true)"
		if [ -n "$prevreviewed" ]; then
			git config "$markerkey" "$prevreviewed"
		else
			git config --unset "$markerkey" 2>/dev/null || true
		fi

		git for-each-ref --format='%(refname)' "refs/review-saved-edits/$src/" | while read -r ref; do
			git update-ref -d "$ref"
		done
		# The reviewer's own walkthrough draft goes with it: discarding a paused review
		# deliberately discards the reading order it was paused with. Named via
		# walk_review_draft_src, not the review's own source — wrong for a compare of a
		# remote-tracking branch, and getting it wrong here leaves the real file behind,
		# unclaimed. Filtered by walk_saved_draft_filed too: a review paused without a
		# draft shares the name but not the file, and deleting it here destroyed another
		# paused review's only copy of its prose.
		draftsrc="$(walk_review_draft_src "$saved")"
		saveddraft="$(walk_saved_draft_path "$draftsrc")"
		hadraft=0
		if walk_saved_draft_filed "$saved" && [ -f "$saveddraft" ]; then
			hadraft=1
			rm -f "$saveddraft"
		fi
		git branch -D "$saved" >/dev/null

		echo "discarded saved review of $src"
		# Named, not left to be inferred: the draft is hand-written prose every other
		# verb preserves (clean won't touch one), so the one command that destroys it
		# should say so out loud.
		if [ "$hadraft" -eq 1 ]; then
			echo "note: its walkthrough draft for $draftsrc went with it" >&2
		fi
	}

	if [ "$all" -eq 1 ]; then
		branches="$(git for-each-ref --format='%(refname:short)' refs/heads/review-saved/)"
		[ -n "$branches" ] || {
			echo "no saved reviews"
			exit 0
		}
		printf '%s\n' "$branches" | while read -r b; do
			forget_saved_one "${b#review-saved/}"
		done
	else
		forget_saved_one "$arg"
	fi
	exit 0
fi

# ── --draft ─────────────────────────────────────────────────────────────────────
# The reviewer's own walkthrough for someone else's PR. git review clean never
# touches it — hand-written prose that outlives the review — so this is the way
# to throw one away.
#
# Only the active namespace: a draft that travelled with a paused review lives in
# review-saved-walkthrough/ and belongs to that review, which forget --saved
# discards as a whole. Two namespaces, one owner each.
#
# The directory a namespaced draft created is left behind empty, like git leaves
# .git/refs/heads/<ns>/ after the last branch in it.
if [ "$mode" = draft ]; then
	[ "$stale" -eq 0 ] || die "--stale only applies to --delta"

	# Exactly one target selector, the shape --delta already has: a branch, --all
	# or the inferred set. Counted rather than tested pairwise so a third one can
	# never be added without deciding what it means next to the other two.
	selectors=0
	[ -n "$arg" ] && selectors=$((selectors + 1))
	[ "$all" -eq 1 ] && selectors=$((selectors + 1))
	[ "$reviewed" -eq 1 ] && selectors=$((selectors + 1))
	if [ "$selectors" -eq 0 ]; then
		usage >&2
		exit 1
	fi
	[ "$selectors" -eq 1 ] || die "use only one of <branch>, --all and --reviewed"

	git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

	# For walk_draft_path / walk_draft_list.
	# shellcheck source=../git-review-lib.sh
	. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

	# Once, here: every path below is built inside a "$(...)", where a cache written
	# by walk_draft_path would die with the subshell — and --all builds one per
	# draft (see walk_gitdir_init).
	walk_gitdir_init

	# A draft's file name is its branch name, so an argument that is not a legal
	# branch name is not a draft — unchecked, it addressed any file on disk:
	# "forget --draft ../../../notes" deleted <gitdir>/../../../notes.md and reported
	# having forgotten a draft. Checked against the ref name git itself would accept,
	# which rejects ".." as a path component. Only the typed argument needs it: the
	# inferred sets' names come from the namespace they just read, and the other two
	# modes were never exposed this way — --saved resolves a ref, --delta a config
	# key, so an invented name is a no-op in both.
	if [ -n "$arg" ] && ! git check-ref-format "refs/heads/$arg" 2>/dev/null; then
		die "not a valid branch name: $arg"
	fi

	# live_walk_reader <src>: the review branch currently reading the draft for
	# <src>, or nothing.
	#
	# Found by asking each review which draft it records (walk_review_draft_src), not
	# by assuming the review is named after the branch: a compare of origin/feature/x
	# lives on review/origin/feature/x and drafts for feature/x — testing review/<src>
	# alone said nothing for exactly the reviews that most needed it.
	#
	# Walk reviews only, filtered explicitly: the name is recorded in every mode
	# (custody is mode-blind), so without the filter step/whole reviews of the same
	# branch, which never read the draft, would match.
	live_walk_reader() {
		git for-each-ref --format='%(refname:short)' refs/heads/review/ |
			while IFS= read -r _lwr_rb; do
				[ -n "$_lwr_rb" ] || continue
				[ "$(git config "branch.$_lwr_rb.reviewmode" || true)" = walk ] || continue
				if [ "$(walk_review_draft_src "$_lwr_rb")" = "$1" ]; then
					printf '%s' "$_lwr_rb"
					return 0
				fi
			done
	}

	# forget_draft_one <src>: delete the draft written for one branch.
	forget_draft_one() {
		_fd_src="$1"
		_fd_path="$(walk_draft_path "$_fd_src")"
		if [ ! -f "$_fd_path" ]; then
			echo "no walkthrough draft for $_fd_src" >&2
			return
		fi
		if [ "$dryrun" -eq 1 ]; then
			echo "would forget the walkthrough draft for $_fd_src"
			return
		fi
		rm -f "$_fd_path"
		echo "forgot the walkthrough draft for $_fd_src"
		# Deleting it under a live review is allowed — going back to the author's
		# order is a legitimate thing to want — but it changes what that review
		# reads, so say so rather than let it be discovered at the next cursor move.
		_fd_reader="$(live_walk_reader "$_fd_src")"
		if [ -n "$_fd_reader" ]; then
			echo "note: $_fd_reader was reading it; that review falls back to the PR's own walkthrough, or to the whole diff if it has none" >&2
		fi
	}

	# forget_orphan_draft_one <src>: delete one archived draft that no paused review
	# can reclaim. save/continue give the archive exactly one owner per entry, until
	# that owner is deleted by hand (branch -D review-saved/x, a prune) and the file
	# answers to nothing: --saved refuses without the ref, --draft spells names in the
	# active namespace only, and clean is deliberately hands-off in both. Swept here
	# rather than given its own flag: --all already means "every draft I am still
	# holding", and an ownerless entry is just a file, not a paused review's prose.
	forget_orphan_draft_one() {
		_fo_src="$1"
		if [ "$dryrun" -eq 1 ]; then
			echo "would forget the archived walkthrough draft for $_fo_src (no paused review left to restore it)"
			return
		fi
		rm -f "$(walk_saved_draft_path "$_fo_src")"
		echo "forgot the archived walkthrough draft for $_fo_src (no paused review left to restore it)"
	}

	# ── --reviewed ────────────────────────────────────────────────────────────
	# The inferred set, like --delta --stale: every draft written against a tip a
	# completed review already covered — these are the ones you cannot name, since
	# after a handful of reviews you no longer remember which branches still hold
	# prose.
	#
	# A draft a live review is READING is skipped, not deleted — the opposite of
	# naming one by hand. Degrading a review's draft to the author's order is fine
	# to ask for explicitly and bad to have happen as part of an unenumerated sweep;
	# without this filter the sweep would take the one draft still in use.
	if [ "$reviewed" -eq 1 ]; then
		swept=0
		skipped=0
		# A here-doc while-read (not a pipe): forget_draft_one must run in this
		# shell, and so must the two counters below.
		while IFS= read -r d; do
			[ -n "$d" ] || continue
			reader="$(live_walk_reader "$d")"
			if [ -n "$reader" ]; then
				echo "skipping $d ($reader is reading it)" >&2
				skipped=$((skipped + 1))
				continue
			fi
			forget_draft_one "$d"
			swept=$((swept + 1))
		done <<EOF
$(walk_reviewed_draft_list)
EOF
		# Only when nothing matched at all. A sweep that skipped every candidate
		# has already said so on stderr, line by line, and "none" on top of that
		# would contradict it.
		if [ "$swept" -eq 0 ] && [ "$skipped" -eq 0 ]; then
			echo "no walkthrough drafts whose review is over"
		fi
		exit 0
	fi

	if [ "$all" -eq 1 ]; then
		drafts="$(walk_draft_list)"
		# What the paused reviews claim, asked of each review rather than derived from
		# the file's name: a compare of origin/feature/x is paused as
		# review-saved/origin/feature/x but drafts for feature/x, so testing
		# refs/heads/review-saved/<file name> said "no paused review" for exactly those
		# reviews — deleting a live paused review's reading order, with continue then
		# finding "the walkthrough this review was reading is gone" and abort the only
		# way out.
		claims="$(walk_saved_draft_claims | cut -f1)"
		# Filtered before the emptiness test below, not while deleting: an archive
		# entry whose review is still paused is not garbage and must not make the
		# difference between "no walkthrough drafts" and silence.
		orphans=""
		while IFS= read -r d; do
			[ -n "$d" ] || continue
			if printf '%s\n' "$claims" | grep -Fxq -e "$d"; then
				continue
			fi
			orphans="$orphans$d
"
		done <<EOF
$(walk_saved_draft_list)
EOF
		if [ -z "$drafts" ] && [ -z "$orphans" ]; then
			echo "no walkthrough drafts"
			exit 0
		fi
		# A here-doc while-read (not a pipe): forget_draft_one must run in this
		# shell, the same reason the --delta loop below reads from a temp file.
		while IFS= read -r d; do
			[ -n "$d" ] || continue
			forget_draft_one "$d"
		done <<EOF
$drafts
EOF
		while IFS= read -r d; do
			[ -n "$d" ] || continue
			forget_orphan_draft_one "$d"
		done <<EOF
$orphans
EOF
	else
		forget_draft_one "$arg"
	fi
	exit 0
fi

# ── --delta ─────────────────────────────────────────────────────────────────────
# parse_marker <key>: split into source branch ($msrc), human label ($mlabel) and
# whether it is local ($mislocal). Local markers live in their own section,
# reviewworkflowlocal.<src>.reviewed, not a .local segment inside
# reviewworkflow.<src>.reviewed — which would be ambiguous for a branch literally
# named "<src>.local".
parse_marker() {
	case "$1" in
	reviewworkflowlocal.*)
		msrc="${1#reviewworkflowlocal.}"
		msrc="${msrc%.reviewed}"
		mlabel=" (local)"
		mislocal=1
		;;
	*)
		msrc="${1#reviewworkflow.}"
		msrc="${msrc%.reviewed}"
		mlabel=""
		mislocal=0
		;;
	esac
}

# forget_delta <key> <src> <verb>: unset a marker (or, in dry-run, say it would be).
forget_delta() {
	if [ "$dryrun" -eq 1 ]; then
		echo "would forget delta marker for $2$3"
	else
		git config --unset "$1" || true
		echo "forgot delta marker for $2$3"
	fi
}

[ "$reviewed" -eq 0 ] || die "--reviewed only applies to --draft"

# Exactly one target selector: a branch, --all or --stale.
selectors=0
[ -n "$arg" ] && selectors=$((selectors + 1))
[ "$all" -eq 1 ] && selectors=$((selectors + 1))
[ "$stale" -eq 1 ] && selectors=$((selectors + 1))
if [ "$selectors" -eq 0 ]; then
	usage >&2
	exit 1
fi
[ "$selectors" -eq 1 ] || die "use only one of <branch>, --all and --stale"

# --dry-run is a preview of the inferred --stale set; it means nothing for the
# explicit targets, where you already named exactly what to forget.
if [ "$dryrun" -eq 1 ] && [ "$stale" -ne 1 ]; then
	die "--dry-run only applies to --stale"
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# Remote whose branches back the markers; defaults to origin, override with
# reviewworkflow.remote.
remote="$(git config reviewworkflow.remote || echo origin)"

# ── one branch ────────────────────────────────────────────────────────────────
if [ -n "$arg" ]; then
	any=0
	if [ -n "$(git config "reviewworkflow.$arg.reviewed" || true)" ]; then
		forget_delta "reviewworkflow.$arg.reviewed" "$arg" ""
		any=1
	fi
	if [ -n "$(git config "reviewworkflowlocal.$arg.reviewed" || true)" ]; then
		forget_delta "reviewworkflowlocal.$arg.reviewed" "$arg" " (local)"
		any=1
	fi
	[ "$any" -eq 1 ] || echo "no delta marker recorded for $arg"
	exit 0
fi

# Collect every marker into a temp file so the loop runs in the current shell
# (a pipe into `while` would forget unsets in a subshell). Both sections are
# gathered: remote markers (reviewworkflow.*) and local ones (reviewworkflowlocal.*).
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
{
	git config --get-regexp '^reviewworkflow\..*\.reviewed$' 2>/dev/null || true
	git config --get-regexp '^reviewworkflowlocal\..*\.reviewed$' 2>/dev/null || true
} >"$tmp"

if [ ! -s "$tmp" ]; then
	echo "no delta markers recorded"
	exit 0
fi

# ── --stale ───────────────────────────────────────────────────────────────────
if [ "$stale" -eq 1 ]; then
	# A local marker's staleness is decided entirely by whether its local branch
	# still exists — no remote state involved. Only fetch (to prune deleted
	# remote-tracking refs) when at least one remote marker is present; a set of
	# purely --local markers needs no network at all. The anchored pattern matches
	# reviewworkflow.<src>.reviewed but not reviewworkflowlocal.<src>.reviewed.
	if grep -q '^reviewworkflow\.' "$tmp"; then
		git fetch --prune --quiet "$remote" || die "could not fetch from $remote"
	fi

	any=0
	while read -r key _; do
		[ -n "$key" ] || continue
		parse_marker "$key"
		if [ "$mislocal" -eq 1 ]; then
			# A local marker is stale when its local branch is gone.
			git rev-parse --verify --quiet "refs/heads/$msrc" >/dev/null && continue
			forget_delta "$key" "$msrc" " (local; $msrc no longer exists)"
		else
			git rev-parse --verify --quiet "refs/remotes/$remote/$msrc" >/dev/null && continue
			forget_delta "$key" "$msrc" " ($remote/$msrc no longer exists)"
		fi
		any=1
	done <"$tmp"

	[ "$any" -eq 1 ] || echo "no stale delta markers (every branch still exists)"
	exit 0
fi

# ── --all ─────────────────────────────────────────────────────────────────────
while read -r key _; do
	[ -n "$key" ] || continue
	parse_marker "$key"
	forget_delta "$key" "$msrc" "$mlabel"
done <"$tmp"
