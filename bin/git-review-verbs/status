#!/usr/bin/env sh
#
# git review status — show the state of the review on the current branch.
#
set -eu

prog="git review status"

usage() {
	cat <<EOF
usage: $prog [--porcelain | --why <path>]

Show the state of the review on the current review/* branch: source PR, mode,
and (in commit-by-commit mode) which commit you are on and which steps have
banked edits.

  --porcelain     machine-readable output, stable across git-review versions
                  (see the README for the format); exit codes 0/1/2/3
  --why <path>    print only the walkthrough's explanatory text for <path>,
                  nothing else (walk mode only)
EOF
}

porcelain=0
why=""
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--porcelain)
		if [ -n "$why" ]; then
			echo "error: --porcelain and --why are mutually exclusive" >&2
			usage >&2
			exit 1
		fi
		porcelain=1
		;;
	--why)
		if [ "$porcelain" -eq 1 ]; then
			echo "error: --porcelain and --why are mutually exclusive" >&2
			usage >&2
			exit 1
		fi
		shift
		if [ $# -eq 0 ] || [ -z "$1" ]; then
			echo "error: --why requires a path" >&2
			usage >&2
			exit 1
		fi
		why="$1"
		;;
	*)
		echo "error: unexpected argument $1" >&2
		usage >&2
		exit 1
		;;
	esac
	shift
done

git rev-parse --git-dir >/dev/null 2>&1 || {
	echo "error: not a git repository" >&2
	exit 1
}

cur="$(git symbolic-ref --quiet --short HEAD || true)"
case "$cur" in
review/*) ;;
*)
	echo "not on a review/* branch (HEAD is ${cur:-detached})" >&2
	exit 2
	;;
esac

src="$(git config "branch.$cur.reviewsource" || true)"
tip="$(git config "branch.$cur.reviewtip" || true)"
mode="$(git config "branch.$cur.reviewmode" || echo whole)"
if [ -z "$src" ] || [ -z "$tip" ]; then
	echo "error: missing review metadata; was $cur created with git review start?" >&2
	exit 1
fi

# Shared helpers, sourced from the libexec directory the dispatcher points us at.
# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

if [ -n "$why" ]; then
	if [ "$mode" != "walk" ]; then
		echo "error: --why only applies to a review with a walkthrough (mode is $mode)" >&2
		exit 1
	fi
	load_walk_review_meta
	if ! printf '%s\n' "$walkpaths" | grep -Fxq "$why"; then
		echo "error: $why is not in the current walkthrough sequence" >&2
		exit 1
	fi
	walk_why "$tip" "$why"
	exit 0
fi

if [ "$porcelain" -eq 1 ]; then
	tab="$(printf '\t')"
	case "$mode" in
	step)
		load_step_review_meta
		pcurrent="$(git rev-parse --short "$(printf '%s\n' "$commits" | sed -n "${step}p")")"
		porcelain_row state "$cur" "$src" "$tip" step none "$step" "$total" "$count" "$pcurrent"
		i=1
		while [ "$i" -le "$total" ]; do
			ish="$(git rev-parse --short "$(printf '%s\n' "$commits" | sed -n "${i}p")")"
			banked=0
			if git rev-parse --verify --quiet "refs/review-edits/$src/$i" >/dev/null; then
				banked=1
			fi
			porcelain_row entry "$i" "$ish" "$banked"
			i=$((i + 1))
		done
		;;
	walk)
		load_walk_review_meta
		pcurrent="$(printf '%s\n' "$walkpaths" | sed -n "${walkstep}p")"
		essential=0
		if walk_is_key "$tip" "$pcurrent"; then
			essential=1
		fi
		porcelain_row state "$cur" "$src" "$tip" walk applied "$walkstep" "$total" "$walkcount" "$pcurrent" "$essential"
		printf '%s\n' "$walkpaths" | walk_entry_fields "$tip" | while IFS="$tab" read -r epos epath eess eann; do
			porcelain_row entry "$epos" "$epath" "$eess" "$eann"
		done
		;;
	*)
		pwalkthrough=none
		if walk_read "$tip" >/dev/null; then
			pwalkpaths="$(walk_sequence "$tip" "$(git rev-parse HEAD)")"
			if [ -n "$pwalkpaths" ]; then
				pwalkthrough=applied
			else
				pwalkthrough=degraded
			fi
		fi
		porcelain_row state "$cur" "$src" "$tip" "$mode" "$pwalkthrough"
		;;
	esac
	exit 0
fi

printf 'review of %s (tip %s)\n' "$src" "$(git rev-parse --short "$tip")"
printf '  branch  %s\n' "$cur"

if [ "$mode" = "step" ]; then
	count="$(git config "branch.$cur.reviewcount" || true)"
	step="$(git config "branch.$cur.reviewstep" || true)"
	start="$(git config "branch.$cur.reviewstart" || true)"
	# A key deleted by a hand-edit (while reviewmode stays "step") would otherwise
	# let set -e kill the bare read silently mid-script; read with || true and report
	# it. reviewstep falls through to the numeric guard below for a precise message.
	if [ -z "$count" ] || [ -z "$start" ]; then
		echo "error: missing review metadata; was $cur created with git review start?" >&2
		exit 1
	fi
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"
	# Guard against a step that maps to no commit (corrupt config, hand-edited
	# metadata): otherwise cnow ends up empty and git rev-parse '' crashes while
	# the printf around it still "succeeds", printing a corrupt status line.
	total="$(printf '%s\n' "$commits" | grep -c .)"
	case "$step" in
	'' | *[!0-9]*)
		echo "error: corrupt review metadata: reviewstep is '$step', not a positive integer" >&2
		exit 1
		;;
	esac
	if [ "$step" -lt 1 ] || [ "$step" -gt "$total" ]; then
		echo "error: review step $step out of range (1..$total) — corrupt metadata?" >&2
		exit 1
	fi
	cnow="$(printf '%s\n' "$commits" | sed -n "${step}p")"
	printf '  mode    step  [%s/%s] on %s %s\n' "$step" "$count" \
		"$(git rev-parse --short "$cnow")" "$(git log -1 --format='%s' "$cnow")"

	banked=""
	i=1
	while [ "$i" -le "$count" ]; do
		if git rev-parse --verify --quiet "refs/review-edits/$src/$i" >/dev/null; then
			banked="$banked $i"
		fi
		i=$((i + 1))
	done
	printf '  banked  %s\n' "${banked:- none}"

	hint="git review next"
	[ "$step" -gt 1 ] && hint="$hint / git review prev"
	printf '  next    edit, then %s  (git review finish when done)\n' "$hint"
elif [ "$mode" = "walk" ]; then
	# Re-derive the reading sequence to report the live [k/N] and current path, the
	# same way the walk commands do.
	walkstep="$(git config "branch.$cur.reviewwalkstep" || true)"
	walkcount="$(git config "branch.$cur.reviewwalkcount" || true)"
	walkpaths="$(walk_reading_order "$tip" "$(git rev-parse HEAD)")"
	total="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
	case "$walkstep" in
	'' | *[!0-9]*)
		echo "error: corrupt review metadata: reviewwalkstep is '$walkstep', not a positive integer" >&2
		exit 1
		;;
	esac
	if [ "$walkstep" -lt 1 ] || [ "$walkstep" -gt "$total" ]; then
		walk_range_error "$walkstep" "$total" "$walkcount"
	fi
	pnow="$(printf '%s\n' "$walkpaths" | sed -n "${walkstep}p")"
	mark=""
	if walk_is_annotated "$tip" "$pnow"; then
		if walk_is_key "$tip" "$pnow"; then
			mark="  (key)"
		fi
	else
		mark="  (uncovered)"
	fi
	printf '  mode    walk  [%s/%s] on %s%s\n' "$walkstep" "$total" "$pnow" "$mark"
	hint="git review next"
	[ "$walkstep" -gt 1 ] && hint="$hint / git review prev"
	printf '  next    read, then %s  (git review finish when done)\n' "$hint"
else
	base="$(git config "branch.$cur.reviewbase" || true)"
	printf '  mode    whole%s\n' "${base:+  (base $base)}"
	printf '  next    edit, then git review finish\n'
fi
