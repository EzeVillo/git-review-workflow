<?xml version="1.0" encoding="utf-8"?>
<!--
  Three things live here:

    - View > Other Windows > git review, which opens the tool window.
    - The tool window's own toolbar: Refresh / Finish / Save / Cancel / Preview
      edits, the five title_actions of contracts/client-product-surface.yaml. This
      is where the other two clients put them (VS Code: menus/view/title; IntelliJ:
      ToolWindow.setTitleActions), and a tool-window toolbar is the same place in
      Visual Studio — the shell draws it inside the window frame, under the caption.
      Which of the five is showing at any moment is not decided here: the buttons
      are DefaultInvisible + DynamicVisibility and GitReviewPackage answers
      QueryStatus from PanelLayout.TitleActions, so the CLI's situation drives them
      exactly as it drives the panel body.
    - Tools > git review: every product action this client offers, in the same order
      and with the same names as the JetBrains Tools menu and the VS Code command
      palette. That is the contract's 27 minus openAllChanges, which is marked
      not_in: [visualstudio] there — opening a whole range at once would be one
      comparison window per file in this host, so the action does not exist here at
      all rather than existing badly in a second place. The panel is not the only way
      in for the rest — several exist *only* here (goToEntry, forgetReview,
      previewEditsStat, showCliLog are panel_excluded in the contract), which is why
      each one has to be present: an action with no surface is an action a reviewer
      cannot run. Each button routes to the panel's own action path
      (GitReviewPackage.InvokeMenuAction), so a menu entry and the button that shares
      its name run the same code.

  Icons are Image Catalog monikers (IconIsMoniker) rather than a bitmap strip, so
  they follow the host theme and the HiDPI scaling the shell already does.

  Compiled into Menus.ctmenu by the VSSDK build and referenced from the
  ProvideMenuResource attribute on GitReviewPackage.
-->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <!-- ImageCatalogGuid + the moniker ids used below; ships with the VSSDK build tools. -->
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidGitReviewPackage">
    <Menus>
      <!--
        No <Parent>: a ToolWindowToolbar is parented at runtime by the pane that
        names it in ToolWindowPane.ToolBar, not from the command table.
      -->
      <Menu guid="guidGitReviewCmdSet" id="ToolWindowToolbar" type="ToolWindowToolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>git review</ButtonText>
        </Strings>
      </Menu>

      <!-- Tools > git review. A submenu rather than a flat block of 27 entries in the
           Tools menu, which is where the JetBrains plugin puts the same group. -->
      <Menu guid="guidGitReviewCmdSet" id="ToolsMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_EXT_TOOLS" />
        <Strings>
          <ButtonText>git review</ButtonText>
          <CommandName>git review</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidGitReviewCmdSet" id="ToolWindowToolbarGroup" priority="0x0000">
        <Parent guid="guidGitReviewCmdSet" id="ToolWindowToolbar" />
      </Group>

      <!-- Three groups so the shell draws the separators the JetBrains menu has:
           the review's own lifecycle, then reading it, then everything around it. -->
      <Group guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" priority="0x0100">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenu" />
      </Group>
      <Group guid="guidGitReviewCmdSet" id="ToolsMenuGroupRead" priority="0x0200">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenu" />
      </Group>
      <Group guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" priority="0x0300">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidGitReviewCmdSet" id="cmdidShowToolWindow" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Strings>
          <ButtonText>git review</ButtonText>
        </Strings>
      </Button>

      <!-- Order matches title_actions in the contract, and the other two clients. -->
      <Button guid="guidGitReviewCmdSet" id="cmdidTitleRefresh" priority="0x0100" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolWindowToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Refresh</ButtonText>
          <ToolTipText>Refresh the git review panel</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidTitleFinish" priority="0x0200" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolWindowToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Checkmark" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Finish</ButtonText>
          <ToolTipText>Finish the active review</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidTitleSave" priority="0x0300" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolWindowToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Save" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Save</ButtonText>
          <ToolTipText>Save the review for later</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidTitleCancel" priority="0x0400" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolWindowToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="Cancel" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Cancel</ButtonText>
          <ToolTipText>Cancel the active review</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidTitlePreviewEdits" priority="0x0500" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolWindowToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="CompareFiles" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Preview edits</ButtonText>
          <ToolTipText>Preview banked edits</ToolTipText>
        </Strings>
      </Button>

      <!--
        Tools > git review. Names match the JetBrains menu and the VS Code palette
        word for word; the order is the JetBrains one, and the three groups above put
        the separators in the same two places. Kept in sync with
        GitReviewPackage.MenuCommands and with contracts/client-product-surface.yaml
        by scripts/check-client-product-surface.mjs.
      -->
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuRefresh" priority="0x0100" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Refresh</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuStartReview" priority="0x0200" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Start a Review</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuContinueReview" priority="0x0300" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Continue Saved Review</ButtonText>
        </Strings>
      </Button>
      <!--
        Finish / Save / Cancel / Preview Edits are the four entries whose enablement
        follows the situation (GitReviewPackage.GatedMenuCommands). No DynamicVisibility:
        they stay listed and go grey, which is what the JetBrains menu does — a menu that
        loses entries as the review moves is harder to learn than one that greys them.
      -->
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuFinishReview" priority="0x0400" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Finish Review</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuSaveReview" priority="0x0500" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Save Review for Later</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuAbortReview" priority="0x0600" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Cancel Review</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuUndoFinish" priority="0x0700" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Undo Finish</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuResumeFinish" priority="0x0800" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupReview" />
        <Strings>
          <ButtonText>Resume Finish</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidGitReviewCmdSet" id="cmdidMenuNext" priority="0x0100" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupRead" />
        <Strings>
          <ButtonText>Next Entry</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuPrev" priority="0x0200" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupRead" />
        <Strings>
          <ButtonText>Previous Entry</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuGoToEntry" priority="0x0300" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupRead" />
        <Strings>
          <ButtonText>Go to Entry</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuOpenEntry" priority="0x0400" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupRead" />
        <Strings>
          <ButtonText>Open Entry</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuOpenChange" priority="0x0500" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupRead" />
        <Strings>
          <ButtonText>Open Changes</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuShowWhy" priority="0x0700" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupRead" />
        <Strings>
          <ButtonText>Show Why</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidGitReviewCmdSet" id="cmdidMenuSetBase" priority="0x0100" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Set the Base Branch</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuSetRemote" priority="0x0200" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Set the Remote</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuCleanReview" priority="0x0300" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Clean</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuForgetReview" priority="0x0400" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Forget Saved Review or Delta Marker</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuDiscardInventory" priority="0x0500" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Discard Inventory Review</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuPreviewEdits" priority="0x0600" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Preview Edits</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuPreviewEditsStat" priority="0x0700" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Preview Edits (stat)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuCompareReview" priority="0x0800" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Compare Revisions</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuWalkthroughInit" priority="0x0900" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Walkthrough: Init</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuWalkthroughBuild" priority="0x0A00" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Walkthrough: Build</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuInstallCli" priority="0x0B00" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>How to Install the CLI</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitReviewCmdSet" id="cmdidMenuShowCliLog" priority="0x0C00" type="Button">
        <Parent guid="guidGitReviewCmdSet" id="ToolsMenuGroupTools" />
        <Strings>
          <ButtonText>Show CLI Log</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidGitReviewPackage" value="{a3f8c2e1-7b4d-4e9a-9c1f-2d5e6a8b0c3d}" />
    <GuidSymbol name="guidGitReviewCmdSet" value="{c7d4e8a5-1f36-4b92-8a70-6d5e4c3b2a19}">
      <IDSymbol name="cmdidShowToolWindow" value="0x0100" />
      <!-- Keep these five in sync with GitReviewPackage.TitleBarCommands. -->
      <IDSymbol name="cmdidTitleRefresh" value="0x0101" />
      <IDSymbol name="cmdidTitleFinish" value="0x0102" />
      <IDSymbol name="cmdidTitleSave" value="0x0103" />
      <IDSymbol name="cmdidTitleCancel" value="0x0104" />
      <IDSymbol name="cmdidTitlePreviewEdits" value="0x0105" />

      <!-- Tools > git review: keep these 27 in sync with GitReviewPackage.MenuCommands. -->
      <IDSymbol name="cmdidMenuRefresh" value="0x0201" />
      <IDSymbol name="cmdidMenuStartReview" value="0x0202" />
      <IDSymbol name="cmdidMenuContinueReview" value="0x0203" />
      <IDSymbol name="cmdidMenuFinishReview" value="0x0204" />
      <IDSymbol name="cmdidMenuSaveReview" value="0x0205" />
      <IDSymbol name="cmdidMenuAbortReview" value="0x0206" />
      <IDSymbol name="cmdidMenuUndoFinish" value="0x0207" />
      <IDSymbol name="cmdidMenuResumeFinish" value="0x0208" />
      <IDSymbol name="cmdidMenuNext" value="0x0209" />
      <IDSymbol name="cmdidMenuPrev" value="0x020A" />
      <IDSymbol name="cmdidMenuGoToEntry" value="0x020B" />
      <IDSymbol name="cmdidMenuOpenEntry" value="0x020C" />
      <IDSymbol name="cmdidMenuOpenChange" value="0x020D" />
      <!-- 0x020E was Open All Changes: not_in: [visualstudio] in the product-surface
           contract. The value stays retired so the ids below keep their meaning. -->
      <IDSymbol name="cmdidMenuShowWhy" value="0x020F" />
      <IDSymbol name="cmdidMenuSetBase" value="0x0210" />
      <IDSymbol name="cmdidMenuSetRemote" value="0x0211" />
      <IDSymbol name="cmdidMenuCleanReview" value="0x0212" />
      <IDSymbol name="cmdidMenuForgetReview" value="0x0213" />
      <IDSymbol name="cmdidMenuDiscardInventory" value="0x0214" />
      <IDSymbol name="cmdidMenuPreviewEdits" value="0x0215" />
      <IDSymbol name="cmdidMenuPreviewEditsStat" value="0x0216" />
      <IDSymbol name="cmdidMenuCompareReview" value="0x0217" />
      <IDSymbol name="cmdidMenuWalkthroughInit" value="0x0218" />
      <IDSymbol name="cmdidMenuWalkthroughBuild" value="0x0219" />
      <IDSymbol name="cmdidMenuInstallCli" value="0x021A" />
      <IDSymbol name="cmdidMenuShowCliLog" value="0x021B" />

      <IDSymbol name="ToolWindowToolbar" value="0x1000" />
      <IDSymbol name="ToolWindowToolbarGroup" value="0x1050" />
      <IDSymbol name="ToolsMenu" value="0x1100" />
      <IDSymbol name="ToolsMenuGroupReview" value="0x1150" />
      <IDSymbol name="ToolsMenuGroupRead" value="0x1151" />
      <IDSymbol name="ToolsMenuGroupTools" value="0x1152" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
