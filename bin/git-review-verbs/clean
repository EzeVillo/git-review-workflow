#!/usr/bin/env sh
#
# git review clean — delete leftover review/<branch> branches (and, by default,
# review-fixes/<branch> too).
#
# With no <branch> it cleans every matching leftover, never the branch you are
# currently on. Deleting an *incomplete* review/* (one that never finished
# successfully) rolls back that review's --delta marker the way git review abort
# does, so abandoned starts do not skip commits; a completed finish
# (reviewundoouthead set) keeps the marker — that tip was reviewed. Independent
# marker cleanup is git review forget --delta.
#
set -eu

prog="git review clean"

usage() {
	cat <<EOF
usage: $prog [--keep-fixes | --fixes-only] [branch]

Delete leftover review branches.
With no <branch>, clean every matching leftover.

  (default)        delete review/<branch> and review-fixes/<branch>
  --keep-fixes     delete review/<branch> only; leave review-fixes/<branch>
  --fixes-only     delete review-fixes/<branch> only; leave the review session

Never deletes the branch you are currently on.
Incomplete reviews roll back their --delta marker (like abort); finished ones keep it.
EOF
}

# restore_delta_if_incomplete <src>: no reviewundoouthead means the finish never
# completed, so roll the --delta marker back via reviewprevreviewed, like abort.
restore_delta_if_incomplete() {
	_rdi_src="$1"
	_rdi_rb="review/$_rdi_src"
	# Completed finish: tip was reviewed; keep the marker advanced at start.
	[ -z "$(git config "branch.$_rdi_rb.reviewundoouthead" || true)" ] || return 0
	# No tip metadata: not a real review session config; leave markers alone.
	[ -n "$(git config "branch.$_rdi_rb.reviewtip" || true)" ] || return 0
	_rdi_prev="$(git config "branch.$_rdi_rb.reviewprevreviewed" || true)"
	if [ "$(git config "branch.$_rdi_rb.reviewlocal" || true)" = "1" ]; then
		_rdi_mk="reviewworkflowlocal.$_rdi_src.reviewed"
	else
		_rdi_mk="reviewworkflow.$_rdi_src.reviewed"
	fi
	if [ -n "$_rdi_prev" ]; then
		git config "$_rdi_mk" "$_rdi_prev"
	else
		git config --unset "$_rdi_mk" 2>/dev/null || true
	fi
}

arg=""
keep_fixes=0
fixes_only=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--keep-fixes) keep_fixes=1 ;;
	--fixes-only) fixes_only=1 ;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		if [ -z "$arg" ]; then
			arg="$1"
		else
			echo "error: unexpected argument $1" >&2
			exit 1
		fi
		;;
	esac
	shift
done

if [ "$keep_fixes" -eq 1 ] && [ "$fixes_only" -eq 1 ]; then
	echo "error: --keep-fixes and --fixes-only are opposites; pass at most one" >&2
	exit 1
fi

cur="$(git symbolic-ref --quiet --short HEAD || true)"

if [ -n "$arg" ]; then
	if [ "$keep_fixes" -eq 1 ]; then
		list="review/$arg"
	elif [ "$fixes_only" -eq 1 ]; then
		list="review-fixes/$arg"
	else
		list="review/$arg review-fixes/$arg"
	fi
elif [ "$keep_fixes" -eq 1 ]; then
	list="$(git for-each-ref --format='%(refname:short)' refs/heads/review/)"
elif [ "$fixes_only" -eq 1 ]; then
	list="$(git for-each-ref --format='%(refname:short)' refs/heads/review-fixes/)"
else
	list="$(git for-each-ref --format='%(refname:short)' refs/heads/review/ refs/heads/review-fixes/)"
fi

# Keeps the closing message honest: deleting orphaned refs counts as work even
# when no review branches exist.
cleaned=0

# No branches is not a stopping point: banked edit refs can still be orphaned
# and need dropping, so fall through to that cleanup instead of bailing here.
if [ -n "$list" ]; then
	# Word splitting is intentional: branch names cannot contain whitespace.
	# shellcheck disable=SC2086
	for b in $list; do
		git rev-parse --verify --quiet "refs/heads/$b" >/dev/null || continue
		if [ "$b" = "$cur" ]; then
			echo "skipping $b (currently checked out)" >&2
			continue
		fi
		case "$b" in
		review/*)
			# Before the delete: the keys stay readable after branch -D, but read first.
			restore_delta_if_incomplete "${b#review/}"
			;;
		esac
		git branch -D "$b"
		cleaned=1
	done
fi

# --fixes-only stops here: everything below is session state (banked edit refs,
# finish undo points, reviewresume), and dropping the extracted edits of a finish
# you can still undo is not asking to lose the undo. Nothing outside
# review-fixes/* is read or written on this path, so no --delta marker moves.
if [ "$fixes_only" -eq 1 ]; then
	if [ "$cleaned" -eq 0 ]; then
		if [ -n "$arg" ]; then
			echo "no review-fixes/$arg branch to clean" >&2
		else
			echo "no review-fixes/ branches to clean" >&2
		fi
	fi
	exit 0
fi

# Drop orphaned banked edit refs, plus any finish undo points (refs/review-undo/*
# and their branch.review/<branch>.reviewundo* config) left behind by a finish
# that was never aborted. Only edit-refs whose review/<src> is already gone: a
# live step bank is session state, and purging it under an active review would
# silently destroy banked edits. Undo refs stay janitorial — always torn down,
# even with the review branch still checked out (see clean.bats).
if [ -n "$arg" ]; then
	undons="refs/review-undo/$arg/"
	undobranches="$arg"
else
	undons="refs/review-undo/"
	undobranches="$(git for-each-ref --format='%(refname)' refs/review-undo/ |
		sed -n 's#^refs/review-undo/\(.*\)/[^/]*$#\1#p' | sort -u)"
fi

# Edit-ref purge: named arg only when review/<arg> is gone; global walks every
# edit ref and skips any src that still has a live review/<src>.
# A here-doc while-read is used (not a pipe) so cleaned=1 survives the loop.
if [ -n "$arg" ]; then
	if ! git rev-parse --verify --quiet "refs/heads/review/$arg" >/dev/null; then
		_edit_refs="$(git for-each-ref --format='%(refname)' "refs/review-edits/$arg/")"
		if [ -n "$_edit_refs" ]; then
			while IFS= read -r ref; do
				[ -n "$ref" ] || continue
				git update-ref -d "$ref"
			done <<EOF
$_edit_refs
EOF
			cleaned=1
		fi
	fi
else
	_edit_refs="$(git for-each-ref --format='%(refname)' refs/review-edits/)"
	if [ -n "$_edit_refs" ]; then
		while IFS= read -r ref; do
			[ -n "$ref" ] || continue
			_rest="${ref#refs/review-edits/}"
			_esrc="${_rest%/*}"
			if git rev-parse --verify --quiet "refs/heads/review/$_esrc" >/dev/null; then
				continue
			fi
			git update-ref -d "$ref"
			cleaned=1
		done <<EOF
$_edit_refs
EOF
	fi
fi

# Walkthrough drafts are deliberately NOT touched, in either namespace: like the
# --delta markers and a review paused with save, they are hand-written prose that
# outlives the review, and discarding one is git review forget --draft. Pruning
# the drafts whose review/<src> was gone deleted the one written *before* the
# review existed — the first step of the documented flow (draft → fill it in →
# --build → start).

_undo_refs="$(git for-each-ref --format='%(refname)' "$undons")"
if [ -n "$_undo_refs" ]; then
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		git update-ref -d "$ref"
	done <<EOF
$_undo_refs
EOF
	cleaned=1
fi
# shellcheck disable=SC2086
for b in $undobranches; do
	# reviewresume must die with the undo: otherwise next/prev/save stay blocked
	# ("mid-conflict") while finish --abort has nothing to restore.
	for k in reviewundohead reviewundokind reviewundosrccreated \
		reviewundoeditstep reviewundoeditold reviewundoouthead reviewundoouttree \
		reviewresume; do
		git config --unset "branch.review/$b.$k" 2>/dev/null || true
	done
done

if [ "$cleaned" -eq 0 ]; then
	# review-saved/* is a namespace clean deliberately leaves alone. Point at it
	# when nothing else was found, so "no review branches" does not read as wrong
	# to someone staring at a review-saved/<branch> they expected this to clear.
	if [ -n "$arg" ]; then
		saved="$(git for-each-ref --format='%(refname:short)' "refs/heads/review-saved/$arg")"
	else
		saved="$(git for-each-ref --format='%(refname:short)' refs/heads/review-saved/)"
	fi
	if [ -n "$saved" ]; then
		echo "no review/ or review-fixes/ branches to clean; you have a saved review — resume it with git review continue or discard it with git review forget --saved" >&2
	elif [ "$keep_fixes" -eq 1 ]; then
		echo "no review/ branches to clean" >&2
	else
		echo "no review branches found" >&2
	fi
fi
