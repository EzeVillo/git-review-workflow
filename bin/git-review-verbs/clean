#!/usr/bin/env sh
#
# git review clean — delete leftover review/<branch> branches (and, by default,
# review-fixes/<branch> too).
#
# With no <branch> it cleans every matching leftover. It never deletes the
# branch you are currently on. When it deletes an *incomplete* review/* (one
# that never finished successfully), it rolls back that review's --delta marker
# the same way git review abort does, so abandoned starts do not skip commits.
# A finish that completed (reviewundoouthead set) keeps the marker — that tip
# was reviewed. For fully independent marker cleanup use git review forget --delta.
#
# --keep-fixes drops the review session / finish undo (review/* + undo refs)
# but leaves review-fixes/* alone — the usual "I'm done with this finish" step
# after committing or before opening a PR of your edits.
#
set -eu

prog="git review clean"

usage() {
	cat <<EOF
usage: $prog [--keep-fixes] [branch]

Delete leftover review branches.
With no <branch>, clean every matching leftover.

  (default)        delete review/<branch> and review-fixes/<branch>
  --keep-fixes     delete review/<branch> only; leave review-fixes/<branch>

Never deletes the branch you are currently on.
Incomplete reviews roll back their --delta marker (like abort); finished ones keep it.
EOF
}

# restore_delta_if_incomplete <src>
# If review/<src> never completed a finish (no reviewundoouthead), roll the
# --delta marker back using reviewprevreviewed — same as git review abort.
restore_delta_if_incomplete() {
	_rdi_src="$1"
	_rdi_rb="review/$_rdi_src"
	# Completed finish: tip was reviewed; keep the marker advanced at start.
	[ -z "$(git config "branch.$_rdi_rb.reviewundoouthead" || true)" ] || return 0
	# No tip metadata: not a real review session config; leave markers alone.
	[ -n "$(git config "branch.$_rdi_rb.reviewtip" || true)" ] || return 0
	_rdi_prev="$(git config "branch.$_rdi_rb.reviewprevreviewed" || true)"
	if [ "$(git config "branch.$_rdi_rb.reviewlocal" || true)" = "1" ]; then
		_rdi_mk="reviewworkflowlocal.$_rdi_src.reviewed"
	else
		_rdi_mk="reviewworkflow.$_rdi_src.reviewed"
	fi
	if [ -n "$_rdi_prev" ]; then
		git config "$_rdi_mk" "$_rdi_prev"
	else
		git config --unset "$_rdi_mk" 2>/dev/null || true
	fi
}

arg=""
keep_fixes=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--keep-fixes) keep_fixes=1 ;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		if [ -z "$arg" ]; then
			arg="$1"
		else
			echo "error: unexpected argument $1" >&2
			exit 1
		fi
		;;
	esac
	shift
done

cur="$(git symbolic-ref --quiet --short HEAD || true)"

if [ -n "$arg" ]; then
	if [ "$keep_fixes" -eq 1 ]; then
		list="review/$arg"
	else
		list="review/$arg review-fixes/$arg"
	fi
elif [ "$keep_fixes" -eq 1 ]; then
	list="$(git for-each-ref --format='%(refname:short)' refs/heads/review/)"
else
	list="$(git for-each-ref --format='%(refname:short)' refs/heads/review/ refs/heads/review-fixes/)"
fi

# Track whether any cleanup actually happened so the closing message is honest:
# deleting orphaned refs counts as work even when no review branches exist.
cleaned=0

# No branches is not a stopping point: banked edit refs can still be orphaned
# and need dropping, so fall through to that cleanup instead of bailing here.
if [ -n "$list" ]; then
	# Word splitting is intentional: branch names cannot contain whitespace.
	# shellcheck disable=SC2086
	for b in $list; do
		git rev-parse --verify --quiet "refs/heads/$b" >/dev/null || continue
		if [ "$b" = "$cur" ]; then
			echo "skipping $b (currently checked out)" >&2
			continue
		fi
		case "$b" in
		review/*)
			# Roll back --delta before deleting the branch (config keys stay readable
			# after branch -D, but read first for clarity / future key cleanup).
			restore_delta_if_incomplete "${b#review/}"
			;;
		esac
		git branch -D "$b"
		cleaned=1
	done
fi

# Drop orphaned banked commit-by-commit edit refs, plus any git review finish
# undo points (refs/review-undo/* and their branch.review/<branch>.reviewundo*
# config) left behind by a finish that was never aborted.
#
# Live step banks (refs/review-edits/<src>/* while review/<src> still exists)
# are session state, not leftover junk — purging them while a step review is
# active would silently destroy banked edits. Only purge edit-refs whose
# review/<src> branch is already gone. Undo refs stay janitorial: clean always
# tears down unresolved finish undo, even when the review branch is still
# checked out (see clean.bats).
if [ -n "$arg" ]; then
	undons="refs/review-undo/$arg/"
	undobranches="$arg"
else
	undons="refs/review-undo/"
	undobranches="$(git for-each-ref --format='%(refname)' refs/review-undo/ |
		sed -n 's#^refs/review-undo/\(.*\)/[^/]*$#\1#p' | sort -u)"
fi

# Edit-ref purge: named arg only when review/<arg> is gone; global walks every
# edit ref and skips any src that still has a live review/<src>.
# A here-doc while-read is used (not a pipe) so cleaned=1 survives the loop.
if [ -n "$arg" ]; then
	if ! git rev-parse --verify --quiet "refs/heads/review/$arg" >/dev/null; then
		_edit_refs="$(git for-each-ref --format='%(refname)' "refs/review-edits/$arg/")"
		if [ -n "$_edit_refs" ]; then
			while IFS= read -r ref; do
				[ -n "$ref" ] || continue
				git update-ref -d "$ref"
			done <<EOF
$_edit_refs
EOF
			cleaned=1
		fi
	fi
else
	_edit_refs="$(git for-each-ref --format='%(refname)' refs/review-edits/)"
	if [ -n "$_edit_refs" ]; then
		while IFS= read -r ref; do
			[ -n "$ref" ] || continue
			_rest="${ref#refs/review-edits/}"
			_esrc="${_rest%/*}"
			if git rev-parse --verify --quiet "refs/heads/review/$_esrc" >/dev/null; then
				continue
			fi
			git update-ref -d "$ref"
			cleaned=1
		done <<EOF
$_edit_refs
EOF
	fi
fi

# Walkthrough drafts, on exactly the terms the edit refs above get: a draft whose
# review/<src> is gone is leftover and goes; one whose review is still live stays.
# Only the active namespace is walked — review-saved-walkthrough/ is deliberately
# out of reach here, the same asymmetry refs/review-saved-edits/ already has, so
# resuming a paused review always finds the reading order it was paused with.
_draft_root="$(git rev-parse --git-dir)/review-walkthrough"
if [ -d "$_draft_root" ]; then
	# -type f, so a branch name with '/' (a directory here) is never mistaken for
	# a draft; the empty directories it leaves behind are pruned right after.
	_draft_files="$(find "$_draft_root" -type f -name '*.md' 2>/dev/null || true)"
	if [ -n "$_draft_files" ]; then
		while IFS= read -r _df; do
			[ -n "$_df" ] || continue
			_dsrc="${_df#"$_draft_root"/}"
			_dsrc="${_dsrc%.md}"
			if [ -n "$arg" ] && [ "$_dsrc" != "$arg" ]; then
				continue
			fi
			if git rev-parse --verify --quiet "refs/heads/review/$_dsrc" >/dev/null; then
				continue
			fi
			rm -f "$_df"
			cleaned=1
		done <<EOF
$_draft_files
EOF
	fi
	# Best-effort tidy of the directories a namespaced branch left behind. Never
	# fatal: -delete on a non-empty dir is expected and means a draft is still live.
	find "$_draft_root" -type d -empty -delete 2>/dev/null || true
fi

_undo_refs="$(git for-each-ref --format='%(refname)' "$undons")"
if [ -n "$_undo_refs" ]; then
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		git update-ref -d "$ref"
	done <<EOF
$_undo_refs
EOF
	cleaned=1
fi
# Word splitting is intentional: branch names cannot contain whitespace.
# shellcheck disable=SC2086
for b in $undobranches; do
	# reviewresume must die with the undo: otherwise next/prev/save stay blocked
	# ("mid-conflict") while finish --abort has nothing to restore.
	for k in reviewundohead reviewundokind reviewundosrccreated \
		reviewundoeditstep reviewundoeditold reviewundoouthead reviewundoouttree \
		reviewresume; do
		git config --unset "branch.review/$b.$k" 2>/dev/null || true
	done
done

if [ "$cleaned" -eq 0 ]; then
	# Saved reviews live in review-saved/*, a namespace git review clean deliberately
	# leaves alone (it owns review/* and, unless --keep-fixes, review-fixes/*).
	# Point at them when nothing else was found, so "no review branches" does not
	# read as wrong to someone staring at a review-saved/<branch> they expected
	# this to clear.
	if [ -n "$arg" ]; then
		saved="$(git for-each-ref --format='%(refname:short)' "refs/heads/review-saved/$arg")"
	else
		saved="$(git for-each-ref --format='%(refname:short)' refs/heads/review-saved/)"
	fi
	if [ -n "$saved" ]; then
		echo "no review/ or review-fixes/ branches to clean; you have a saved review — resume it with git review continue or discard it with git review forget --saved" >&2
	elif [ "$keep_fixes" -eq 1 ]; then
		echo "no review/ branches to clean" >&2
	else
		echo "no review branches found" >&2
	fi
fi
