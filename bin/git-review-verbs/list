#!/usr/bin/env sh
#
# git review list — list every review/* branch in progress.
#
# git review status reports only the review on the current branch; this shows all
# of them at once, so you can see what you have open across branches. The current
# branch is marked with a "*".
#
set -eu

prog="git review list"

usage() {
	cat <<EOF
usage: $prog [--porcelain]

List every review/* branch in progress, with its source PR, mode and — in
commit-by-commit mode — which commit you are on ([k/N]). The branch you are on
is marked with a "*". Reviews paused with git review save are listed too, under
"saved".

  --porcelain     machine-readable output (see the README for the format)
EOF
}

porcelain=0
case "${1:-}" in
-h | --h)
	usage
	exit 0
	;;
--porcelain)
	porcelain=1
	;;
"") ;;
*)
	echo "error: unexpected argument $1" >&2
	usage >&2
	exit 1
	;;
esac

git rev-parse --git-dir >/dev/null 2>&1 || {
	echo "error: not a git repository" >&2
	exit 1
}

# Shared helpers, sourced from the libexec directory the dispatcher points us at.
# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

# Resolve the gitdir once here rather than inside every draft-path lookup: those
# happen in command substitutions, one per walk row, and each would otherwise
# spawn its own git rev-parse (see walk_gitdir_init). No verb with a draft
# context needs this — walk_use_draft does it — but list has no review loaded.
walk_gitdir_init

cur="$(git symbolic-ref --quiet --short HEAD || true)"
branches="$(git for-each-ref --format='%(refname:short)' refs/heads/review/)"
saved="$(git for-each-ref --format='%(refname:short)' refs/heads/review-saved/)"

if [ -z "$branches" ] && [ -z "$saved" ]; then
	if [ "$porcelain" -eq 0 ]; then
		echo "no reviews in progress"
	fi
	exit 0
fi

# describe <branch> <marker>: print one line for a review branch, reading its
# mode and position from the branch config. Used for both active and saved reviews.
describe() {
	b="$1"
	label="$2"
	src="$(git config "branch.$b.reviewsource" || true)"
	# A branch with no reviewsource is an orphan: either hand-made, or left by a
	# git review save / git review start that died after creating the branch but before
	# writing its metadata. Surface it instead of skipping silently — otherwise an
	# orphan-only state prints nothing at all — and name the cleanup command so the
	# line is actionable (abort cannot run without reviewsource).
	if [ -z "$src" ]; then
		case "$b" in
		review-saved/*)
			printf '%s %s  %s(no metadata — discard with: git review forget --saved %s)\n' \
				"$label" "$b" "$prefix" "${b#review-saved/}"
			;;
		*)
			printf '%s %s  %s(no metadata — switch away, then: git branch -D %s)\n' \
				"$label" "$b" "$prefix" "$b"
			;;
		esac
		return
	fi
	tip="$(git config "branch.$b.reviewtip" || true)"
	mode="$(git config "branch.$b.reviewmode" || echo whole)"

	shorttip="$tip"
	[ -n "$tip" ] && shorttip="$(git rev-parse --short "$tip" 2>/dev/null || echo "$tip")"

	# Whose reading order it is: the inventory is where a reviewer looks days later
	# to decide what to resume, which is exactly when "was this order mine or the
	# author's?" stops being obvious. A paused review's draft lives in the saved
	# namespace, so look where this row's review is.
	#
	# walk_review_draft_src is what names the file: the review's source is not it
	# for a compare of a remote-tracking branch, and this row is the surface that
	# hands that file to forget --saved.
	#
	# Outside the mode branch, because save moves the draft outside it too: a whole
	# or step review of a branch you had drafted for carries that draft into the
	# saved namespace when you pause it, and forget --saved discards it along with
	# the review. Marking only walk rows meant the one surface that could have shown
	# the reviewer their prose was in there did not, and it left with the review
	# without ever having been listed.
	dsrc="$(walk_review_draft_src "$b")"
	draft_note=""
	if [ -n "$dsrc" ]; then
		case "$b" in
		review-saved/*)
			dpath="$(walk_saved_draft_path "$dsrc")"
			# And only if this row's review is the one that filed it: two paused
			# reviews of a branch share the name, so the badge used to promise a
			# reading order to a review that will not come back with one.
			walk_saved_draft_filed "$b" || dpath=""
			;;
		*) dpath="$(walk_draft_path "$dsrc")" ;;
		esac
		if [ -f "$dpath" ]; then
			draft_note=" (draft)"
		fi
	fi

	if [ "$mode" = "step" ]; then
		count="$(git config "branch.$b.reviewcount" || echo '?')"
		step="$(git config "branch.$b.reviewstep" || echo '?')"
		printf '%s %s  %sstep%s [%s/%s]  tip %s\n' "$label" "$b" "$prefix" "$draft_note" "$step" "$count" "$shorttip"
	elif [ "$mode" = "walk" ]; then
		count="$(git config "branch.$b.reviewwalkcount" || echo '?')"
		step="$(git config "branch.$b.reviewwalkstep" || echo '?')"
		printf '%s %s  %swalk%s [%s/%s]  tip %s\n' "$label" "$b" "$prefix" "$draft_note" "$step" "$count" "$shorttip"
	else
		printf '%s %s  %swhole%s  tip %s\n' "$label" "$b" "$prefix" "$draft_note" "$shorttip"
	fi
}

# describe_porcelain <branch> <is_saved>: print one porcelain "branch" record,
# reading its mode and position from the branch config — same data describe()
# shows a human, never re-derived (research.md, Decision 7). Position/total are
# omitted, not "?", when either config key is missing (contracts/list-porcelain.md).
describe_porcelain() {
	pb="$1"
	pcurrent=0
	[ "$pb" = "$cur" ] && pcurrent=1
	psrc="$(git config "branch.$pb.reviewsource" || true)"
	if [ -z "$psrc" ]; then
		porcelain_row branch "$pb" "$2" "$pcurrent" 1
	else
		pmode="$(git config "branch.$pb.reviewmode" || echo whole)"
		case "$pmode" in
		step)
			pposition="$(git config "branch.$pb.reviewstep" || true)"
			ptotal="$(git config "branch.$pb.reviewcount" || true)"
			;;
		walk)
			pposition="$(git config "branch.$pb.reviewwalkstep" || true)"
			ptotal="$(git config "branch.$pb.reviewwalkcount" || true)"
			;;
		*)
			pposition=""
			ptotal=""
			;;
		esac
		if [ -n "$pposition" ] && [ -n "$ptotal" ]; then
			porcelain_row branch "$pb" "$2" "$pcurrent" 0 "$pmode" "$pposition" "$ptotal"
		else
			porcelain_row branch "$pb" "$2" "$pcurrent" 0 "$pmode"
		fi
	fi

	# finish (contracts/finish-state.md): a finish's undo point lives on the
	# config of the review/* branch it left behind, never on review-saved/*
	# (finish never touches a saved review) — checked right after that branch's
	# own record, regardless of whether it came out orphan above.
	if [ "$2" -eq 0 ]; then
		pundohead="$(git config "branch.$pb.reviewundohead" || true)"
		if [ -n "$pundohead" ]; then
			presume="$(git config "branch.$pb.reviewresume" || true)"
			pstate=pending
			[ "$presume" = "conflict" ] && pstate=conflict
			pkind="$(git config "branch.$pb.reviewundokind" || true)"
			ponto=0
			[ "$pkind" = "onto-source" ] && ponto=1
			porcelain_row finish "$pb" "$pstate" "$ponto"
		fi
	fi
}

if [ "$porcelain" -eq 1 ]; then
	printf '%s\n' "$branches" | while read -r b; do
		[ -n "$b" ] || continue
		describe_porcelain "$b" 0
	done
	if [ -n "$saved" ]; then
		printf '%s\n' "$saved" | while read -r b; do
			[ -n "$b" ] || continue
			describe_porcelain "$b" 1
		done
	fi
	exit 0
fi

prefix=""
printf '%s\n' "$branches" | while read -r b; do
	[ -n "$b" ] || continue
	marker=" "
	[ "$b" = "$cur" ] && marker="*"
	describe "$b" "$marker"
done

# Reviews put aside with git review save, tagged so they are not mistaken for
# active ones. The branch you are on is still marked with "*".
if [ -n "$saved" ]; then
	prefix="saved  "
	printf '%s\n' "$saved" | while read -r b; do
		[ -n "$b" ] || continue
		marker=" "
		[ "$b" = "$cur" ] && marker="*"
		describe "$b" "$marker"
	done
fi
