#!/usr/bin/env sh
#
# git review save — pause the review on the current branch and put it aside.
#
# A review in progress lives on a review/<branch> branch. Saving it converts that
# branch into review-saved/<branch> and returns you to where you started, so you
# can pick up something else and resume later with git review continue.
#
# The saved review carries everything needed to resume exactly where you left off:
#   whole mode  the staged PR diff and your uncommitted edits, captured as a
#               commit whose diff against the tip is just your edits.
#   step mode   the step you are on, the edits on it, and every edit you have
#               banked on other commits — the banked-edit refs are moved out of
#               refs/review-edits/ (which git review clean prunes) into
#               refs/review-saved-edits/ so a git review clean never touches them.
#
set -eu

prog="git review save"

usage() {
	cat <<EOF
usage: $prog

Pause the review on the current review/* branch: stash it as review-saved/<branch>
and return to the branch you started from. Resume it later with git review continue.
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

case "${1:-}" in
-h | --h)
	usage
	exit 0
	;;
"") ;;
*)
	echo "error: unexpected argument $1" >&2
	usage >&2
	exit 1
	;;
esac

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

cur="$(git symbolic-ref --quiet --short HEAD || true)"
case "$cur" in
review/*) ;;
*)
	echo "error: not on a review/* branch (HEAD is ${cur:-detached})" >&2
	exit 2
	;;
esac

# A mid-finish conflict keeps undo/resume on this branch; saving would rename it
# away and leave refs/review-undo orphaned with conflict markers banked as edits.
require_not_finish_conflict

# A completed finish leaves reviewundohead while you sit on review-fixes (or the
# PR branch). Saving from a hand-switched review/* with that undo live would
# rename the branch that owns the undo and orphan review-fixes / the undo point.
require_not_pending_finish

src="$(git config "branch.$cur.reviewsource" || true)"
tip="$(git config "branch.$cur.reviewtip" || true)"
if [ -z "$src" ] || [ -z "$tip" ]; then
	if [ -z "$src" ]; then
		die "missing review metadata; was $cur created with git review start? Switch away, then delete it with 'git branch -D $cur'."
	fi
	die "missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'."
fi

saved="review-saved/$src"
git rev-parse --verify --quiet "refs/heads/$saved" >/dev/null &&
	die "$saved already exists; resume it with git review continue or discard it with git review forget --saved $src"

mode="$(git config "branch.$cur.reviewmode" || echo whole)"

# Where to return to once the review is put aside — the branch you started from,
# falling back to the base branch, exactly like git review abort.
ret="$(git config "branch.$cur.reviewreturn" || true)"
base="$(git config "branch.$cur.reviewbase" || true)"
target=""
if [ -n "$ret" ] && git rev-parse --verify --quiet "refs/heads/$ret" >/dev/null; then
	target="$ret"
elif [ -n "$base" ] && git rev-parse --verify --quiet "refs/heads/$base" >/dev/null; then
	target="$base"
fi
[ -n "$target" ] || die "could not determine a branch to return to; switch away manually first"

# The archived namespace already holding a draft under the name this review would
# file its own under. The move at the end of this script is an mv: without this it
# replaced whatever was there and said nothing, which is the one place in the suite
# where hand-written prose was destroyed silently.
#
# Two reviews can want the same file name — a draft belongs to a branch, and both
# git review start feature/x and git review compare develop origin/feature/x draft
# for feature/x — so it is not enough that review-saved/<src> is free. Asked of the
# paused reviews rather than of the file's name, for the same reason
# forget --draft --all has to: the archived draft of review-saved/origin/feature/x
# is filed under feature/x.
#
# Refuse when a paused review still claims it (its prose is the only copy and this
# would be the command that ate it); replace it, out loud, when nothing does — an
# entry no review can reclaim is already what forget --draft --all sweeps. Checked
# here, before anything is written, while the move itself stays last: a guard that
# can still die has no business running after the review has been put aside.
walk_gitdir_init
_save_draftsrc="$(walk_review_draft_src "$cur")"
_save_replaces=0
if [ -n "$_save_draftsrc" ] && [ -f "$(walk_saved_draft_path "$_save_draftsrc")" ]; then
	_save_claimant=""
	while IFS="$(printf '\t')" read -r _sc_name _sc_rb; do
		if [ "$_sc_name" = "$_save_draftsrc" ]; then
			_save_claimant="$_sc_rb"
			break
		fi
	done <<EOF
$(walk_saved_draft_claims)
EOF
	if [ -n "$_save_claimant" ]; then
		die "$_save_claimant is paused on a walkthrough draft for $_save_draftsrc, and this review would file its own under the same name; resume that review with 'git review continue' and finish or discard it, or discard it with 'git review forget --saved ${_save_claimant#review-saved/}', then save this one."
	fi
	_save_replaces=1
fi

# copy_meta <key>: copy branch.<cur>.<key> to branch.<saved>.<key> when set.
# The explicit if (rather than a && one-liner) keeps the function's exit status 0
# when the key is absent, so it does not trip set -e for the optional keys.
copy_meta() {
	v="$(git config "branch.$cur.$1" || true)"
	if [ -n "$v" ]; then
		git config "branch.$saved.$1" "$v"
	fi
}

if [ "$mode" = "step" ]; then
	start="$(git config "branch.$cur.reviewstart" || true)"
	count="$(git config "branch.$cur.reviewcount" || true)"
	step="$(git config "branch.$cur.reviewstep" || true)"
	# A key deleted by a hand-edit (while reviewmode stays "step") would otherwise
	# let set -e kill the bare read silently mid-script; read with || true and report
	# it. Unlike status/preview there is no later numeric guard, so cover step too.
	if [ -z "$start" ] || [ -z "$count" ] || [ -z "$step" ]; then
		die "missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'."
	fi
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"

	# Bank the edits on the commit we are sitting on, the same way review-next does
	# before it moves, so the current step's work joins the other banked steps.
	cstep="$(printf '%s\n' "$commits" | sed -n "${step}p")"
	git add -A
	tree="$(git write-tree)"
	if [ "$tree" != "$(git rev-parse "$cstep^{tree}")" ]; then
		edit="$(git commit-tree "$tree" -p "$cstep" -m "review edits step $step")"
		git update-ref "refs/review-edits/$src/$step" "$edit"
	else
		# Reverting the step back to a clean tree must clear any edits we banked
		# earlier, or they resurrect when the saved review is restored.
		git update-ref -d "refs/review-edits/$src/$step" 2>/dev/null || true
	fi

	# Move the banked edits aside so git review clean (which prunes refs/review-edits/)
	# leaves the saved review intact, and so they travel with it.
	git for-each-ref --format='%(refname)' "refs/review-edits/$src/" | while read -r ref; do
		n="${ref##*/}"
		git update-ref "refs/review-saved-edits/$src/$n" "$(git rev-parse "$ref")"
		git update-ref -d "$ref"
	done

	# The visible branch is just an anchor + metadata holder; point it at the tip.
	git update-ref "refs/heads/$saved" "$tip"
	git config "branch.$saved.reviewmode" step
	copy_meta reviewstart
	copy_meta reviewcount
	copy_meta reviewstep
	note="on step $step/$count"
else
	# whole and walk mode share their captured state: HEAD is the review's lower
	# bound, the index holds the staged PR diff and the working tree holds that plus
	# your edits. Capture the working tree as a commit parented on the tip, so its
	# diff against the tip is exactly your edits — review-continue replays that to
	# restore the editable state. Walk adds only its reading cursor keys on top.
	lower="$(git rev-parse HEAD)"
	git add -A
	tree="$(git write-tree)"
	# Parent the saved commit on both the tip and the lower bound. The tip parent
	# makes "git diff tip..saved" exactly your edits; the lower parent keeps the
	# lower bound reachable even when it is a synthetic merge-tree commit (the
	# folded-base case in git review start), so a gc between save and continue cannot
	# prune it out from under "git reset --soft $lower".
	commit="$(git commit-tree "$tree" -p "$tip" -p "$lower" -m "git review save: $src")"
	git update-ref "refs/heads/$saved" "$commit"
	git config "branch.$saved.reviewsavedlower" "$lower"
	if [ "$mode" = "walk" ]; then
		git config "branch.$saved.reviewmode" walk
		copy_meta reviewwalkstep
		copy_meta reviewwalkcount
		copy_meta reviewwalkkeys
		copy_meta reviewwalkfromdraft
		copy_meta reviewwalkbase
		wstep="$(git config "branch.$cur.reviewwalkstep" || echo '?')"
		wcount="$(git config "branch.$cur.reviewwalkcount" || echo '?')"
		note="walkthrough review on entry $wstep/$wcount"
	else
		git config "branch.$saved.reviewmode" whole
		note="whole-PR review"
	fi
fi

# Metadata common to both modes.
copy_meta reviewsource
copy_meta reviewbase
copy_meta reviewtip
copy_meta reviewprevreviewed
copy_meta reviewlocal
# Where this review's draft lives. Outside the mode branch, like the move below:
# a draft sits next to any mode, and a saved review that lost this name would have
# its archived draft looked up under the source instead — the wrong file, or none.
copy_meta reviewdraft
# compare reviews: finish must keep refusing after save → continue.
copy_meta reviewreadonly
git config "branch.$saved.reviewreturn" "$target"

# Put the reviewer's own walkthrough draft where a paused review's reading order
# belongs, the same way the banked edits moved to refs/review-saved-edits/ above.
# Moved, not copied, so an active and a saved draft for one branch can never
# diverge. Outside the mode branch on purpose: a draft can sit next to any mode.
#
# Named by walk_review_draft_src, because the draft's branch is not always the
# review's — a compare of origin/feature/x drafts for feature/x — and moving the
# wrong name would leave the real file behind, in the namespace clean is
# hands-off in, owned by a review that no longer exists.
#
# Last, deliberately: everything above can still die (a missing return branch, a
# key deleted by hand), and a save that aborted after moving the draft would
# leave the review live but stripped of the order it was reading, with the file
# parked in a namespace no saved review claims — forget --saved would not find it
# and clean must not take it. By here review-saved/<src> exists and holds every
# key, so the draft has an owner whatever happens next.
#
# The gitdir is resolved here, in this shell: the two lookups below happen inside
# "$(...)", where a cache written by walk_draft_path dies with the subshell and
# each would spawn its own git rev-parse (see walk_gitdir_init).
walk_gitdir_init
draftsrc="$(walk_review_draft_src "$cur")"
_save_draft="$(walk_draft_path "$draftsrc")"
if [ -f "$_save_draft" ]; then
	_saved_draft="$(walk_saved_draft_path "$draftsrc")"
	mkdir -p "$(dirname "$_saved_draft")"
	# Said, not discovered: the guard above established that nothing can reclaim
	# what is there, but it is still prose someone typed, and this is the only mv in
	# the suite that lands on top of some.
	if [ "$_save_replaces" -eq 1 ]; then
		echo "note: replaced an archived walkthrough draft for $draftsrc that no paused review could restore" >&2
	fi
	mv "$_save_draft" "$_saved_draft"
fi

# Leave the review branch: drop its working-tree changes (captured above), return
# to the starting branch and delete review/<src>. Its config goes with it; the
# saved copy already holds everything.
git switch -q --discard-changes "$target"
git branch -D "$cur" >/dev/null

echo "saved review of $src ($note) as $saved; returned to $target"
echo "resume it with git review continue"
