{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezevillo-git-review-workflow",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "docs",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
