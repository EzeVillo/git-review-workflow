#!/usr/bin/env sh
#
# git review walkthrough — author a guided reading order for the current PR.
#
# A walkthrough is the one thing neither git nor GitHub offers: an author-written
# reading order over a PR, each file annotated with why it matters. It lives as a
# committed sidecar, .review/walkthrough.md, so it merges with the PR and is
# readable on GitHub. A reviewer who runs "git review start" on a PR that carries
# one is dropped into walk mode: the same staged, editable review, plus a cursor
# that walks the files in this order (git review next / prev).
#
# Three subcommands, in the git stash push/pop spirit:
#   init   write a deterministic skeleton listing every changed file, for you (the
#          author, typically an AI agent) to fill in with an order number and a why.
#   build  validate what you filled in, order the entries by your numbers, renumber
#          them 1..N and rewrite the file. --check validates without writing, for CI.
#   draft  the same thing from the other side of the review: a walkthrough you
#          write for someone else's PR, kept out of the working tree entirely.
#
# init and build are the author's: they operate on the committed sidecar of the
# branch you are standing on. draft is the reviewer's, and that is the whole
# difference — it names the branch (you are standing on the base, not on the PR)
# and it writes into the gitdir, so nothing is ever staged, committed or undone.
#
set -eu

prog="git review walkthrough"

usage() {
	cat <<EOF
usage: $prog init [--base <base>] [--force] [--stdout]
       $prog build [--check] [--from <file> | --from -]
       $prog draft [--local | --offline] [--delta] [--force] [--stdout] [--] [<branch>]
       $prog draft --build [--from <file> | --from -] [--local | --offline]
                   [--delta] [--force] [--] [<branch>]
       $prog guide [--team] [--delete]

Author a reading walkthrough for the current branch's PR, committed as
.review/walkthrough.md.

  init             write a skeleton listing every file changed vs the base, or
                   update the one that is there: entries whose file is still in
                   range keep their number and their why, files that entered
                   the range arrive as placeholders, and entries whose file
                   left it are dropped and named
    --base <base>  diff against <base> instead of reviewworkflow.base
    --force        discard what is there and write a blank skeleton
    --stdout       print it instead of writing; nothing is created anywhere
  build            validate, order by the numbers you set and renumber 1..N
    --check        validate only; write nothing, exit non-zero on any problem
    --from <file>  read the walkthrough from <file> instead of the one in the
                   work tree, and install it ("-" reads standard input)

Review someone else's PR in a reading order of your own, without committing:

  draft [<branch>]  write the same skeleton for <branch> (default: the branch
                    you are on, or the one a review you are inside is reading)
                    outside the working tree, or update the one that is there
                    on the same terms as init; git review start then
                    reads it instead of the PR's own walkthrough
    --build         validate and renumber the draft, as build does for the PR's
    --from <file>   with --build: read the draft from <file> instead of the
                    stored one, and install it ("-" reads standard input)
    --local         draft against your local <branch>, not origin's copy
    --offline       like --local, and resolve the base locally too
    --delta         cover only the commits added since your last review
    --force         discard what is there and write a blank skeleton
    --stdout        print the skeleton instead of writing it; nothing is
                    created anywhere

Keep the conventions the reading order is written to, as prose:

  guide             create your own guide, outside the work tree, and say
                    where it went; both guides apply when both have content,
                    and yours wins where they disagree
    --team          create the repository's shared guide instead
                    (.review/walkthrough-guide.md, committed with the code)
    --delete        remove your own guide; --team is never deleted here,
                    it is a tracked file and that is git rm plus a commit
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

sub=""
branch=""
base=""
base_explicit=0
force=0
check=0
build_draft=0
local_only=0
offline=0
delta_mode=0
to_stdout=0
from_src=""
from_given=0
team_guide=0
delete_guide=0
# Positional arguments in order: the subcommand, then (draft only) the branch.
# Kept in one helper so "--" and the bare form agree on the shape.
take_positional() {
	if [ -z "$sub" ]; then
		sub="$1"
	elif [ -z "$branch" ]; then
		branch="$1"
	else
		die "unexpected argument $1"
	fi
}
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--base)
		shift
		if [ $# -eq 0 ] || [ -z "$1" ]; then die "--base requires a base"; fi
		base="$1"
		base_explicit=1
		;;
	--base=*)
		base="${1#--base=}"
		[ -n "$base" ] || die "--base requires a base"
		base_explicit=1
		;;
	--force) force=1 ;;
	--check) check=1 ;;
	--build) build_draft=1 ;;
	--local) local_only=1 ;;
	--offline) offline=1 ;;
	--delta) delta_mode=1 ;;
	--stdout) to_stdout=1 ;;
	--team) team_guide=1 ;;
	--delete) delete_guide=1 ;;
	--from)
		# Repetition is an error rather than last-one-wins: two sources for one
		# draft is a mistake in the caller, and silently picking one of them is
		# how the wrong prose gets installed.
		if [ "$from_given" -eq 1 ]; then die "--from given more than once"; fi
		shift
		if [ $# -eq 0 ] || [ -z "$1" ]; then
			die "--from requires a file (or - for standard input)"
		fi
		from_src="$1"
		from_given=1
		;;
	--from=*)
		if [ "$from_given" -eq 1 ]; then die "--from given more than once"; fi
		from_src="${1#--from=}"
		if [ -z "$from_src" ]; then
			die "--from requires a file (or - for standard input)"
		fi
		from_given=1
		;;
	--)
		shift
		while [ $# -gt 0 ]; do
			take_positional "$1"
			shift
		done
		break
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		take_positional "$1"
		;;
	esac
	shift
done

[ -n "$sub" ] || {
	usage >&2
	exit 1
}
case "$sub" in
init | build | draft | guide) ;;
*) die "unknown subcommand '$sub'; use init, build, draft or guide" ;;
esac

# Flag/subcommand compatibility, checked up front so a misused flag never silently
# no-ops.
if [ "$sub" = build ] && { [ "$base_explicit" -eq 1 ] || [ "$force" -eq 1 ]; }; then
	die "--base and --force apply only to git review walkthrough init"
fi
if [ "$sub" = init ] && [ "$check" -eq 1 ]; then
	die "--check applies only to git review walkthrough build"
fi
if [ "$sub" != draft ] && { [ "$build_draft" -eq 1 ] || [ "$local_only" -eq 1 ] || [ "$offline" -eq 1 ] || [ "$delta_mode" -eq 1 ]; }; then
	die "--build, --local, --offline and --delta apply only to git review walkthrough draft"
fi
# The agent circuit, both ends, on both sides of the review. It landed on draft
# first and stayed there, which had the author — the one the skeleton's own
# instructions call "usually an agent" — as the only side that could not hand the
# work out and take it back. Each end belongs to the verb that produces or
# consumes a skeleton: --stdout to init and draft, --from to the two builds.
if [ "$sub" = build ] && [ "$to_stdout" -eq 1 ]; then
	die "--stdout writes the skeleton; build validates one. Use git review walkthrough init --stdout"
fi
if [ "$sub" = guide ] && { [ "$to_stdout" -eq 1 ] || [ "$from_given" -eq 1 ]; }; then
	die "--stdout and --from apply only to init, build and draft; a guide has no skeleton"
fi
if [ "$sub" = init ] && [ "$from_given" -eq 1 ]; then
	die "--from installs a filled-in walkthrough; init writes the skeleton. Use git review walkthrough build --from"
fi
if [ "$sub" = init ] && [ "$to_stdout" -eq 1 ] && [ "$force" -eq 1 ]; then
	die "--stdout writes no file, so there is nothing to force"
fi
if [ "$sub" != draft ] && [ -n "$branch" ]; then
	die "only git review walkthrough draft takes a branch; init, build and guide work on the repository you are in"
fi
# The two guide flags, and everything the guide subcommand does not take. A guide
# has no range, no base and no origin, so every flag that selects one of those is
# a mistake there — and one that no-ops silently would look like it worked.
if [ "$sub" != guide ] && { [ "$team_guide" -eq 1 ] || [ "$delete_guide" -eq 1 ]; }; then
	die "--team and --delete apply only to git review walkthrough guide"
fi
if [ "$sub" = guide ]; then
	if [ "$team_guide" -eq 1 ] && [ "$delete_guide" -eq 1 ]; then
		# Not an oversight and not a missing feature: the shared guide is a tracked
		# file, so removing it is git rm plus a commit — a decision about what goes
		# into the PR, which is not this command's to make. Said in full here
		# because the obvious next thought is that --delete simply forgot --team.
		die "--delete removes your own guide; the repository's guide is a tracked file, so remove it with git rm .review/walkthrough-guide.md and commit that"
	fi
	if [ "$force" -eq 1 ]; then
		# --force means "destroy what is there" everywhere else in this suite. A
		# guide is prose somebody typed and this command would replace it with an
		# empty file, so the flag is refused rather than honoured.
		die "--force does not apply to git review walkthrough guide; open the file and edit it, or remove it with --delete"
	fi
	if [ "$check" -eq 1 ]; then
		die "--check applies only to git review walkthrough build; a guide has no format to validate"
	fi
	if [ "$base_explicit" -eq 1 ]; then
		die "--base applies only to git review walkthrough init; a guide covers no range"
	fi
fi
if [ "$sub" = draft ]; then
	if [ "$check" -eq 1 ]; then
		die "--check applies only to git review walkthrough build; draft --build validates the draft"
	fi
	# The two new flags sit on opposite ends of the same circuit — one hands the
	# skeleton out, the other takes the filled-in copy back — so every way of
	# asking for both at once is a mistake, and each gets its own sentence rather
	# than one generic "incompatible flags".
	if [ "$to_stdout" -eq 1 ] && [ "$build_draft" -eq 1 ]; then
		die "--stdout writes the skeleton; --build validates one. Use one or the other"
	fi
	if [ "$to_stdout" -eq 1 ] && [ "$force" -eq 1 ]; then
		die "--stdout writes no file, so there is nothing to force"
	fi
	# Covers --stdout --from too: --stdout is never --build, so this is the
	# sentence that combination gets, which is the one that names the fix.
	if [ "$from_given" -eq 1 ] && [ "$build_draft" -eq 0 ]; then
		die "--from applies only to git review walkthrough draft --build"
	fi
	if [ "$base_explicit" -eq 1 ]; then
		die "--base applies only to git review walkthrough init; draft uses reviewworkflow.base, like git review start"
	fi
	if [ "$local_only" -eq 1 ] && [ "$offline" -eq 1 ]; then
		die "use only one of --local and --offline"
	fi
	# Asymmetric risk, as everywhere else in this suite: --force destroys work
	# the reviewer typed, so it only means anything where something gets written.
	# With --from there IS something to destroy — the stored draft is replaced by
	# prose from somewhere else — so there it is not only legal but required.
	if [ "$build_draft" -eq 1 ] && [ "$force" -eq 1 ] && [ "$from_given" -eq 0 ]; then
		die "--force applies only when creating a draft, not to --build"
	fi
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# Shared helpers, sourced from the libexec directory the dispatcher points us at.
# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

# Uncommitted changes to non-sidecar paths. init and build derive their file set
# from committed history (base..HEAD), so working-tree edits the author has not
# committed are invisible here; annotating them would be annotating incomplete
# work. The walkthrough itself is expected to be dirty while you author it, so
# anything under .review/ is ignored (mirrors annotatable_files excluding it).
# Purely a diagnostic — the sole use is to enrich a refusal or emit a note.
has_uncommitted() {
	# True when porcelain has any line for a path outside .review/ (grep -qv exits 0
	# as soon as one non-.review line exists; 1 on a clean or sidecar-only tree).
	git status --porcelain 2>/dev/null | grep -qv '\.review/'
}

# Emit a non-fatal heads-up when the working tree carries uncommitted reviewable
# changes, so an author (often an AI agent) does not silently build a walkthrough
# over work that never made it into base..HEAD.
warn_dirty() {
	# Never for a draft. That diagnostic exists because an author can annotate work
	# they have not committed yet; a reviewer drafts against someone else's
	# committed refs, so their own dirty tree — the review edits they are making —
	# has nothing to do with it, and warning about it would be noise at best.
	# Guarded here, once, rather than at each of the five call sites.
	[ "$sub" != draft ] || return 0
	has_uncommitted || return 0
	echo "note: you have uncommitted changes; init and build cover committed history (base..HEAD), so uncommitted edits are invisible here. Commit the PR first; never push automatically." >&2
}

# emit_guide_note
# The authoring guides, reported on stderr the same way whether one, both or
# neither is in force. Never interpreted here -- only pointed at -- so build
# keeps owning the format, and resolved from the repository you are standing in,
# draft included: the conventions of whoever is annotating, not a guide from the
# PR tip.
#
# Called by init, draft AND build. build is not decoration there: it is the verb
# that enforces the rule a guide most often carries -- "mark few entries key" --
# because its own note is what fires when every entry is marked. Two surfaces
# that never named the same file is how a guide gets written and then quietly
# ignored at the one step that could have held the walkthrough to it.
#
# A file that exists but holds nothing is its own case rather than folded into
# "none": telling somebody to create a guide they already created, and are
# looking at, is the kind of note that teaches people to stop reading notes.
#
# Several short lines rather than one long one: with both guides in force the
# single line ran past 300 characters, which in a narrow terminal is a wall.
emit_guide_note() {
	guide_paths_init
	_egn_team=0
	_egn_own=0
	if guide_in_force "$_guide_team_path"; then _egn_team=1; fi
	if guide_in_force "$_guide_own_path"; then _egn_own=1; fi
	{
		if [ "$_egn_team" -eq 1 ] && [ "$_egn_own" -eq 1 ]; then
			echo 'note: two authoring guides are in force (yours wins where they disagree):'
			echo '        .review/walkthrough-guide.md  (this repository)'
			echo "        $_guide_own_path  (yours)"
			echo '      They cover keys, whys and the heads-up -- never the format.'
		elif [ "$_egn_team" -eq 1 ]; then
			echo 'note: authoring guide in force at .review/walkthrough-guide.md'
			echo '      It covers keys, whys and the heads-up -- never the format.'
		elif [ "$_egn_own" -eq 1 ]; then
			echo "note: your authoring guide is in force at $_guide_own_path"
			echo '      It covers keys, whys and the heads-up -- never the format.'
		elif [ -f "$_guide_own_path" ] || [ -f "$_guide_team_path" ]; then
			echo 'note: an authoring guide exists but is empty, so nothing was applied.'
			echo '      Write the conventions for keys, whys and the heads-up into it.'
		else
			echo 'note: no authoring guide. Create one with:'
			echo '        git review walkthrough guide         (yours, outside the work tree)'
			echo '        git review walkthrough guide --team  (this repository, committed)'
		fi
	} >&2
}

# Whether HEAD is a review branch, asked once, of git, before anything below
# derives a branch name. It is what decides which of the three situation phrases
# the instruction block carries, and it is deliberately NOT from_review: that one
# is 1 only when the reviewer omitted the branch (see below), so
# "git review walkthrough draft feature/x" run from inside review/feature/x would
# get the base-branch phrase while standing in a review -- the disagreement the
# spec forbids. from_review stays exactly as it is, for deriving the name.
head_in_review=0
case "$(git symbolic-ref --quiet --short HEAD || true)" in
review/*) head_in_review=1 ;;
esac

# ── guide ─────────────────────────────────────────────────────────────────────
#
# Create or remove an authoring guide. Nothing here reads, writes or validates
# the CONTENT of one: this subcommand exists so the file has a way to be made
# that the three clients can invoke, instead of each of them rebuilding the path
# and writing to it themselves — the same reason openDraft opens the path the CLI
# reported rather than deriving it.
#
# The file is created EMPTY, deliberately. A skeleton with placeholders would be
# actively harmful: build is what rejects an unfilled walkthrough, and there is no
# build here, so instructions left behind in the file are read by the next agent
# as if they were the conventions themselves. What the file is for is printed
# instead, where it cannot be mistaken for its content.
if [ "$sub" = guide ]; then
	guide_paths_init
	[ -n "$_guide_team_path" ] ||
		die "no work tree here; a guide lives beside the repository you are reviewing in"

	if [ "$delete_guide" -eq 1 ]; then
		[ -f "$_guide_own_path" ] ||
			die "you have no guide to remove ($_guide_own_path)"
		rm -f "$_guide_own_path" ||
			die "could not remove $_guide_own_path"
		echo "removed your guide ($_guide_own_path)"
		exit 0
	fi

	if [ "$team_guide" -eq 1 ]; then
		# Refused inside a review for the reason the reviewer's guide exists at all:
		# the shared one is a file of the work tree, finish extracts with
		# "git add -A", and a file created here would ride out on review-fixes/ into
		# somebody else's PR. The message names the command that does what was
		# almost certainly meant.
		if [ "$head_in_review" -eq 1 ]; then
			die "you are inside a review, and a file created in the work tree now would be extracted onto review-fixes/ by finish. For a guide of your own, outside the work tree: git review walkthrough guide"
		fi
		[ ! -e "$_guide_team_path" ] ||
			die ".review/walkthrough-guide.md already exists; open it and edit it"
		mkdir -p "$(dirname "$_guide_team_path")" ||
			die "could not create .review/"
		: >"$_guide_team_path" ||
			die "could not write .review/walkthrough-guide.md"
		echo "created .review/walkthrough-guide.md (empty)"
		echo "write the conventions this repository annotates its PRs by: which entries deserve '> key', how to write a why, what belongs in the heads-up. Content only -- it cannot change the walkthrough format. Then stage and commit it so the whole team gets it." >&2
		exit 0
	fi

	[ ! -e "$_guide_own_path" ] ||
		die "your guide already exists ($_guide_own_path); open it and edit it"
	# No mkdir: the common gitdir is already there, which is the whole difference
	# between this and the reviewer's draft, whose branch name can hold a '/' and
	# so needs a directory made for it.
	: >"$_guide_own_path" ||
		die "could not write $_guide_own_path"
	echo "created your guide ($_guide_own_path)"
	echo "write how YOU annotate a PR: which entries deserve '> key', how you write a why, what you want in the heads-up. It is never staged, never committed and never extracted by finish. Content only -- it cannot change the walkthrough format." >&2
	exit 0
fi

# ── Range resolution ──────────────────────────────────────────────────────────
#
# Two callers, one rule: annotate exactly the files the review will cover.
#
# init/build are the author's, standing on their own PR, so the tip is HEAD.
# draft is the reviewer's, standing on the base branch, so the tip is the named
# branch's remote (or local) copy — the same resolution git review start and
# emit_reading_offers use, flags included, because the draft has to list the file
# set of the review that start is about to create, not some other one.
if [ "$sub" = draft ]; then
	# Standing inside the review is the likeliest moment to want a draft: the
	# reviewer has just been shown the diff and wants to write the reading order
	# down. The branch they are on is not one anybody drafts for — review/feature/x
	# has no remote copy — so the bare command died with "origin/review/feature/x
	# not found", naming a ref that never existed and never will.
	#
	# Resolved through walk_review_draft_src, the same function every verb with an
	# active review resolves it with, which is what makes the draft this writes the
	# one that review then reads. It hands back a branch name — never a
	# remote-tracking one — so the range resolution below needs no special case for
	# where the name came from.
	from_review=0
	if [ -z "$branch" ]; then
		rb="$(git symbolic-ref --quiet --short HEAD || true)"
		case "$rb" in
		review/*)
			branch="$(walk_review_draft_src "$rb")"
			[ -z "$branch" ] || from_review=1
			;;
		esac
	fi
	[ -n "$branch" ] || branch="$(git symbolic-ref --quiet --short HEAD || true)"
	[ -n "$branch" ] || die "no branch given and HEAD is detached; name the branch to draft for"

	base="$(git config reviewworkflow.base || true)"
	[ -n "$base" ] ||
		die "no base set; run: git config reviewworkflow.base <branch>"

	remote="$(git config reviewworkflow.remote || echo origin)"
	# A compare of a loose revision records its own identity as the draft's name,
	# because a short SHA is the only name that comparison has — and that names no
	# branch, so the resolution below went looking for origin/<short-sha> and died
	# on a ref that never existed, exactly the way the bare command used to die on
	# origin/review/feature/x. Only for a name this verb derived from the review the
	# reviewer is standing in: a name they typed themselves is theirs to be told is
	# missing, which is what "$srclabel not found" already says.
	if [ "$from_review" -eq 1 ] &&
		! git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null &&
		! git rev-parse --verify --quiet "refs/remotes/$remote/$branch" >/dev/null; then
		die "this review compares $branch, which is not a branch; a walkthrough draft belongs to one, so name it: git review walkthrough draft <branch>"
	fi
	if [ "$local_only" -eq 1 ] || [ "$offline" -eq 1 ]; then
		srcref="refs/heads/$branch"
		srclabel="$branch"
		markerkey="reviewworkflowlocal.$branch.reviewed"
	else
		srcref="refs/remotes/$remote/$branch"
		srclabel="$remote/$branch"
		markerkey="reviewworkflow.$branch.reviewed"
	fi
	# No fetch, ever: like config --porcelain, this reads the refs already in the
	# clone. A missing tip is an actionable error, not an implicit network call.
	if ! git rev-parse --verify --quiet "$srcref^{commit}" >/dev/null; then
		die "$srclabel not found"
	fi
	tip="$(git rev-parse "$srcref")"

	baseref=""
	if [ "$offline" -eq 1 ]; then
		if git rev-parse --verify --quiet "refs/heads/$base^{commit}" >/dev/null; then
			baseref="refs/heads/$base"
		fi
	else
		if git rev-parse --verify --quiet "refs/remotes/$remote/$base^{commit}" >/dev/null; then
			baseref="refs/remotes/$remote/$base"
		fi
	fi
	if [ -z "$baseref" ]; then
		baseref="$(git rev-parse --verify --quiet "$base^{commit}" || true)"
	fi
	[ -n "$baseref" ] || die "base $base not found"

	if [ "$delta_mode" -eq 1 ]; then
		prev="$(git config "$markerkey" || true)"
		[ -n "$prev" ] ||
			die "no previous review of $branch recorded for this origin; run a full review first"
		[ "$prev" != "$tip" ] ||
			die "no new commits since your last review of $branch"
		git merge-base --is-ancestor "$prev" "$tip" ||
			die "$branch was force-pushed since your last review; draft for the full range instead"
		start="$prev"
	else
		start="$(git merge-base "$baseref" "$tip")" ||
			die "could not compute merge-base with $base"
		[ "$start" != "$tip" ] || die "no changes vs $base; nothing to walk through"
	fi
	# Tree-only bound, like the offers path: a draft must not commit-tree a
	# dangling "review lower bound" object just to list file names.
	lower="$(resolve_lower_bound "$start" "$baseref" "$tip")"

	# The PR's own range, carried alongside the one this run is writing about.
	# With --delta the two differ, and the difference is the whole reason this
	# exists: a path the PR changes in a commit you already reviewed is still a
	# file your reading order may describe. `lower` answers "what does this run
	# WRITE about"; this answers "what is this draft ALLOWED to hold" -- and
	# conflating them is what made --delta destroy prose about files the PR
	# still changes, on a flag that reads as a lens.
	#
	# merge-base and not resolve_lower_bound: with the full range's own start the
	# fold can never fire (the merge-base is its own ancestor), so the extra call
	# would be a process spent to be handed back its argument. Falls back to the
	# range in force if it cannot be computed, which is the pre-existing
	# behaviour and never widens what is allowed.
	pr_lower="$lower"
	if [ "$delta_mode" -eq 1 ]; then
		pr_lower="$(git merge-base "$baseref" "$tip" 2>/dev/null || true)"
		[ -n "$pr_lower" ] || pr_lower="$lower"
	fi

	draftpath="$(walk_draft_path "$branch")"
	# Reported instead of the absolute path: shorter, and it is where the reviewer
	# will look. The absolute one is what gets opened, either way.
	draftrel="\$GIT_DIR/review-walkthrough/$branch.md"

	# The origin and range flags this run resolved with, echoed back into the
	# commands the messages below suggest. Without them the suggestion is a
	# different command: --build would validate the draft against another range,
	# and on a branch with no copy on the remote both --build and start fail
	# outright with "origin/<branch> not found" — after telling you to run them.
	draftflags=""
	if [ "$offline" -eq 1 ]; then
		draftflags=" --offline"
	elif [ "$local_only" -eq 1 ]; then
		draftflags=" --local"
	fi
	if [ "$delta_mode" -eq 1 ]; then
		draftflags="$draftflags --delta"
	fi

	# The same flags again, normalised into the shape the instruction block
	# records and config --porcelain reads back out of it: no leading space, a
	# fixed order, and a literal for "none of them". Separate from draftflags on
	# purpose — that one is glued into command suggestions and has to keep its
	# leading space, while this one is a value.
	genflags=""
	if [ "$offline" -eq 1 ]; then
		genflags="--offline"
	elif [ "$local_only" -eq 1 ]; then
		genflags="--local"
	fi
	if [ "$delta_mode" -eq 1 ]; then
		if [ -n "$genflags" ]; then
			genflags="$genflags --delta"
		else
			genflags="--delta"
		fi
	fi
	[ -n "$genflags" ] || genflags="(defaults)"

	# Named in the block's incremental sentence, and empty when the range is the
	# whole PR, which is how walk_emit_prompt_block decides whether to write it.
	deltabranch=""
	if [ "$delta_mode" -eq 1 ]; then
		deltabranch="$branch"
	fi
fi

# Resolve the review range exactly as a reviewer's git review start would: HEAD is
# the PR tip (you author on the PR branch), the lower bound is the fold-adjusted
# merge-base with the base. Sharing fold_lower guarantees init lists — and build
# validates against — precisely the file set a reviewer will see.
if [ "$sub" != draft ]; then
tip="$(git rev-parse --verify --quiet HEAD)" || die "no HEAD to walk through"

if [ -z "$base" ]; then
	base="$(git config reviewworkflow.base || true)"
fi
[ -n "$base" ] ||
	die "no base set; pass --base <base> or run: git config reviewworkflow.base <branch>"

# Resolve the base to a commit-ish for the merge-base: prefer the remote's copy,
# then a local branch, then any commit-ish (tag/SHA), loosely mirroring start.
remote="$(git config reviewworkflow.remote || echo origin)"
baseref=""
if git rev-parse --verify --quiet "refs/remotes/$remote/$base^{commit}" >/dev/null; then
	baseref="refs/remotes/$remote/$base"
elif git rev-parse --verify --quiet "refs/heads/$base^{commit}" >/dev/null; then
	baseref="refs/heads/$base"
else
	baseref="$(git rev-parse --verify --quiet "$base^{commit}" || true)"
fi
[ -n "$baseref" ] || die "base $base not found"

mb="$(git merge-base "$baseref" "$tip")" || die "could not compute merge-base with $base"
if [ "$mb" = "$tip" ]; then
	# Nothing committed vs the base. If the tree is dirty, the author almost
	# certainly has the PR changes staged/unstaged rather than committed — say so,
	# because "no changes vs base" is baffling when your diff is sitting right there.
	if has_uncommitted; then
		die "no committed changes vs $base, but you have uncommitted changes; commit the PR first (do not push on the user's behalf). The walkthrough is built from committed history (base..HEAD)"
	fi
	die "no changes vs $base; nothing to walk through"
fi
lower="$(fold_lower "$mb" "$baseref" "$tip")"
# No range flag reaches init/build, so the PR's range and the range in force are
# the same object -- assigned rather than recomputed so the readers below can
# stay unconditional.
pr_lower="$lower"
# init and build take no origin or range flags at all, so the block's record of
# them is the literal. --base picks a different base, not a different origin.
genflags="(defaults)"
deltabranch=""
fi

toplevel="$(git rev-parse --show-toplevel)"
wtrel=".review/walkthrough.md"
wtpath="$toplevel/$wtrel"

# What each subcommand reads and writes. The two differ in exactly one thing —
# where the file lives — which is the entire point of the feature: the author's
# is content of the PR, the reviewer's must never be.
if [ "$sub" = draft ]; then
	targetpath="$draftpath"
	targetrel="$draftrel"
else
	targetpath="$wtpath"
	targetrel="$wtrel"
fi

# The annotatable file set: everything the PR changes, minus the sidecar
# directory itself (a walkthrough never annotates .review/ — the only place in
# the project this filter still applies; every reader of "what does this
# review touch" now includes it, since it is content like any other file the
# PR changes). Named distinctly from git-review-lib.sh's range_files, which
# this script also has in scope via the source above and which does NOT
# filter: same shape, opposite policy, so a shared name here would silently
# shadow one or the other depending on source order.
annotatable_files() {
	changed_paths "$lower" "$tip" | grep -v '^\.review/' || true
}

# The same set over the PR's whole range: what an entry is allowed to name, as
# opposed to what this run is writing about. Identical to annotatable_files
# except under --delta, and the caller below skips it entirely when the two
# bounds are the same object -- this is one more diff over the whole PR, and it
# would be spent to recompute a list already in a variable.
pr_annotatable_files() {
	changed_paths "$pr_lower" "$tip" | grep -v '^\.review/' || true
}

# Skeleton generation, shared by init and draft rather than copied: the text is a
# long set of instructions to whoever fills it in, and all but its closing note is
# written for "the person annotating this PR" without assuming that person is the
# author. Two copies would drift, and the drift would be invisible until someone
# read the wrong one — so the two lines that genuinely differ are switched inline
# (see below) instead of forking the block.
if [ "$sub" = init ] || { [ "$sub" = draft ] && [ "$build_draft" -eq 0 ]; }; then
	# An existing file is UPDATED, not refused and not overwritten: every entry
	# whose path is still in range keeps its number, its why and its markers, the
	# paths that entered the range arrive as "## ?." placeholders, and the ones
	# that left are dropped and named on stderr. That is the whole point — a PR
	# that was finished, annotated and then touched again is the ordinary case,
	# and the two things this command could do before were refuse (leaving the
	# reader to hand-edit) or overwrite (destroying every why in the file).
	#
	# --force keeps meaning what it means everywhere else in this suite: throw away
	# what is there and generate from scratch. It is the only way back to a blank
	# skeleton, and it has to stay reachable — a merge cannot un-write prose that
	# describes the wrong thing.
	# Both sides, and for the same reason. The author's sidecar goes stale because
	# the PR keeps moving under a file that is already committed; the reviewer's
	# draft is written against a tip that start then FREEZES, so it cannot fall out
	# of step DURING a review -- but it outlives the review, and the next one is
	# over a range that moved. That is the case this exists for: you read the PR,
	# three more files land, and the order you wrote is still the right starting
	# point for all but those three.
	#
	# The draft side used to refuse instead, on the circuit that save, continue and
	# forget all speak ("the file is there, so I refuse"). Refusing left --force as
	# the only way through, which throws away every why to get at the new files.
	# -f and not -e: what can be reconciled is a regular file. Anything else with
	# that name -- a directory, most plausibly a branch name that cannot be one on
	# this filesystem -- falls through to the write path, which fails with the
	# message that names the real problem instead of an awk that cannot read it.
	update=0
	if [ -f "$targetpath" ] && [ "$force" -eq 0 ]; then
		update=1
	fi
	# A walkthrough that came in WITH a merge is not this PR's, and reconciling
	# against it is worse than not reconciling at all: the entry for a file both
	# PRs happen to touch keeps a why about a change that already shipped, and
	# that prose gets committed to this PR. It is not staleness — nothing fell
	# behind; it belongs to a range that closed.
	#
	# So this is the one case that starts over on its own, and it does not need
	# --force to do it. The asymmetry is deliberate and it is about what each
	# mistake looks like: prose kept from another PR reads exactly like a valid
	# walkthrough, while a blank skeleton is visible at a glance -- and the file
	# is tracked, so the old entries are one git checkout away either way.
	# init only, and the asymmetry is about what the mistake costs. Starting over
	# on its own destroys what is written, and on the author's side that is one
	# git checkout away because the file is tracked. A reviewer's draft is not in
	# git at all, so deciding to discard their prose for them has no way back --
	# and it never comes up either: a branch already merged into the base has no
	# range left, and annotatable_files dies on that before reaching this.
	superseded=0
	if [ "$update" -eq 1 ] && [ "$sub" = init ]; then
		blocktip="$(walk_sidecar_block_tip "$targetpath" || true)"
		if walk_sidecar_superseded "$blocktip" "$baseref"; then
			superseded=1
			update=0
		fi
	fi
	# Nothing refuses over an existing file any more: both subcommands either
	# reconcile it or, with --force, replace it. What is left of the old guard is
	# the invariant it protected -- an existing file is never silently overwritten --
	# which now holds by construction, since the only path that writes from scratch
	# over one is the one that asked for it.
	files="$(annotatable_files)"
	[ -n "$files" ] || die "no changed files vs $base to list"
	# What an entry may name, which is not the same question as what this run
	# writes about (see pr_lower). The same object under every path but --delta,
	# and reused rather than recomputed there.
	if [ "$pr_lower" = "$lower" ]; then
		pr_files="$files"
	else
		pr_files="$(pr_annotatable_files)"
	fi

	# ── Update: reconcile what is written with what the range now holds ─────────
	#
	# Three sets, computed once, in ONE awk over both sides: the entries whose path
	# is still in range (kept, with their number and their prose), the range paths
	# no entry covers (added, as "## ?." placeholders) and the entries whose path
	# left the range (removed, named on stderr and gone from the file).
	#
	# Same two-stream, range-first, lone-tab-sentinel shape as walk_sequence and
	# walk_entry_fields, and safe for the same reason: git quotes control
	# characters in a path unconditionally, so no line of the range side can be a
	# bare tab.
	#
	# Unlike walk_parse this accepts "## ?." headings as entries. An author who
	# wrote the why but has not numbered it yet is mid-authoring, not absent, and
	# dropping their prose here would be the overwrite this whole path exists to
	# stop happening.
	#
	# The sort key is emitted rather than the order: kept entries come back in the
	# author's numbering, unnumbered ones after them, and added paths last in git's
	# order — so an update reads as "what you had, then what is new", and build
	# renumbers 1..N afterwards as it always has.
	prev_content=""
	merged_kept=0
	merged_added=0
	merged_removed=""
	if [ "$update" -eq 1 ]; then
		prev_content="$(walk_normalize <"$targetpath")"
		plan="$({
			printf '%s\n' "$pr_files"
			printf '\t\n'
			printf '%s\n' "$files"
			printf '\t\n'
			printf '%s\n' "$prev_content"
		} | awk '
			phase == 0 {
				if ($0 == "\t") { phase = 1; next }
				if ($0 != "") inpr[$0] = 1
				next
			}
			phase == 1 {
				if ($0 == "\t") { phase = 2; next }
				if ($0 != "") { nr++; rank[$0] = nr; inrange[$0] = 1 }
				next
			}
			/^## / {
				line = substr($0, 4)
				if (match(line, /^[0-9]+\. /)) {
					ord = substr(line, 1, RLENGTH - 2)
					path = substr(line, RLENGTH + 1)
				} else if (match(line, /^\?\. /)) {
					ord = "?"
					path = substr(line, RLENGTH + 1)
				} else {
					next
				}
				sub(/[ \t]+$/, "", path)
				if (path == "") next
				# A path written twice keeps its first entry, the way build reports
				# the duplicate rather than guessing which copy was meant.
				if (path in seen) next
				seen[path] = 1
				# Three outcomes, not two. An entry inside the range is kept and covers
				# its path; one outside the range but still inside the PR is kept and
				# covers nothing -- it names a file this run is not writing about, and
				# its prose is not this run\047s to throw away; only an entry whose
				# file the PR no longer changes is dropped, which is what the note on
				# stderr has always claimed and, until the PR range reached here, was
				# not true under --delta.
				if (path in inrange || path in inpr) {
					if (path in inrange) covered[path] = 1
					printf "K\t%s\t%s\t%s\n", (ord == "?" ? 1000000 : ord), ord, path
				} else {
					printf "R\t0\t\t%s\n", path
				}
			}
			END {
				for (p in inrange) {
					if (!(p in covered)) printf "A\t%s\t?\t%s\n", 2000000 + rank[p], p
				}
			}
		')"
		# A leading class letter, not a range of sort keys: telling kept from added
		# by "is the key above two million" is the kind of test that reads as
		# arbitrary six months from now and breaks outright on an author who
		# numbered an entry 3000000.
		merged_removed="$(printf '%s\n' "$plan" | grep '^R' | cut -f4- || true)"
		plan_entries="$(printf '%s\n' "$plan" | grep -v '^R' | grep . |
			LC_ALL=C sort -k2,2n | cut -f3- || true)"
		merged_kept="$(printf '%s\n' "$plan" | grep -c '^K' || true)"
		merged_added="$(printf '%s\n' "$plan" | grep -c '^A' || true)"
	fi

	# The author's preamble as it stands, carried through verbatim — the heads-up
	# they wrote, or the placeholder they have not filled in yet. NOT walk_preamble,
	# which strips every comment: that one serves the readers, and here an unfilled
	# placeholder has to survive or an update would quietly answer build's "the
	# heads-up placeholder is still there" on the author's behalf.
	#
	# The instruction block goes (walk_prompt_block), because the one emitted below
	# is regenerated for the range this run resolved; the "# Walkthrough" heading
	# goes because the skeleton writes it back.
	prev_preamble=""
	if [ "$update" -eq 1 ]; then
		prev_preamble="$(printf '%s\n' "$prev_content" | walk_prompt_block | awk '
			NR == 1 && $0 == "# Walkthrough" { next }
			/^## / {
				line = substr($0, 4)
				if (line ~ /^([0-9]+|\?)\. /) exit
			}
			{ buf[++n] = $0 }
			END {
				s = 1; while (s <= n && buf[s] ~ /^[ \t]*$/) s++
				e = n; while (e >= s && buf[e] ~ /^[ \t]*$/) e--
				for (i = s; i <= e; i++) print buf[i]
			}
		')"
	fi

	# emit_merged_entries
	# The reconciled entry list: each kept path with its number and its body
	# exactly as the author left it (markers included — normalising them is
	# build's job, not this one's), each added path as a "## ?." placeholder.
	#
	# One awk for the whole file, not one walk_body per entry: three processes per
	# entry is the shape that cost ~15s on a 200-entry walkthrough under Git Bash,
	# and it was removed everywhere else for that reason.
	emit_merged_entries() {
		{
			printf '%s\n' "$plan_entries"
			printf '\t\n'
			printf '%s\n' "$prev_content"
		} | awk '
			!tail {
				if ($0 == "\t") { tail = 1; next }
				if ($0 == "") next
				i = index($0, "\t")
				n++
				ord[n] = substr($0, 1, i - 1)
				want[n] = substr($0, i + 1)
				next
			}
			/^## / {
				line = substr($0, 4)
				if (sub(/^[0-9]+\. /, "", line) || sub(/^\?\. /, "", line)) {
					sub(/[ \t]+$/, "", line)
					cur = line
					had[cur] = 1
				} else {
					cur = ""
				}
				next
			}
			cur != "" { cnt[cur]++; body[cur, cnt[cur]] = $0 }
			END {
				for (i = 1; i <= n; i++) {
					p = want[i]
					printf "## %s. %s\n", ord[i], p
					if (p in had) {
						c = cnt[p] + 0
						s = 1; while (s <= c && body[p, s] ~ /^[ \t]*$/) s++
						e = c; while (e >= s && body[p, e] ~ /^[ \t]*$/) e--
						for (k = s; k <= e; k++) print body[p, k]
					} else {
						print "<!-- why: -->"
					}
					printf "\n"
				}
			}
		'
	}

	# The lower bound's object type, one process, and only on a path that is about
	# to produce a skeleton. It goes in the block because it is why the commands
	# there are shaped the way they are: with the base merged into the PR the bound
	# is a tree, and a tree is what makes the history commands lie instead of fail.
	lower_kind="$(git cat-file -t "$lower" 2>/dev/null || echo unknown)"
	# Which working tree this skeleton is being written from. Decided by HEAD, not
	# by from_review — see the note where head_in_review is set.
	if [ "$sub" != draft ]; then
		situation="init"
		tiplabel="HEAD"
	elif [ "$head_in_review" -eq 1 ]; then
		situation="review"
		tiplabel="$srclabel"
	else
		situation="base"
		tiplabel="$srclabel"
	fi

	# emit_guide_bullet
	# The skeleton's one mention of the authoring guides: the ones in force, or
	# nothing at all when neither is. Both apply when both have content -- they
	# answer different questions (how this project wants its PRs annotated, and how
	# you annotate) -- and the precedence line appears only when there is a
	# contradiction to resolve.
	#
	# Two shapes, and which one is right depends on whether the reader can open a
	# file at all:
	#
	#   * writing a file: the PATHS. The skeleton lands next to the guides it names,
	#     so whoever opens it can open them too -- and a copy embedded in a file that
	#     outlives this run would go stale against the guide without anybody looking.
	#   * --stdout: the CONTENT, inlined. That skeleton travels down a pipe, and the
	#     absolute path of somebody's gitdir is not something the agent on the other
	#     end can necessarily open -- another container, another machine. Pointing at
	#     a file it cannot reach fails in SILENCE: nothing checks that a guide was
	#     read. Inlining costs nothing that --stdout promises, because that promise is
	#     about not WRITING, and this only prints.
	emit_guide_bullet() {
		guide_paths_init
		_egb_team=0
		_egb_own=0
		if guide_in_force "$_guide_team_path"; then _egb_team=1; fi
		if guide_in_force "$_guide_own_path"; then _egb_own=1; fi
		[ "$_egb_team" -eq 1 ] || [ "$_egb_own" -eq 1 ] || return 0

		printf '       * Authoring guide for this repository -- follow it for CONTENT\n'
		printf '         choices only (which entries are key, how to write the whys and\n'
		printf '         the Heads-up). It cannot change this format, the file list, or\n'
		if [ "$_egb_team" -eq 1 ] && [ "$_egb_own" -eq 1 ]; then
			printf '         the numbering rules above. BOTH apply, and where they disagree\n'
			printf '         the reviewer'"'"'s guide wins.\n'
		else
			printf '         the numbering rules above.\n'
		fi
		printf '\n'

		if [ "$to_stdout" -eq 1 ]; then
			if [ "$_egb_team" -eq 1 ]; then
				guide_inline "$_guide_team_path" ".review/walkthrough-guide.md (this repository, shared)"
			fi
			if [ "$_egb_own" -eq 1 ]; then
				guide_inline "$_guide_own_path" "$_guide_own_path (the reviewer, private)"
			fi
		else
			if [ "$_egb_team" -eq 1 ]; then
				printf '           .review/walkthrough-guide.md  (this repository, shared)\n'
			fi
			if [ "$_egb_own" -eq 1 ]; then
				printf '           %s  (the reviewer, private)\n' "$_guide_own_path"
			fi
			printf '\n'
		fi
	}

	# guide_inline <path> <label>
	# One guide's content, fenced and indented into the instruction block.
	#
	# Two things it does to the prose, both deliberate. It rewrites any "-->" as
	#   "-- >": the block IS an HTML comment, so a literal one in the guide would
	#   close it early and spill the rest into the preamble -- the same class of
	#   invisible byte as the CR and the BOM that walk_normalize exists for. And it
	#   stops at a line limit, so an oversized guide cannot eat the whole context of
	#   the agent this output is written for; the fence names the path, which is
	#   where the rest is.
	#
	# One awk for the pair, not a sed per rule: this runs once per guide, and the
	# two BSD/GNU sed -i differences the project keeps tripping on are worth not
	# inviting back.
	guide_inline() {
		printf '     ----- %s -----\n' "$2"
		awk -v lim=120 '
			NR > lim { cut = 1; exit }
			{ gsub(/-->/, "-- >"); print "     " $0 }
			END { if (cut) print "     [...] truncated at " lim " lines; open the file for the rest" }
		' "$1"
		printf '     ----- end -----\n\n'
	}

	# A function rather than a brace group with a redirection glued to it, because
	# it now has two destinations: the temp file on the way to $targetpath, and
	# standard output under --stdout. Same bytes either way, bar the closing line
	# below, which has to name a different command when no file was written.
	emit_skeleton() {
		printf '# Walkthrough\n\n'
		walk_emit_prompt_block "$tip" "$lower" "$tiplabel" "$lower_kind" \
			"$situation" "$genflags" "$deltabranch"
		printf '\n'
		# Two openings, one body. On an update most of the file is already written
		# and the single most damaging thing the agent can do is rewrite it: the
		# whole point of preserving the prose is lost if the next reader is told
		# every entry is a placeholder. Everything after this paragraph applies
		# unchanged to both, because it describes the format, not the situation.
		if [ "$update" -eq 1 ]; then
			printf '<!-- Update the reading order for this PR. Entries that already carry\n'
			printf '     a number and a why are FINISHED: leave them exactly as they are,\n'
			printf '     prose included. Only the "## ?." entries below are yours to fill\n'
			printf '     in -- they are files the PR did not touch when this was last\n'
			printf '     written. Do not add, remove, or reorder entries, and do not move\n'
			printf '     any line.\n\n'
			printf '     If an existing why no longer describes what its file now does,\n'
			printf '     rewrite that one why. Nothing else.\n\n'
		else
			printf '<!-- Author the reading order for this PR. The entries below are\n'
			printf '     PLACEHOLDERS. Edit them in place: do not add, remove, or reorder\n'
			printf '     entries, and do not move any line -- keep every file exactly where\n'
			printf '     it is, and keep all of them.\n\n'
		fi
		printf '       * "## ?. <file>": replace only the "?" with a reading position\n'
		printf '         (1, 2, 3, ...). build orders the files by these numbers and\n'
		printf '         renumbers them 1..N, so you never reorder the lines yourself.\n'
		printf '       * The why placeholder beneath each file is an HTML comment line.\n'
		printf '         DELETE that whole comment (opening and closing markers\n'
		printf '         included) and write a plain-text note on what to look at and\n'
		printf '         why in its place. Leaving the comment there, even with text\n'
		printf '         inside it, counts as unfilled and build will reject it.\n'
		printf '       * Mark the essential entries: on the few files that carry the\n'
		printf '         change -- the ones a reviewer must not skim -- add a line\n'
		printf '         reading exactly "> key" as the FIRST line of the why. It takes\n'
		printf '         no value; the why says the rest. Leave every other entry\n'
		printf '         unmarked: the marker is only useful while it stays selective,\n'
		printf '         so mark a handful, not half the PR. Generated files, lockfiles,\n'
		printf '         mechanical renames and the like are exactly what stays unmarked.\n'
		if [ "$update" -eq 1 ]; then
			printf '       * The "## Heads-up" section below is carried over as it was.\n'
			printf '         Change it only if what is delicate about this PR changed.\n'
		else
			printf '       * Fill in the "## Heads-up" section below with what a reviewer\n'
			printf '         should keep in mind before opening a single file.\n'
		fi
		# The guides IN FORCE, named, and nothing at all when there are none. The
		# path used to be hardcoded here whether the file existed or not, which
		# spent five lines of the agent's attention on a file that was usually not
		# there -- and, once a second guide could exist, said the wrong thing.
		#
		# This is the one channel that always reaches whoever has to follow them.
		# The stderr note below reaches a terminal; an agent handed the skeleton
		# through a pipe (draft --stdout) never sees it, and that agent is exactly
		# who this text is written for.
		emit_guide_bullet
		# The two passages that cannot be written for "whoever annotates this PR".
		# Everything above genuinely is shared; these are the author's, and the
		# reviewer used to be handed their copy of both: a command that dies from
		# the base (build reads .review/walkthrough.md on the branch you are
		# standing on, and the reviewer is not standing on the PR), and an
		# instruction to commit a PR that is not theirs — the very advice warn_dirty
		# is deliberately suppressed for on this path, contradicted in the file the
		# reviewer has open.
		if [ "$sub" = draft ]; then
			printf '     Note: this walkthrough is built from the committed history of\n'
			printf '     %s, over the range named at the top of this file and\n' "$srclabel"
			printf '     never from your working tree -- the edits you make while reviewing\n'
			printf '     are invisible here, and nothing you write in this file is\n'
			printf '     ever staged or committed.\n\n'
			# Under --stdout no file was written, so the ordinary closing line is
			# not merely unhelpful, it is dangerous: --build without --from either
			# dies with "no draft for <branch>", or -- if that branch happens to
			# have a draft from before -- validates and rewrites THAT file, with
			# exit 0 and a success message, discarding what the agent just wrote.
			# That is precisely the silent failure this circuit exists to remove.
			if [ "$to_stdout" -eq 1 ]; then
				printf '     Then validate and install what you wrote with:\n'
				printf '       git review walkthrough draft --build --from <file>%s %s\n' "$draftflags" "$branch"
				printf '     (or --from - to read it from standard input) -->\n\n'
			else
				printf '     Then validate and write with:  git review walkthrough draft --build%s %s -->\n\n' "$draftflags" "$branch"
			fi
		else
			printf '     Note: this walkthrough is built from committed history, over the range\n'
			printf '     named at the top of this file. Commit the PR before authoring it --\n'
			printf '     with uncommitted changes you may be annotating incomplete work, and\n'
			printf '     build will not see those files. Commit them first; never push\n'
			printf '     automatically.\n\n'
			# The author's half of the same switch the draft side makes above, and
			# for the same reason: under --stdout nothing was written, so a closing
			# line naming a bare "build" points at whatever .review/walkthrough.md
			# happens to be in the work tree -- which validates and rewrites THAT
			# file with exit 0, discarding what the agent just produced.
			if [ "$to_stdout" -eq 1 ]; then
				printf '     Then validate and install what you wrote with:\n'
				printf '       git review walkthrough build --from <file>\n'
				printf '     (or --from - to read it from standard input) -->\n\n'
			else
				printf '     Then validate and write with:  git review walkthrough build -->\n\n'
			fi
		fi
		# On an update the author's preamble is carried through as it stands —
		# their heads-up, or the placeholder they have not filled in yet. Emitting
		# the placeholder over prose somebody wrote would be the overwrite this
		# path exists to prevent; emitting nothing where they deleted the whole
		# section (legal, and what build tells you to do when nothing is delicate)
		# would put it back.
		if [ "$update" -eq 1 ]; then
			if [ -n "$prev_preamble" ]; then
				printf '%s\n\n' "$prev_preamble"
			fi
			emit_merged_entries
		else
			printf '## Heads-up\n\n'
			printf '<!-- heads-up: the delicate parts of this PR, in a few lines -- the\n'
			printf '     invariants it can break, the subtle or risky bits, anything that\n'
			printf '     looks fine in isolation but is not, and what to be suspicious of.\n'
			printf '     This is read once, before the first file. DELETE this whole comment\n'
			printf '     (opening and closing markers included) and write it as plain text.\n'
			printf '     If nothing here is delicate, delete the "## Heads-up" heading too --\n'
			printf '     an empty section is worse than none. Leaving the comment, even with\n'
			printf '     text inside it, counts as unfilled and build will reject it. -->\n\n'
			printf '%s\n' "$files" | while IFS= read -r f; do
				[ -n "$f" ] || continue
				printf '## ?. %s\n' "$f"
				printf '<!-- why: -->\n\n'
			done
		fi
	}

	if [ "$to_stdout" -eq 1 ]; then
		# Nothing else touches the filesystem on this path: no mkdir, no temp
		# file, no traps, no mv. That is the invariant --stdout sells, and it is
		# what makes "draft --stdout <branch> > order.md" a thing an agent can be
		# handed without it writing into anybody's gitdir.
		emit_skeleton
	else
		mkdir -p "$(dirname "$targetpath")"
		tmp="$targetpath.tmp.$$"
		# Removed on any exit, not just the happy one. Without this a die between
		# here and the mv below — or a Ctrl-C — left a .tmp.NNN beside the drafts
		# forever: walk_draft_list only matches *.md so nothing mistook it for a
		# draft, but nothing collected it either, since clean is deliberately
		# hands-off in there and forget --draft only knows names it can spell.
		trap 'rm -f "$tmp"' EXIT
		# Cleaning up is not the same as stopping. A POSIX shell resumes the script
		# where the signal hit once the handler returns, so a Ctrl-C that only ran
		# the rm above deleted the temp file and then let the rest of the command
		# write it again and move it into place — the interrupt did nothing.
		# Exiting from the handler is what makes it an interrupt; the EXIT trap
		# runs on the way out and does the removing, once, for both paths.
		# 128+signal, the way a shell reports a signalled child.
		trap 'exit 130' INT
		trap 'exit 143' TERM
		# Fail on the file, not on the redirect. A branch name is a file name here,
		# and some legal branch names are not legal files: "nul", "aux" and "com1"
		# are reserved device names on Windows, and a bare shell redirection error
		# would report a path with no hint of why that one is special.
		if ! : >"$tmp" 2>/dev/null; then
			die "could not write $targetrel; the branch name may not be usable as a file name on this system"
		fi
		# And refuse outright when the name is taken by something that is not a
		# regular file. mv(1) into a directory MOVES THE FILE INSIDE IT and reports
		# success, so without this the skeleton landed as <target>/<tmp name>, the
		# command said it had written it, and nothing on disk was a draft.
		if [ -e "$targetpath" ] && [ ! -f "$targetpath" ]; then
			die "$targetrel exists and is not a file; move it out of the way first"
		fi
		emit_skeleton >"$tmp"
		mv "$tmp" "$targetpath"
		trap - EXIT INT TERM
	fi

	n="$(printf '%s\n' "$files" | grep -c .)"

	# What an update dropped, named one by one. Prose somebody typed is going away,
	# and the only thing that makes that acceptable is saying so where they can see
	# it — plus the fact that the sidecar is a tracked file, so the way back is one
	# command. On stderr: under --stdout the file was not even rewritten, and
	# stdout has to stay a valid walkthrough.
	#
	# The way back is named only on the author's side, because only there is there
	# one: the sidecar is a tracked file and the dropped whys are one git checkout
	# away. A reviewer's draft is not in git, so the note is all there is -- which
	# is why it names every path instead of counting them.
	# Said before anything else this command prints, because it is the reason the
	# file the author had is not the file they now have. Named with the base it
	# landed in, so it reads as a fact about the repository and not as a refusal.
	if [ "$superseded" -eq 1 ]; then
		{
			echo "note: the walkthrough in your tree is $base's, not this PR's -- it came in with the merge of the PR that wrote it, so its entries describe changes that already shipped. Started a new one."
			echo "      The old one is in git: git checkout -- $targetrel to get it back."
		} >&2
	fi

	if [ "$update" -eq 1 ] && [ -n "$merged_removed" ]; then
		{
			echo "note: $(printf '%s\n' "$merged_removed" | grep -c .) entry/entries dropped -- the PR no longer changes these files:"
			printf '%s\n' "$merged_removed" | sed 's/^/        /'
			if [ "$sub" = init ]; then
				echo "      Their whys are in git: git checkout -- $targetrel to get them back."
			fi
		} >&2
	fi

	if [ "$sub" = draft ]; then
		# Suppressed under --stdout, and only this one: stdout has to be the
		# skeleton and nothing else, so that redirecting it produces a valid file.
		# Every note below already goes to stderr and stays there.
		# Two lines, because the two outcomes are different work: a fresh skeleton
		# is written from end to end, an update leaves you only the entries it just
		# added. Same shape as init's pair, with this side's build command.
		if [ "$to_stdout" -eq 0 ]; then
			if [ "$update" -eq 1 ]; then
				# "fill in the new entries" only when there ARE new entries. An
				# update that adds none is a real outcome, not a no-op -- the
				# range moved without changing which files it touches, and the
				# instruction block has just been rewritten against the new tip --
				# but telling the reviewer to go fill in nothing sends them to an
				# unchanged file looking for a placeholder that is not there.
				merged_dropped="$(printf '%s\n' "$merged_removed" | grep -c . || true)"
				if [ "$merged_added" -gt 0 ]; then
					next_step="fill in the new entries, then run git review walkthrough draft --build$draftflags $branch"
				else
					next_step="no new entries to fill in; run git review walkthrough draft --build$draftflags $branch when you are ready"
				fi
				echo "updated $targetrel: $merged_kept kept, $merged_added added, $merged_dropped dropped; $next_step"
			else
				echo "wrote $targetrel with $n file(s) from $srclabel; fill in the order and why, then run git review walkthrough draft --build$draftflags $branch"
			fi
		fi
		# The reviewer's draft wins over the PR's own walkthrough for as long as it
		# exists (see walk_read). Silently shadowing an author's reading order would
		# be the kind of surprise this project spends its error messages avoiding —
		# so say it, and carry on: choosing your own order is legitimate, and the
		# assistant never proposes this, you had to ask for it.
		if git show "$tip:.review/walkthrough.md" >/dev/null 2>&1; then
			echo "note: $branch already carries a walkthrough from its author; your draft takes precedence over it while it exists. Delete it to go back to theirs." >&2
		fi
		# A paused review took its draft with it (git review save), which is why the
		# "already exists" guard above saw nothing to protect. Say it now, while the
		# new file is one line old: the two only meet again at git review continue,
		# which refuses rather than choose between them, and learning about the
		# collision then means having written the whole thing first.
		#
		# Which of the two notes depends on whether a paused review still claims the
		# archived file, asked of the reviews rather than of the file's name — the last
		# surface that decided by the name, and the one where getting it wrong only
		# misinforms: with no claimant there is no git review continue to refuse, and
		# the next save replaces the leftover instead of stopping.
		if [ -f "$(walk_saved_draft_path "$branch")" ]; then
			if walk_saved_draft_claims | cut -f1 | grep -Fxq -e "$branch"; then
				echo "note: a paused review of $branch carries a walkthrough draft of its own; git review continue will not resume over this one until one of the two is gone." >&2
			else
				echo "note: an archived walkthrough draft for $branch is left over from a review that no longer exists; discard it with git review forget --draft --all, or the next git review save will replace it with this one." >&2
			fi
		fi
		# Deliberately no warn_dirty: a draft is derived from committed refs, not
		# from your working tree, so what you have uncommitted is nobody's business
		# here — you are reviewing someone else's branch.
	elif [ "$to_stdout" -eq 0 ]; then
		if [ "$update" -eq 1 ]; then
			echo "updated $targetrel: $merged_kept kept, $merged_added added, $(printf '%s\n' "$merged_removed" | grep -c . || true) dropped; fill in the new entries, then run git review walkthrough build"
		else
			echo "wrote $targetrel with $n file(s); fill in the order and why, then run git review walkthrough build"
		fi
		warn_dirty
	else
		# --stdout wrote nothing, so there is no "wrote" line to print and stdout
		# belongs to the skeleton. warn_dirty still applies and still goes to
		# stderr: an author piping this to an agent is exactly as likely to be
		# annotating work they have not committed.
		warn_dirty
	fi
	emit_guide_note
	exit 0
fi

# ── build ─────────────────────────────────────────────────────────────────────
# Reached by `build` (the author's sidecar) and by `draft --build` (the
# reviewer's). Every rule below — placeholders, malformed headings, "> key" with
# a value, duplicate paths, drift against the range — is one body of validation
# serving both, so a draft is held to exactly the standard a committed
# walkthrough is, and neither can gain a rule the other lacks.
#
# Guard order is fixed, and two requirements hang off it: existence of the target
# is settled BEFORE the source is read, because refusing after consuming standard
# input leaves the caller with no way to retry; and the single write is the mv at
# the very end, so every refusal below leaves whatever was there byte for byte
# untouched.
if [ "$sub" = draft ]; then
	if [ "$from_given" -eq 1 ]; then
		# With --from the absence of a previous draft is the ordinary case — the
		# content is arriving from outside and is about to be installed fresh —
		# and it is the PRESENCE that needs consent, because prose written by
		# hand is about to be replaced by prose from somewhere else.
		if [ -e "$targetpath" ] && [ "$force" -eq 0 ]; then
			die "$targetrel already exists; pass --force to overwrite"
		fi
	else
		[ -e "$targetpath" ] ||
			die "no draft for $branch; run git review walkthrough draft$draftflags $branch first"
	fi
elif [ "$from_given" -eq 0 ]; then
	[ -e "$targetpath" ] || die "$targetrel not found; run git review walkthrough init first"
fi
# No presence guard on the author's --from, and no --force to go with it: build
# ALREADY rewrites .review/walkthrough.md on every ordinary run, so demanding
# consent to replace it here would contradict the verb one flag over — and would
# make --force mandatory in the common case (a PR that was annotated and is now
# being updated), which is how a destructive flag gets typed by reflex. The
# asymmetry with the draft side is real and is the file itself: the sidecar is
# tracked, so git checkout -- brings the old prose back; a draft is tracked by
# nothing.

# Read through walk_normalize for the same reason the runtime readers do: an
# editor that saved CRLF would otherwise leave a \r on every path (drift errors
# naming the same file on both sides) and on every "> key" marker (silently
# unmarked), and one that prepended a BOM would hide the "# Walkthrough" heading.
# Since build rewrites the file from this content, such a walkthrough also comes
# out normalised — the author's rebuild heals it for every reviewer.
#
# An external source goes through exactly the same normalisation, and needs it
# more: an agent writing from PowerShell produces both a BOM and CRLF endings,
# and without this the drift check would name the same file on both sides.
if [ "$from_given" -eq 1 ]; then
	if [ "$from_src" = "-" ]; then
		# Builtin and POSIX, so no process of its own. Without it, a --from -
		# typed by hand at a prompt simply hangs with no output, which reads as
		# the command having frozen.
		if [ -t 0 ]; then
			die "--from - reads the draft from standard input; redirect a file into it (git review walkthrough draft --build --from - $branch < order.md) or pass --from <file>"
		fi
		fromlabel="standard input"
		content="$(walk_normalize)"
	else
		# Readability is checked first so the message can name the file. A bare
		# redirection failure would report the shell's own wording, without it.
		if [ ! -r "$from_src" ] || [ -d "$from_src" ]; then
			die "could not read $from_src"
		fi
		fromlabel="$from_src"
		content="$(walk_normalize <"$from_src")"
	fi
	# Nothing to install is a mistake, not an empty reading order: an agent that
	# produced nothing, a redirect that captured nothing, a file that was never
	# written. Named by origin so the caller knows which end to look at.
	case "$content" in
	*[![:space:]]*) ;;
	*) die "$fromlabel is empty; a reading order needs at least one entry" ;;
	esac
else
	content="$(walk_normalize <"$targetpath")"
fi

# Skeleton placeholders must all be filled: an unnumbered "## ?." entry or a
# leftover "<!-- why" comment means the author did not finish. Both comment
# checks are anchored, and the heads-up one is confined to the preamble region
# where its placeholder lives: quoting a placeholder literal inside a why is
# ordinary prose (documenting the walkthrough format is a normal thing for a PR
# to do), not an unfilled entry, and must not be mistaken for one.
if printf '%s\n' "$content" | grep -q '^## ?\. '; then
	die "unfilled entries remain (## ?. ...); give each a number, then rebuild"
fi
if printf '%s\n' "$content" | grep -q '^<!-- why'; then
	die "unfilled why-comments remain (<!-- why ...); replace each with prose, then rebuild"
fi
preamble_raw="$(printf '%s\n' "$content" | awk '
	/^## / { line = $0; sub(/^## /, "", line); if (line ~ /^([0-9]+|\?)\. /) exit }
	{ print }
')"
if printf '%s\n' "$preamble_raw" | grep -q '^<!-- heads-up'; then
	die "the heads-up placeholder is still there; replace it with prose, or delete the whole ## Heads-up section if nothing in this PR is delicate, then rebuild"
fi

# The key marker is a bare "> key" — a flag, not a field. Spelling variants
# (">key", "> Key") are not errors: build recognises them and rewrites the marker
# canonically below, so a runtime reader only ever meets "> key" in a built
# walkthrough. What is an error is giving the flag a value.
key_re='^>[ \t]*[Kk][Ee][Yy][ \t]*$'

# Catch the natural mistake ("> key: reason") instead of silently reading it as
# why-prose, which would leave the entry unmarked and the reason duplicated. Kept
# as lenient about spelling as key_re, so no variant slips through unmarked.
if printf '%s\n' "$content" | grep -qE '^>[[:space:]]*[Kk][Ee][Yy][[:space:]]*:|^>[[:space:]]*[Kk][Ee][Yy][[:space:]]+[^[:space:]]'; then
	die "the > key marker takes no value; write it on a line of its own and put the reason in the why"
fi

# A heading that was plainly meant to be an entry but is not in the exact
# "## N. <path>" shape the readers parse — a stray second space, ")" for ".", a
# number with nothing after it. walk_parse ignores it by design (leniency at
# review time), so without this check it is simply not an entry and the drift
# comparison below blames the PR for a file that is sitting right there in the
# walkthrough. Deliberately narrow: it needs whitespace directly after exactly two
# hashes and then a number or "?", so "## Heads-up" and any deeper heading inside
# a why body ("### 2. ...") are left alone.
malformed="$(printf '%s\n' "$content" | awk '
	/^##[ \t]+([0-9]+|\?)[ \t]*[.)]/ && $0 !~ /^## ([0-9]+|\?)\. ./ { printf "%s: %s\n", NR, $0 }
')"
if [ -n "$malformed" ]; then
	die "entry heading(s) not in the '## N. <path>' form: $(printf '%s' "$malformed" | tr '\n' ';' | sed 's/;$//'); fix the heading(s), then rebuild"
fi

# Numbered entries, as order<TAB>path in file order.
entries="$(printf '%s\n' "$content" | walk_parse)"
# No entry heading at all: an empty file, or prose with nothing to read in order.
# (An unfilled "## ?." skeleton never reaches here — the unfilled check above owns
# that case.) The way back differs by side, and pointing the reviewer at init is
# pointing them at the author's flow, which writes .review/walkthrough.md into the
# working tree of whatever branch they are standing on: the one thing this verb
# exists to never do.
if [ -z "$entries" ]; then
	# With --from the file without entries is the SOURCE, and it is the only rule
	# below that has a file to name -- so it names the one that is actually wrong,
	# the way the "is empty" refusal above already does. Blaming $targetrel here
	# accused a stored draft that is intact (this refusal writes nothing), and the
	# way out it offered -- rewrite that skeleton with --force -- would have
	# destroyed the one file the failure never touched.
	if [ "$from_given" -eq 1 ]; then
		die "no entries found in $fromlabel; a reading order needs at least one '## N. <path>' entry"
	fi
	if [ "$sub" = draft ]; then
		die "no entries found in $targetrel; write the skeleton again with git review walkthrough draft --force$draftflags $branch, then fill it in"
	fi
	die "no entries found; run git review walkthrough init and fill it in"
fi

# No path may appear twice.
dups="$(printf '%s\n' "$entries" | cut -f2- | LC_ALL=C sort | uniq -d)"
[ -z "$dups" ] || die "duplicate paths in walkthrough: $(printf '%s' "$dups" | tr '\n' ' ')"

# Drift: the walkthrough's path set must match the PR's changed set exactly. Both
# sides are sorted into temp files for comm (process substitution is a bashism).
gd="$(git rev-parse --git-dir)"
rf="$gd/walkthrough-range.$$"
ef="$gd/walkthrough-entries.$$"
pf="$gd/walkthrough-pr-range.$$"
# $tmp is written further down and is deliberately in this trap from here. Unlike
# the skeleton's, no guard dies between its write and its mv — every rule has
# already run by then — but a Ctrl-C or a failing write during the rewrite itself
# leaves it behind, and in the draft namespace nothing ever collects it:
# walk_draft_list only matches *.md, clean is hands-off in there, and
# forget --draft only knows names it can spell. Cheap here, and there is no test
# that could pin it without faking a signal, which is the other reason to make the
# trap own it rather than a cleanup line the next edit can walk past. Guarded with
# ${tmp:-} because the trap outlives the paths where it is never set, and an unset
# expansion under set -u would turn any exit into a failure inside the handler.
trap 'rm -f "$rf" "$ef" "$pf" "${tmp:-}"' EXIT
# See the skeleton's traps: the handler has to exit, or the shell carries on from
# where the signal hit. Here that was worse than a no-op — the removal above left
# the comm below reading two files that no longer exist, so a Ctrl-C aborted after
# all with an error from comm about a missing path.
trap 'exit 130' INT
trap 'exit 143' TERM
annotatable_files | LC_ALL=C sort >"$rf"
printf '%s\n' "$entries" | cut -f2- | LC_ALL=C sort >"$ef"
missing="$(comm -23 "$rf" "$ef")"
# Missing is measured against the range in force -- an order that does not cover
# what this run writes about is incomplete, and that is unchanged. Extra is
# measured against the PR, which is wider only under --delta: an entry for a file
# the PR changes in a commit you already read is not drift, it is the rest of your
# reading order, and rejecting it made a full draft unbuildable the moment you
# pointed --delta at it. Skipped entirely when the two bounds are the same object,
# which is every path but that one.
if [ "$pr_lower" = "$lower" ]; then
	extra="$(comm -13 "$rf" "$ef")"
else
	pr_annotatable_files | LC_ALL=C sort >"$pf"
	extra="$(comm -13 "$pf" "$ef")"
fi
if [ -n "$missing" ] || [ -n "$extra" ]; then
	[ -n "$missing" ] &&
		echo "error: changed in the PR but missing from the walkthrough: $(printf '%s' "$missing" | tr '\n' ' ')" >&2
	[ -n "$extra" ] &&
		echo "error: in the walkthrough but not changed in the PR: $(printf '%s' "$extra" | tr '\n' ' ')" >&2
	warn_dirty
	exit 1
fi

# ── Anchors: whys written against a version of the file that no longer exists ──
#
# The drift check above compares the SET of paths and nothing else, which is why
# a PR that keeps changing the files it already annotates passes it in green with
# prose describing the first draft of each one. The anchor closes that: build
# stamps "> at: <blob>" under every entry, so the next build can tell an entry
# whose file has moved on from one whose file has not.
#
# A reserved marker line at the top of the body, beside "> key" — the shape the
# format reserved for exactly this (walk_why and walk_draft_progress have
# filtered "> at: " out since v2, so no reader has to learn about it) and the only
# shape that survives the round trip through an agent: the whole file goes out and
# comes back, and an anchor inside the entry comes back with it. In the
# instruction block it would be regenerated on arrival, and every entry would look
# freshly written.
#
# git cat-file --batch-check, not one rev-parse per entry: one process for the
# whole walkthrough, and the query goes in on standard input so a 300-entry PR
# cannot overflow argv (the same reason the range block never passes a path list).
# Its answers come back one line per query, in order, which is what pairs them
# back up with the paths.
anchor_paths="$(printf '%s\n' "$entries" | cut -f2-)"
anchor_map="$({
	printf '%s\n' "$anchor_paths"
	printf '\t\n'
	printf '%s\n' "$anchor_paths" | awk -v t="$tip:" 'NF { print t $0 }' |
		git cat-file --batch-check 2>/dev/null || true
} | awk '
	phase == 0 {
		if ($0 == "\t") { phase = 1; next }
		if ($0 != "") { np++; p[np] = $0 }
		next
	}
	{ no++; o[no] = ($NF == "missing" ? "-" : $1) }
	END {
		# Pairing is positional, so a short or absent answer set is not something
		# to guess around: emit nothing and let every anchor check downstream see
		# no anchors at all. A missing capability degrades the note, never the
		# build — the same rule fold_lower follows for git without merge-tree.
		if (no != np) exit 0
		for (i = 1; i <= np; i++) printf "%s\t%s\n", o[i], p[i]
	}
')"

# Entries whose stored anchor disagrees with the file as it stands now. Reported,
# never fatal: touching a file without rewriting its why is often right (a rename,
# an import, a formatting pass), and a build that goes red over it is a check
# people learn to switch off. "-" is a path the PR deletes — it has no blob, so an
# entry anchored to one it used to have counts as changed like any other.
stale_whys="$({
	printf '%s\n' "$anchor_map"
	printf '\t\n'
	printf '%s\n' "$content"
} | awk '
	phase == 0 {
		if ($0 == "\t") { phase = 1; next }
		if ($0 != "") {
			i = index($0, "\t")
			now[substr($0, i + 1)] = substr($0, 1, i - 1)
		}
		next
	}
	/^## / {
		line = substr($0, 4)
		if (sub(/^[0-9]+\. /, "", line) || sub(/^\?\. /, "", line)) {
			sub(/[ \t]+$/, "", line)
			cur = line
		} else {
			cur = ""
		}
		next
	}
	cur != "" && index($0, "> at: ") == 1 {
		a = substr($0, 7)
		sub(/^[ \t]+/, "", a)
		sub(/[ \t]+$/, "", a)
		if (a != "" && (cur in now) && now[cur] != a) print cur
		next
	}
')"
if [ -n "$stale_whys" ]; then
	{
		echo "note: $(printf '%s\n' "$stale_whys" | grep -c .) why/whys were written against an older version of their file:"
		printf '%s\n' "$stale_whys" | sed 's/^/        /'
		echo "      Reread those and rewrite the ones that no longer describe the file."
	} >&2
fi

count="$(printf '%s\n' "$entries" | grep -c .)"

# Entries carrying the "> key" marker, counted over the whole file in one pass.
keys="$(printf '%s\n' "$content" | awk -v key_re="$key_re" '
	/^## / { entry = ($0 ~ /^## ([0-9]+|\?)\. /); counted = 0; next }
	entry && !counted && $0 ~ key_re { n++; counted = 1 }
	END { print n + 0 }
')"
keysuffix=""
if [ "$keys" -ge 1 ]; then
	keysuffix=" ($keys key)"
fi

# Selectivity is the whole point of the marker, but it is a judgement call, not a
# rule: note it and carry on, never fail a build (and never a review) over it.
# The floor for the "none marked" note is deliberately high — on a small PR every
# file is worth reading, so there is nothing to single out.
if [ "$keys" -eq "$count" ] && [ "$count" -gt 1 ]; then
	echo "note: every entry is marked > key; the marker only helps a reviewer while it stays selective" >&2
elif [ "$keys" -eq 0 ] && [ "$count" -ge 6 ]; then
	echo "note: no entry is marked > key; consider marking the few files that carry the change" >&2
fi

if [ "$check" -eq 1 ]; then
	echo "walkthrough ok: $count $(entry_noun "$count")$keysuffix, in sync with the PR"
	warn_dirty
	exit 0
fi

# Rewrite canonically: the heading, the author's preamble (the ## Heads-up
# section — anything before the first entry, minus the skeleton's instruction
# comments), then the entries ordered by the author's number and renumbered 1..N.
# Each entry's why body is preserved, with its "> key" marker normalised, hoisted
# to the top and its blank lines trimmed so the output is deterministic —
# byte-for-byte stable across the author's spacing habits. Written via a temp file (the sed_i
# pattern) so a failure never leaves a half-written walkthrough.
#
# The instruction block is REGENERATED here, from the tip and lower bound this
# very run resolved for the drift check above — never carried over from the
# incoming file. A carried block outlives the range it describes: drift only
# fires when the set of paths changed, so commits landing on the same files leave
# a block saying "the range is X" inside a file validated against Y, and nothing
# says so. Regenerating is also less code than extracting and re-injecting.
# walk_prompt_block swallows the incoming one so it cannot be duplicated; the
# preamble never sees it either way, since walk_preamble drops every comment.
# Nothing is emitted under --check, which returned above: --check does not write.
preamble="$(printf '%s\n' "$content" | walk_prompt_block | walk_preamble)"
sorted_paths="$(printf '%s\n' "$entries" | LC_ALL=C sort -k1,1n | cut -f2-)"
lower_kind="$(git cat-file -t "$lower" 2>/dev/null || echo unknown)"
if [ "$sub" != draft ]; then
	situation="init"
	tiplabel="HEAD"
elif [ "$head_in_review" -eq 1 ]; then
	situation="review"
	tiplabel="$srclabel"
else
	situation="base"
	tiplabel="$srclabel"
fi
# The three things this step used to be able to take for granted, because until
# --from arrived the file it rewrites always already existed. With --from it may
# not: the namespace directory can be missing, a branch name holding '/' is a
# subdirectory of it, and a branch called "nul" is not a legal file name on
# Windows. The traps are already installed above (they own ${tmp:-} too), so a
# Ctrl-C between here and the mv cannot leave a .tmp.NNN nothing collects.
mkdir -p "$(dirname "$targetpath")"
tmp="$targetpath.tmp.$$"
# Fail on the file, not on the redirect — same message the skeleton path gives,
# for the same reason: a bare redirection error names a path and no cause.
if ! : >"$tmp" 2>/dev/null; then
	die "could not write $targetrel; the branch name may not be usable as a file name on this system"
fi
{
	printf '# Walkthrough\n\n'
	walk_emit_prompt_block "$tip" "$lower" "$tiplabel" "$lower_kind" \
		"$situation" "$genflags" "$deltabranch"
	printf '\n'
	if [ -n "$preamble" ]; then
		printf '%s\n\n' "$preamble"
	fi
	# ONE awk for every entry, not one walk_body plus one awk per entry: that loop
	# cost three processes per entry, and under Git Bash on Windows — where fork()
	# is emulated — a 200-entry walkthrough spent ~15s here (the same fault fixed
	# in git-review-lib.sh's walk_entry_fields; this was its last instance).
	#
	# Same two-stream, paths-first, lone-tab-sentinel shape as walk_entry_fields,
	# and for the same reason: a path can never be a bare tab (git quotes control
	# characters), while a why body is arbitrary prose that may well contain a
	# tab-only line, so feeding the content first could end the path phase early.
	# Bodies are accumulated per path and emitted in the caller's order, which is
	# what renumbers them 1..N; a path cannot repeat here, the duplicate check
	# above already rejected that.
	{
		printf '%s\n' "$sorted_paths"
		printf '\t\n'
		printf '%s\n' "$anchor_map"
		printf '\t\n'
		printf '%s\n' "$content"
	} | awk -v key_re="$key_re" '
		# Phase 1: the paths in the author-ordered sequence, up to the sentinel.
		phase == 0 {
			if ($0 == "\t") { phase = 1; next }
			if ($0 != "") { n++; order[n] = $0 }
			next
		}
		# Phase 2: the anchor for each path as the tip has it now, up to the
		# second sentinel. Absent for a path the PR deletes, and absent for all of
		# them when the pairing upstream could not be trusted — in both cases the
		# entry comes out with no anchor line, which is what an unanchored entry
		# has always looked like.
		phase == 1 {
			if ($0 == "\t") { phase = 2; next }
			if ($0 != "") {
				i = index($0, "\t")
				o = substr($0, 1, i - 1)
				if (o != "-") at[substr($0, i + 1)] = o
			}
			next
		}
		# Phase 3: the walkthrough, split into bodies. Headers are recognised
		# exactly as walk_body did it, since that is what this replaced.
		/^## / {
			line = substr($0, 4)
			if (sub(/^[0-9]+\. /, "", line) || sub(/^\?\. /, "", line)) {
				sub(/[ \t]+$/, "", line)
				cur = line
			} else {
				cur = ""
			}
			next
		}
		cur != "" && $0 ~ key_re { key[cur] = 1; next }
		# The incoming anchor is dropped rather than kept as body text: it was
		# already read (the stale note above is what it exists for) and the line
		# emitted below is the current one. Without this an entry would collect
		# one anchor line per build, and the runtime filter would hide the pile.
		cur != "" && index($0, "> at: ") == 1 { next }
		cur != "" { cnt[cur]++; body[cur, cnt[cur]] = $0 }
		END {
			for (i = 1; i <= n; i++) {
				p = order[i]
				printf "## %s. %s\n", i, p
				# Blank-line trim runs after the key lines are dropped, as
				# before: the marker is hoisted, never left padding the body.
				c = cnt[p] + 0
				s = 1; while (s <= c && body[p, s] ~ /^[ \t]*$/) s++
				e = c; while (e >= s && body[p, e] ~ /^[ \t]*$/) e--
				if (p in key) print "> key"
				if (p in at) printf "> at: %s\n", at[p]
				for (k = s; k <= e; k++) print body[p, k]
				printf "\n"
			}
		}
	'
} >"$tmp"
mv "$tmp" "$targetpath"

if [ "$sub" = draft ]; then
	echo "built $targetrel: $count $(entry_noun "$count")$keysuffix, ordered and renumbered; git review start$draftflags $branch now reads it"
else
	echo "built $targetrel: $count $(entry_noun "$count")$keysuffix, ordered and renumbered"
fi
warn_dirty
# build names the guides too, and not as decoration: the rule a guide most
# often carries is "mark few entries key", and the note that fires when every
# entry is marked is this verb's. Naming the file only at init/draft left the
# one step that could hold the walkthrough to its conventions silent about them.
emit_guide_note
