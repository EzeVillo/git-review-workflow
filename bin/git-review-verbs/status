#!/usr/bin/env sh
#
# git review status — show the state of the review on the current branch.
#
set -eu

prog="git review status"

usage() {
	cat <<EOF
usage: $prog [--porcelain | --why <path>]

Show the state of the review on the current review/* branch: source PR, mode,
and (in commit-by-commit mode) which commit you are on and which steps have
banked edits.

  --porcelain     machine-readable output, stable across git-review versions
                  (see the README for the format); exit codes 0/1/2/3
  --why <path>    print only the walkthrough's explanatory text for <path>,
                  nothing else (walk mode only)
EOF
}

porcelain=0
why=""
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--porcelain)
		if [ -n "$why" ]; then
			echo "error: --porcelain and --why are mutually exclusive" >&2
			usage >&2
			exit 1
		fi
		porcelain=1
		;;
	--why)
		if [ "$porcelain" -eq 1 ]; then
			echo "error: --porcelain and --why are mutually exclusive" >&2
			usage >&2
			exit 1
		fi
		shift
		if [ $# -eq 0 ] || [ -z "$1" ]; then
			echo "error: --why requires a path" >&2
			usage >&2
			exit 1
		fi
		why="$1"
		;;
	*)
		echo "error: unexpected argument $1" >&2
		usage >&2
		exit 1
		;;
	esac
	shift
done

git rev-parse --git-dir >/dev/null 2>&1 || {
	echo "error: not a git repository" >&2
	exit 1
}

cur="$(git symbolic-ref --quiet --short HEAD || true)"
case "$cur" in
review/*) ;;
*)
	echo "not on a review/* branch (HEAD is ${cur:-detached})" >&2
	exit 2
	;;
esac

src="$(git config "branch.$cur.reviewsource" || true)"
tip="$(git config "branch.$cur.reviewtip" || true)"
mode="$(git config "branch.$cur.reviewmode" || echo whole)"
if [ -z "$src" ] || [ -z "$tip" ]; then
	if [ -z "$src" ]; then
		echo "error: missing review metadata; was $cur created with git review start? Switch away, then delete it with 'git branch -D $cur'." >&2
	else
		echo "error: missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'." >&2
	fi
	exit 1
fi

# Shared helpers, sourced from the libexec directory the dispatcher points us at.
# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

if [ -n "$why" ]; then
	if [ "$mode" != "walk" ]; then
		echo "error: --why only applies to a review with a walkthrough (mode is $mode)" >&2
		exit 1
	fi
	load_walk_review_meta
	if ! printf '%s\n' "$walkpaths" | grep -Fxq "$why"; then
		echo "error: $why is not in the current walkthrough sequence" >&2
		exit 1
	fi
	walk_why "$tip" "$why"
	exit 0
fi

if [ "$porcelain" -eq 1 ]; then
	tab="$(printf '\t')"
	case "$mode" in
	step)
		load_step_review_meta
		load_step_texts
		nl="$(printf '\nx')"
		nl="${nl%x}"
		# The two lists the entry records need, each in ONE process instead of one
		# per position — the same "constant number of processes" rule the subject
		# and author records already follow (research.md Decisión 2). The naive
		# loop cost four processes per commit (a printf subshell, a sed to index,
		# a git rev-parse --short and a git rev-parse --verify), and under Git
		# Bash on Windows, where fork() is emulated, that was ~9s of a ~9s
		# 50-commit status.
		#
		# Same traversal flags as `commits` in load_step_review_meta, so the n-th
		# line is the n-th commit; and the trailing newline is kept with the
		# `printf x` / ${var%x} idiom for the same reason load_step_texts keeps
		# it — command substitution would strip it and the streamed list has to
		# hold exactly $total lines.
		#
		# --abbrev-commit is left WITHOUT an explicit --abbrev=<n>: both it and
		# git rev-parse --short abbreviate through the same default (core.abbrev
		# and git's uniqueness rule), so the bytes are identical to what the
		# per-commit rev-parse produced. Pinning a length here would silently
		# diverge from --short in any repo that sets core.abbrev.
		shorts="$(git rev-list --abbrev-commit --reverse --first-parent --no-merges "$start..$tip"; printf x)"
		shorts="${shorts%x}"
		# Every banked ref at once, wrapped in newlines so a membership test can
		# match a whole line: without the trailing newline in the pattern, step 1
		# would match refs/review-edits/<src>/10 and report edits it does not have.
		banked_refs="$nl$(git for-each-ref --format='%(refname)' "refs/review-edits/$src/")$nl"
		pcurrent="$(printf '%s' "$shorts" | sed -n "${step}p")"
		porcelain_row state "$cur" "$src" "$tip" step none "$step" "$total" "$count" "$pcurrent"
		printf '%s' "$shorts" | { i=1; while IFS= read -r ish; do
			banked=0
			case "$banked_refs" in
			*"${nl}refs/review-edits/$src/$i$nl"*) banked=1 ;;
			esac
			porcelain_row entry "$i" "$ish" "$banked"
			i=$((i + 1))
		done; }
		# Free text goes in its own record, last field, one per record: a subject
		# and an author name can both contain a literal tab (see the free-text
		# rule in contracts/status-porcelain.md), and only the last field of a
		# line survives that without shifting anything.
		#
		# Each list is streamed in ONE pass rather than indexed with sed line by
		# line. porcelain_row is a shell function, so a pass costs one subshell
		# instead of two processes per position; indexing cost 2N processes, and
		# under Git Bash on Windows — where fork() is emulated — that alone
		# added ~75% to a 50-commit status (FR-014/SC-008, measured). The line
		# count is exactly $total because load_step_texts keeps the trailing
		# newline, so an empty subject still gets its own record with an empty
		# field instead of vanishing.
		printf '%s' "$subjects" | { i=1; while IFS= read -r text; do
			porcelain_row subject "$i" "$text"
			i=$((i + 1))
		done; }
		printf '%s' "$authors" | { i=1; while IFS= read -r text; do
			porcelain_row author "$i" "$text"
			i=$((i + 1))
		done; }
		;;
	walk)
		load_walk_review_meta
		pcurrent="$(printf '%s\n' "$walkpaths" | sed -n "${walkstep}p")"
		essential=0
		if walk_is_key "$tip" "$pcurrent"; then
			essential=1
		fi
		porcelain_row state "$cur" "$src" "$tip" walk applied "$walkstep" "$total" "$walkcount" "$pcurrent" "$essential"
		printf '%s\n' "$walkpaths" | walk_entry_fields "$tip" | while IFS="$tab" read -r epos epath eess eann; do
			porcelain_row entry "$epos" "$epath" "$eess" "$eann"
		done
		;;
	*)
		pwalkthrough=none
		if walk_read "$tip" >/dev/null; then
			pwalkpaths="$(walk_sequence "$tip" "$(git rev-parse HEAD)")"
			if [ -n "$pwalkpaths" ]; then
				pwalkthrough=applied
			else
				pwalkthrough=degraded
			fi
		fi
		porcelain_row state "$cur" "$src" "$tip" "$mode" "$pwalkthrough"
		# Whole mode's inventory: one entry per file the range touches, in git's
		# own order. No essential/annotated/banked fields — whole has no
		# walkthrough and no bank — and no cursor on `state` above: this is a
		# listing, not a sequence (FR-002, FR-004).
		i=1
		range_files "$tip" "$(git rev-parse HEAD)" | while IFS= read -r pfile; do
			[ -n "$pfile" ] || continue
			porcelain_row entry "$i" "$pfile"
			i=$((i + 1))
		done
		# The base is what a review without a walkthrough has instead of a
		# reading order: the ref its range was built against. Read with || true
		# like the human path does — a key deleted by hand must not abort the
		# script under set -eu. Omitted entirely when there is none: omit, never
		# blank, never a sentinel. It goes after `state`, which the contract
		# keeps as the first line.
		pbase="$(git config "branch.$cur.reviewbase" || true)"
		if [ -n "$pbase" ]; then
			porcelain_row base "$pbase"
		fi
		;;
	esac
	# finish (contracts/finish-state.md): the ONLY closure state status can see
	# is a stopped-mid-conflict one — a completed finish already moved HEAD off
	# review/* (list --porcelain reports that one instead). Position relative
	# to the records above is not significant, so this runs once after the mode
	# case rather than duplicated inside each branch.
	pundohead="$(git config "branch.$cur.reviewundohead" || true)"
	if [ -n "$pundohead" ]; then
		presume="$(git config "branch.$cur.reviewresume" || true)"
		if [ "$presume" = "conflict" ]; then
			pkind="$(git config "branch.$cur.reviewundokind" || true)"
			ponto=0
			[ "$pkind" = "onto-source" ] && ponto=1
			porcelain_row finish conflict "$ponto"
		fi
	fi
	# compare (git review compare): reviewreadonly=1 means finish will refuse.
	# Separate record, omitted when not set — additive, same pattern as base/finish.
	if [ "$(git config "branch.$cur.reviewreadonly" || true)" = "1" ]; then
		porcelain_row readonly
	fi
	# keys-only walk submode (start/compare --keys): presence record, like readonly.
	if [ "$(git config "branch.$cur.reviewwalkkeys" || true)" = "1" ]; then
		porcelain_row keys
	fi
	exit 0
fi

printf 'review of %s (tip %s)\n' "$src" "$(git rev-parse --short "$tip")"
printf '  branch  %s\n' "$cur"
# Not named "readonly": that is a shell special builtin and would break assignment.
is_readonly="$(git config "branch.$cur.reviewreadonly" || true)"
if [ "$is_readonly" = "1" ]; then
	printf '  note    read-only compare — git review finish will refuse; abort or clean when done\n'
fi

if [ "$mode" = "step" ]; then
	count="$(git config "branch.$cur.reviewcount" || true)"
	step="$(git config "branch.$cur.reviewstep" || true)"
	start="$(git config "branch.$cur.reviewstart" || true)"
	# A key deleted by a hand-edit (while reviewmode stays "step") would otherwise
	# let set -e kill the bare read silently mid-script; read with || true and report
	# it. reviewstep falls through to the numeric guard below for a precise message.
	if [ -z "$count" ] || [ -z "$start" ]; then
		echo "error: missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'." >&2
		exit 1
	fi
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"
	# Guard against a step that maps to no commit (corrupt config, hand-edited
	# metadata): otherwise cnow ends up empty and git rev-parse '' crashes while
	# the printf around it still "succeeds", printing a corrupt status line.
	total="$(printf '%s\n' "$commits" | grep -c .)"
	case "$step" in
	'' | *[!0-9]*)
		echo "error: corrupt review metadata: reviewstep is '$step', not a positive integer. Discard the review with 'git review abort'." >&2
		exit 1
		;;
	esac
	if [ "$step" -lt 1 ] || [ "$step" -gt "$total" ]; then
		echo "error: review step $step out of range (1..$total) — corrupt metadata? Discard the review with 'git review abort'." >&2
		exit 1
	fi
	cnow="$(printf '%s\n' "$commits" | sed -n "${step}p")"
	printf '  mode    step  [%s/%s] on %s %s\n' "$step" "$count" \
		"$(git rev-parse --short "$cnow")" "$(git log -1 --format='%s' "$cnow")"

	# Every banked ref in ONE process instead of a git rev-parse --verify per
	# position — the same technique the --porcelain branch above uses, for the
	# same reason: under Git Bash on Windows, where fork() is emulated, the N
	# rev-parse calls were almost all of a ~3.5s 50-commit status. The refs come
	# back one per line and the membership test is a plain shell `case` over the
	# list wrapped in newlines; the trailing newline in the pattern is what keeps
	# step 1 from matching refs/review-edits/<src>/10.
	nl="$(printf '\nx')"
	nl="${nl%x}"
	banked_refs="$nl$(git for-each-ref --format='%(refname)' "refs/review-edits/$src/")$nl"
	banked=""
	i=1
	while [ "$i" -le "$count" ]; do
		case "$banked_refs" in
		*"${nl}refs/review-edits/$src/$i$nl"*) banked="$banked $i" ;;
		esac
		i=$((i + 1))
	done
	printf '  banked  %s\n' "${banked:- none}"

	hint="git review next"
	[ "$step" -gt 1 ] && hint="$hint / git review prev"
	if [ "$is_readonly" = "1" ]; then
		printf '  next    read, then %s  (read-only compare; finish refuses)\n' "$hint"
	else
		printf '  next    edit, then %s  (git review finish when done)\n' "$hint"
	fi
elif [ "$mode" = "walk" ]; then
	# Re-derive the reading sequence to report the live [k/N] and current path, the
	# same way the walk commands do (including keys-only when reviewwalkkeys=1).
	walkstep="$(git config "branch.$cur.reviewwalkstep" || true)"
	walkcount="$(git config "branch.$cur.reviewwalkcount" || true)"
	if [ "$(git config "branch.$cur.reviewwalkkeys" || true)" = "1" ]; then
		walkpaths="$(walk_keys_order "$tip" "$(git rev-parse HEAD)")"
		keys_only_note="  (keys-only)"
	else
		walkpaths="$(walk_reading_order "$tip" "$(git rev-parse HEAD)")"
		keys_only_note=""
	fi
	total="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
	case "$walkstep" in
	'' | *[!0-9]*)
		echo "error: corrupt review metadata: reviewwalkstep is '$walkstep', not a positive integer. Discard the review with 'git review abort'." >&2
		exit 1
		;;
	esac
	if [ "$walkstep" -lt 1 ] || [ "$walkstep" -gt "$total" ]; then
		walk_range_error "$walkstep" "$total" "$walkcount"
	fi
	pnow="$(printf '%s\n' "$walkpaths" | sed -n "${walkstep}p")"
	mark=""
	if walk_is_annotated "$tip" "$pnow"; then
		if walk_is_key "$tip" "$pnow"; then
			mark="  (key)"
		fi
	else
		mark="  (uncovered)"
	fi
	printf '  mode    walk  [%s/%s] on %s%s%s\n' "$walkstep" "$total" "$pnow" "$mark" "$keys_only_note"
	hint="git review next"
	[ "$walkstep" -gt 1 ] && hint="$hint / git review prev"
	if [ "$is_readonly" = "1" ]; then
		printf '  next    read, then %s  (read-only compare; finish refuses)\n' "$hint"
	else
		printf '  next    read, then %s  (git review finish when done)\n' "$hint"
	fi
else
	base="$(git config "branch.$cur.reviewbase" || true)"
	printf '  mode    whole%s\n' "${base:+  (base $base)}"
	# The files the range touches (FR-001): a whole review has no cursor, so this
	# is a plain listing, not a "[k/N]" line — never omitted, and never a blank
	# section standing in for zero files (FR-007, the git-status precedent).
	files="$(range_files "$tip" "$(git rev-parse HEAD)")"
	filecount="$(printf '%s\n' "$files" | grep -c . || true)"
	if [ "$filecount" -eq 0 ]; then
		printf '  files   no files in this range\n'
	else
		printf '  files   %s\n' "$filecount"
		i=1
		printf '%s\n' "$files" | while IFS= read -r f; do
			printf '    %s  %s\n' "$i" "$f"
			i=$((i + 1))
		done
	fi
	if [ "$is_readonly" = "1" ]; then
		printf '  next    read (read-only compare; finish refuses)\n'
	else
		printf '  next    edit, then git review finish\n'
	fi
fi
