{
  "name": "git-review-workflow",
  "displayName": "git review workflow",
  "description": "Review a git-review-workflow pull request as a native walkthrough panel",
  "version": "0.1.2",
  "publisher": "EzeVillo",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EzeVillo/git-review-workflow.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/EzeVillo/git-review-workflow/issues"
  },
  "homepage": "https://github.com/EzeVillo/git-review-workflow/tree/main/vscode-extension#readme",
  "keywords": [
    "git",
    "review",
    "pull-request",
    "code-review",
    "walkthrough",
    "scm"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:gitReview.walkthrough"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitReview",
          "title": "git review",
          "icon": "media/activity-bar.png"
        }
      ]
    },
    "views": {
      "gitReview": [
        {
          "id": "gitReview.walkthrough",
          "name": "Walkthrough",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gitReview.openEntry",
        "title": "Open Entry",
        "category": "git review"
      },
      {
        "command": "gitReview.openChange",
        "title": "Open Changes",
        "category": "git review",
        "icon": "$(diff)"
      },
      {
        "command": "gitReview.openAllChanges",
        "title": "Open All Changes",
        "category": "git review",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitReview.showWhy",
        "title": "Show Why",
        "category": "git review",
        "icon": "$(comment)"
      },
      {
        "command": "gitReview.next",
        "title": "Next Entry",
        "category": "git review",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitReview.prev",
        "title": "Previous Entry",
        "category": "git review",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitReview.goToEntry",
        "title": "Go to Entry",
        "category": "git review",
        "icon": "$(list-ordered)"
      },
      {
        "command": "gitReview.refresh",
        "title": "Refresh",
        "category": "git review",
        "icon": "$(refresh)"
      },
      {
        "command": "gitReview.installCli",
        "title": "How to Install the CLI",
        "category": "git review"
      },
      {
        "command": "gitReview.continueReview",
        "title": "Continue Saved Review",
        "category": "git review"
      },
      {
        "command": "gitReview.startReview",
        "title": "Start a Review",
        "category": "git review"
      },
      {
        "command": "gitReview.setBase",
        "title": "Set the Base Branch",
        "category": "git review"
      },
      {
        "command": "gitReview.setRemote",
        "title": "Set the Remote",
        "category": "git review"
      },
      {
        "command": "gitReview.abortReview",
        "title": "Cancel Review",
        "category": "git review",
        "icon": "$(discard)"
      },
      {
        "command": "gitReview.saveReview",
        "title": "Save Review for Later",
        "category": "git review",
        "icon": "$(history)"
      },
      {
        "command": "gitReview.finishReview",
        "title": "Finish Review",
        "category": "git review",
        "icon": "$(check)"
      },
      {
        "command": "gitReview.undoFinish",
        "title": "Undo Finish",
        "category": "git review",
        "icon": "$(discard)"
      },
      {
        "command": "gitReview.resumeFinish",
        "title": "Resume Finish",
        "category": "git review",
        "icon": "$(debug-continue)"
      },
      {
        "command": "gitReview.discardInventory",
        "title": "Discard Inventory Review",
        "category": "git review"
      },
      {
        "command": "gitReview.cleanReview",
        "title": "Clean",
        "category": "git review"
      },
      {
        "command": "gitReview.forgetReview",
        "title": "Forget Saved Review or Delta Marker",
        "category": "git review"
      },
      {
        "command": "gitReview.previewEdits",
        "title": "Preview Edits",
        "category": "git review",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitReview.previewEditsStat",
        "title": "Preview Edits (stat)",
        "category": "git review"
      },
      {
        "command": "gitReview.compareReview",
        "title": "Compare Revisions",
        "category": "git review"
      },
      {
        "command": "gitReview.walkthroughInit",
        "title": "Walkthrough: Init",
        "category": "git review"
      },
      {
        "command": "gitReview.walkthroughBuild",
        "title": "Walkthrough: Build",
        "category": "git review"
      },
      {
        "command": "gitReview.showCliLog",
        "title": "Show CLI Log",
        "category": "git review"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitReview.refresh",
          "when": "view == gitReview.walkthrough",
          "group": "navigation@1"
        },
        {
          "command": "gitReview.finishReview",
          "when": "view == gitReview.walkthrough && gitReview.situation == review && !gitReview.readonly && !gitReview.busy",
          "group": "navigation@2"
        },
        {
          "command": "gitReview.saveReview",
          "when": "view == gitReview.walkthrough && gitReview.situation == review && !gitReview.busy",
          "group": "navigation@3"
        },
        {
          "command": "gitReview.abortReview",
          "when": "view == gitReview.walkthrough && (gitReview.situation == review || gitReview.situation == finish-conflict) && !gitReview.busy",
          "group": "navigation@4"
        },
        {
          "command": "gitReview.previewEdits",
          "when": "view == gitReview.walkthrough && (gitReview.situation == review || gitReview.situation == finish-conflict) && !gitReview.busy",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "gitReview.openEntry",
          "when": "gitReview.situation == review || gitReview.situation == finish-conflict"
        },
        {
          "command": "gitReview.openChange",
          "when": "gitReview.situation == review || gitReview.situation == finish-conflict"
        },
        {
          "command": "gitReview.openAllChanges",
          "when": "(gitReview.situation == review || gitReview.situation == finish-conflict) && gitReview.mode == whole"
        },
        {
          "command": "gitReview.showWhy",
          "when": "gitReview.situation == review || gitReview.situation == finish-conflict"
        },
        {
          "command": "gitReview.next",
          "when": "gitReview.situation == review && !gitReview.busy"
        },
        {
          "command": "gitReview.prev",
          "when": "gitReview.situation == review && !gitReview.busy"
        },
        {
          "command": "gitReview.goToEntry",
          "when": "(gitReview.situation == review || gitReview.situation == finish-conflict) && !gitReview.busy"
        },
        {
          "command": "gitReview.installCli",
          "when": "gitReview.situation == cli-missing || gitReview.situation == cli-outdated"
        },
        {
          "command": "gitReview.continueReview",
          "when": "false"
        },
        {
          "command": "gitReview.startReview",
          "when": "(gitReview.situation == no-review || gitReview.situation == finish-pending) && !gitReview.busy"
        },
        {
          "command": "gitReview.setBase",
          "when": "!gitReview.busy"
        },
        {
          "command": "gitReview.setRemote",
          "when": "!gitReview.busy"
        },
        {
          "command": "gitReview.abortReview",
          "when": "(gitReview.situation == review || gitReview.situation == finish-conflict) && !gitReview.busy"
        },
        {
          "command": "gitReview.saveReview",
          "when": "gitReview.situation == review && !gitReview.busy"
        },
        {
          "command": "gitReview.finishReview",
          "when": "gitReview.situation == review && !gitReview.readonly && !gitReview.busy"
        },
        {
          "command": "gitReview.undoFinish",
          "when": "(gitReview.situation == finish-pending || gitReview.situation == finish-conflict) && !gitReview.busy"
        },
        {
          "command": "gitReview.resumeFinish",
          "when": "gitReview.situation == finish-conflict && !gitReview.busy"
        },
        {
          "command": "gitReview.discardInventory",
          "when": "false"
        },
        {
          "command": "gitReview.cleanReview",
          "when": "!gitReview.busy"
        },
        {
          "command": "gitReview.forgetReview",
          "when": "!gitReview.busy"
        },
        {
          "command": "gitReview.previewEdits",
          "when": "(gitReview.situation == review || gitReview.situation == finish-conflict) && !gitReview.busy"
        },
        {
          "command": "gitReview.previewEditsStat",
          "when": "(gitReview.situation == review || gitReview.situation == finish-conflict) && !gitReview.busy"
        },
        {
          "command": "gitReview.compareReview",
          "when": "!gitReview.busy"
        },
        {
          "command": "gitReview.walkthroughInit",
          "when": "!gitReview.busy"
        },
        {
          "command": "gitReview.walkthroughBuild",
          "when": "!gitReview.busy"
        },
        {
          "command": "gitReview.showCliLog"
        }
      ]
    },
    "configuration": {
      "title": "git review",
      "properties": {
        "gitReview.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git-review dispatcher when `git` does not discover it. Empty = invoke `git review`."
        },
        "gitReview.defaultSource": {
          "type": "string",
          "enum": [
            "remote",
            "local",
            "offline"
          ],
          "enumDescriptions": [
            "Fetch from the remote and review the remote tip of the branch.",
            "Review the local branch without fetching first; the base still resolves against the remote when needed.",
            "Review the local branch with no network access; the base is resolved locally."
          ],
          "default": "remote",
          "description": "Default origin for a new review. Only preselects the source step in the start wizard; the CLI still receives whatever the user confirms."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "preview": "node preview/run.js",
    "preview:watch": "node preview/run.js --watch",
    "package": "node esbuild.js --production && vsce package",
    "pretest": "npm run compile && tsc --noEmit -p .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --config test/unit/.mocharc.json",
    "pretest:integration": "npm run compile",
    "test:integration": "tsc -p . --outDir out && node ./out/test/integration/runTests.js"
  },
  "dependencies": {
    "cross-spawn": "^7.0.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "glob": "^10.3.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
