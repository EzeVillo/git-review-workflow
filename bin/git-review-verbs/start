#!/usr/bin/env sh
#
# git review start — stage a pull request diff on a review/<branch> branch.
#
# Two independent axes:
#   range  — where the review starts: the merge-base with the base branch
#            (default), your last review (--delta), or an explicit commit
#            (--from <commit>).
#   layout — how you see it: the whole range as one staged diff (default), or
#            one commit at a time (--step, advance with git review next).
#
set -eu

prog="git review start"

usage() {
	cat <<EOF
usage: $prog [<branch>] [<base> | --base <base> | --delta | --from <commit>] [--step | --no-walk | --keys] [--local | --offline]
       $prog --prepare [--local | --offline] [--base <base> | --delta | --from <commit>] -- <branch>
       $prog --release -- <token>

Stage a pull request diff on a review/<branch> branch for inline review.
With no <branch>, review the branch you currently have checked out.

  <branch>          branch to review; omit it to review the current branch
  <base>            commit-ish to diff against — a branch, tag or commit
                    (required for a full review; set a default with:
                    git config reviewworkflow.base <branch>)
  --base <base>     the base to diff against; use it to pass a base while
                    letting <branch> default to the current branch
  --delta           review only the commits added since your last review
  --from <commit>   review only the commits after <commit>
  --step            review one commit at a time; advance with git review next
  --no-walk         ignore any walkthrough on the PR; review the whole diff
  --keys            walk mode restricted to entries marked > key (requires a
                    walkthrough with at least one key in range; not with
                    --step or --no-walk)
  --local           review your local <branch>, not origin's copy; the base
                    is still fetched and resolved against origin
  --offline         like --local, but also skip fetching and resolve the base
                    from your local branches too
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

src=""
base=""
base_explicit=0
from=""
delta=0
step=0
no_walk=0
keys_only=0
local_mode=0
offline_mode=0
prepare=0
prepared=''
release=0
use_draft=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	-d | --delta) delta=1 ;;
	--step) step=1 ;;
	--no-walk) no_walk=1 ;;
	--keys) keys_only=1 ;;
	--local) local_mode=1 ;;
	--prepare) prepare=1 ;;
	--prepared=*) prepared=${1#--prepared=} ;;
	--release) release=1 ;;
	--from-draft) use_draft=1 ;;
	--offline)
		local_mode=1
		offline_mode=1
		;;
	--base)
		shift
		[ $# -gt 0 ] || die "--base requires a base"
		[ -n "$1" ] || die "--base requires a base"
		[ "$base_explicit" -eq 0 ] || die "base given more than once"
		base="$1"
		base_explicit=1
		;;
	--base=*)
		[ "$base_explicit" -eq 0 ] || die "base given more than once"
		base="${1#--base=}"
		[ -n "$base" ] || die "--base requires a base"
		base_explicit=1
		;;
	--from)
		shift
		[ $# -gt 0 ] || die "--from requires a commit"
		from="$1"
		[ -n "$from" ] || die "--from requires a commit"
		;;
	--from=*)
		from="${1#--from=}"
		[ -n "$from" ] || die "--from requires a commit"
		;;
	--)
		# End-of-options: a branch name starting with "-" is read as positional
		# after --, e.g. git review start -- --weird develop.
		shift
		while [ $# -gt 0 ]; do
			if [ -z "$src" ]; then
				src="$1"
			elif [ -z "$base" ]; then
				base="$1"
				base_explicit=1
			else
				die "unexpected argument $1"
			fi
			shift
		done
		break
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		if [ -z "$src" ]; then
			src="$1"
		elif [ -z "$base" ]; then
			base="$1"
			base_explicit=1
		else
			die "unexpected argument $1"
		fi
		;;
	esac
	shift
done

if [ "$delta" -eq 1 ] && [ -n "$from" ]; then
	die "use only one of --delta and --from"
fi

if [ "$base_explicit" -eq 1 ] && { [ "$delta" -eq 1 ] || [ -n "$from" ]; }; then
	die "base is ignored with --delta/--from; pass only one"
fi

if [ "$keys_only" -eq 1 ]; then
	if [ "$step" -eq 1 ]; then
		die "--keys cannot be combined with --step"
	fi
	if [ "$no_walk" -eq 1 ]; then
		die "--keys cannot be combined with --no-walk"
	fi
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

if [ "$release" -eq 1 ]; then
	if [ "$prepare$use_draft$delta$step$no_walk$keys_only$local_mode$offline_mode" != 00000000 ] || [ -n "$base$from$prepared" ]; then
		die '--release takes just a prepared review token'
	fi
	git update-ref -d "$(start_prepared_ref "$src")"
	exit
fi
if [ "$use_draft" -eq 1 ] && [ -n "$prepared" ]; then die 'choose --from-draft or --prepared'; fi
if [ "$prepare" -eq 1 ] && [ "$step$no_walk$keys_only" != 000 ]; then die '--prepare takes range options only'; fi
if [ "$offline_mode" -eq 1 ]; then
	GIT_NO_LAZY_FETCH=1
	export GIT_NO_LAZY_FETCH
fi

# With no <branch>, review the branch checked out — git's own default (push,
# status, log, rebase all do this). Only resolves the name; --local vs remote is
# still chosen by flags. Guards against review/*, review-saved/* and
# review-fixes/* so nobody reviews a review branch.
if [ -z "$src" ]; then
	cur="$(git symbolic-ref --quiet --short HEAD || true)"
	[ -n "$cur" ] || die "no branch given and HEAD is detached; name a branch to review"
	case "$cur" in
	review/* | review-saved/* | review-fixes/*) die "refusing to review a review branch (HEAD is $cur); name a branch to review" ;;
	esac
	src="$cur"
fi

# Remote to review from; defaults to origin, override with reviewworkflow.remote.
remote="$(git config reviewworkflow.remote || echo origin)"

# Remember where to return to when the review is aborted.
returnbranch="$(git symbolic-ref --quiet --short HEAD || true)"

if [ -z "$base" ]; then
	base="$(git config reviewworkflow.base || true)"
fi

if [ "$prepare" -eq 0 ]; then require_clean_work_tree; fi
case "$src" in
	review/*|review-saved/*|review-fixes/*) die "refusing to review a review branch ($src)" ;;
esac
git check-ref-format "refs/heads/$src" || die "invalid branch: $src"

# --local reviews your local <branch> directly; the default reviews the remote's.
# The base is a separate concern — the shared merge target — so it still resolves
# against origin (and origin is still fetched) under --local; only --offline, which
# implies --local, also takes the base from local branches and skips the network.
# The two axes stay apart everywhere, including the delta marker: local markers
# live in their own config section (reviewworkflowlocal.*), not a
# reviewworkflow.<src>.local.reviewed key, which would be ambiguous for a branch
# literally named "<src>.local".
if [ "$local_mode" -eq 1 ]; then
	srcref="refs/heads/$src"
	srclabel="$src"
	markerkey="reviewworkflowlocal.$src.reviewed"
else
	srcref=""
	srclabel="$remote/$src"
	markerkey="reviewworkflow.$src.reviewed"
fi

# Resolve the base into a ref and a human label. Try the branch namespace first
# (the remote's copy, or local with --offline) for the familiar origin/<base>
# label and the merged-base folding below; anything else still works as a
# read-only lower bound via any commit-ish (tag, SHA, full origin/<x>). baseref
# stays empty when the base does not resolve at all: fatal for a full review,
# a no-op for delta/from folding.
baseref=""
baselabel="$base"
_rs_identity=$(start_range_identity "$remote" "$src" "$base" "$from" "$delta$local_mode$offline_mode")
_rs_pack=''
_rs_prepared=0
_rs_tmp=''
_rs_remote_source=''
_rs_remote_base=''
_rs_remote_tag=''
_rs_base_label=local
_rs_cleanup() {
	if [ -n "$_rs_tmp" ]; then
		if [ -n "$_rs_remote_source" ]; then git update-ref -d "$_rs_tmp-tip" || true; fi
		if [ -n "$_rs_remote_base" ] && [ "$_rs_remote_base" != "$_rs_remote_source" ]; then
			git update-ref -d "$_rs_tmp-base" || true
		fi
		if [ "$_rs_prepared" -eq 0 ]; then git update-ref -d "$_rs_tmp" || true; fi
		if [ "${_rs_lease_started:-0}" -eq 1 ]; then git update-ref -d "$_rs_tmp-lease" || true; fi
	fi
}
if [ -n "$prepared" ] || [ "$use_draft" -eq 1 ]; then
	[ "$prepare" -eq 0 ] || die 'choose --prepare or --prepared'
	if [ "$use_draft" -eq 1 ]; then
		_rs_saved_range=$(start_draft_ref "$src")
		git show-ref --verify --quiet "$_rs_saved_range" || die 'prepared draft range is unavailable'
	else
		_rs_saved_range=$(start_prepared_ref "$prepared")
	fi
	if [ -n "$_rs_saved_range" ]; then
		start_read_range "$_rs_saved_range" "$_rs_identity"
		srcref=$_rs_tip
		baseref=$_rs_base
	fi
fi
if [ -z "${_rs_saved_range:-}" ]; then
	if [ "$offline_mode" -eq 0 ] || [ "$prepare" -eq 1 ]; then
		walk_gitdir_init
		_rs_nonce=$(mktemp "$_walk_gitdir/start.XXXXXX")
		_rs_token=$(printf '%s\n%s\n' "$_rs_nonce" "$$" | git hash-object --stdin)
		rm -f "$_rs_nonce"
		_rs_tmp=$(start_prepared_ref "$_rs_token")
		trap _rs_cleanup 0
		trap 'exit 130' INT
		trap 'exit 143' TERM
	fi
	if [ -n "$base" ]; then
		if [ "$offline_mode" -eq 1 ]; then
			baseref=$(git rev-parse --verify --quiet "refs/heads/$base^{commit}" || true)
		else
			_rs_base_branch=$base
			_rs_explicit_remote=0
			case "$base" in
			refs/tags/*) _rs_base_branch='' ;;
			"refs/remotes/$remote/"*) _rs_base_branch=${base#"refs/remotes/$remote/"}; _rs_explicit_remote=1 ;;
			"$remote/"*)
				if ! git show-ref --verify --quiet "refs/heads/$base"; then
					_rs_base_branch=${base#"$remote/"}
					_rs_explicit_remote=1
				fi ;;
			esac
			if git check-ref-format "refs/heads/$_rs_base_branch"; then
				_rs_remote_base=$(review_remote_branch "$remote" "$_rs_base_branch") || exit 1
			fi
		fi
		if [ -z "$baseref" ] && [ "${_rs_explicit_remote:-0}" -eq 0 ]; then
			baseref=$(git rev-parse --verify --quiet "$base^{commit}" || true)
			if [ -z "$baseref" ] && [ "$offline_mode" -eq 0 ]; then
				case "$base" in refs/tags/*) _rs_remote_tag=$base ;; *) _rs_remote_tag="refs/tags/$base" ;; esac
				if ! git check-ref-format "$_rs_remote_tag"; then _rs_remote_tag=''; fi
			fi
		fi
	fi
	if [ "$local_mode" -eq 0 ]; then
		_rs_remote_source=$(review_remote_branch "$remote" "$src") || exit 1
	fi
	if [ -z "$_rs_remote_base" ]; then
		_rs_remote_base=$_rs_remote_tag
		_rs_remote_tag=''
	fi
	if [ -n "$_rs_remote_source$_rs_remote_base" ]; then
		_rs_lease=$(compare_lease_commit 'Prepare start review' </dev/null)
		git update-ref "$_rs_tmp-lease" "$_rs_lease"
		_rs_lease_started=1
	fi
	set --
	if [ -n "$_rs_remote_source" ]; then
		set -- "$_rs_remote_source:$_rs_tmp-tip"
	fi
	if [ -n "$_rs_remote_base" ]; then
		if [ "$_rs_remote_base" = "$_rs_remote_source" ]; then
			_rs_base_label=remote
			baseref="$_rs_tmp-tip"
		else
			_rs_refspec="$_rs_remote_base:$_rs_tmp-base"
			_rs_output=''
			if ! _rs_output=$(review_fetch_isolated "$remote" "$@" "$_rs_refspec" 2>&1); then
				# The base can be a local branch or a literal revision. Only
				# fall back when the server confirms the first choice is absent.
				_rs_probe=0
				git ls-remote --exit-code --refs -- "$remote" "$_rs_remote_base" >/dev/null || _rs_probe=$?
				if [ "$_rs_probe" -eq 0 ] && [ -n "$_rs_remote_source" ]; then
					_rs_src_probe=0
					git ls-remote --exit-code --heads -- "$remote" "$_rs_remote_source" >/dev/null || _rs_src_probe=$?
					if [ "$_rs_src_probe" -eq 2 ]; then die "$srclabel not found"; fi
				fi
				if [ "$_rs_probe" -ne 2 ]; then printf '%s\n' "$_rs_output" >&2; die "could not update from $remote"; fi
				if [ -n "$_rs_remote_tag" ]; then
					_rs_probe=0
					git ls-remote --exit-code --tags --refs -- "$remote" "$_rs_remote_tag" >/dev/null || _rs_probe=$?
					case "$_rs_probe" in
					0) set -- "$@" "$_rs_remote_tag:$_rs_tmp-base"; baseref="$_rs_tmp-base" ;;
					2) ;;
					*) die "could not update from $remote" ;;
					esac
				fi
			else
				set --
				baseref="$_rs_tmp-base"
				case "$_rs_remote_base" in refs/heads/*) _rs_base_label=remote ;; esac
			fi
		fi
	fi
	if [ "$#" -gt 0 ]; then
		_rs_output=''
		if ! _rs_output=$(review_fetch_isolated "$remote" "$@" 2>&1); then
			if [ -n "$_rs_remote_source" ]; then
				_rs_probe=0
				git ls-remote --exit-code --heads -- "$remote" "$_rs_remote_source" >/dev/null || _rs_probe=$?
				if [ "$_rs_probe" -eq 2 ]; then die "$srclabel not found"; fi
			fi
			printf '%s\n' "$_rs_output" >&2
			die "could not update from $remote"
		fi
	fi
	if [ "$local_mode" -eq 0 ]; then srcref="$_rs_tmp-tip"; fi
fi
if [ "$_rs_base_label" = remote ]; then
	case "$base" in
	"refs/remotes/$remote/"*) baselabel=${base#refs/remotes/} ;;
	"$remote/"*) baselabel=$base ;;
	*) baselabel="$remote/$base" ;;
	esac
fi
if [ -n "$baseref" ]; then baseref=$(git rev-parse --verify "$baseref^{commit}"); fi

git rev-parse --verify --quiet "$srcref" >/dev/null ||
	die "$srclabel not found"

rb="review/$src"
git rev-parse --verify --quiet "refs/heads/$rb" >/dev/null &&
	die "$rb already exists; run git review clean $src first"
git rev-parse --verify --quiet "refs/heads/review-saved/$src" >/dev/null &&
	die "you have a saved review of $src; resume it with git review continue $src or discard it with git review forget --saved $src"

tip="$(git rev-parse --verify "$srcref^{commit}")"
prev="$(git config "$markerkey" || true)"
if [ -n "${_rs_saved_range:-}" ] && [ "$delta" -eq 1 ] && [ "$prev" != "$_rs_previous" ]; then
	die 'last review point changed; prepare the review again'
fi

# A remote review targets the remote's copy, never your local branch (which start
# never updates). If a local branch of the same name points elsewhere, you'd be
# reviewing a different snapshot than what's checked out, and a later
# finish --onto-source will refuse unless the local branch sits at the reviewed
# tip. Warn rather than silently review the wrong thing.
if [ "$local_mode" -eq 0 ]; then
	localtip="$(git rev-parse --verify --quiet "refs/heads/$src" || true)"
	if [ -n "$localtip" ] && [ "$localtip" != "$tip" ]; then
		echo "note: reviewing $srclabel ($(git rev-parse --short "$tip")), which differs from your local $src ($(git rev-parse --short "$localtip"))$(advice_suffix '; use --local to review what you have checked out')" >&2
	fi
fi

# Resolve the lower bound of the review range (exclusive).
pinned_from=''
if [ "$delta" -eq 1 ]; then
	[ -n "$prev" ] || die "no previous review of $src recorded; run a full review first"
	[ "$prev" != "$tip" ] || die "no new commits since your last review of $src"
	git merge-base --is-ancestor "$prev" "$tip" ||
		die "$src was force-pushed since your last review; run a full review instead"
	start="$prev"
	range="since last review ($(git rev-parse --short "$prev"))"
elif [ -n "$from" ]; then
	if [ -n "${_rs_saved_range:-}" ]; then
		[ -n "$_rs_from" ] || die 'prepared lower bound is unavailable; prepare the review again'
		pinned_from=$_rs_from
	else
		pinned_from="$(git rev-parse --verify --quiet "$from^{commit}")" || die "unknown commit: $from"
	fi
	start=$pinned_from
	git merge-base --is-ancestor "$start" "$tip" ||
		die "$from is not an ancestor of $srclabel"
	[ "$start" != "$tip" ] || die "no commits to review after $from"
	range="since $(git rev-parse --short "$start")"
else
	[ -n "$base" ] ||
		die "no base branch set; pass one as an argument or with --base, or run: git config reviewworkflow.base <branch>"
	[ -n "$baseref" ] ||
		die "$baselabel not found"
	start="$(git merge-base "$baseref" "$srcref")" ||
		die "could not compute merge-base with $baselabel"
	# Nothing to review when the source is already at the base (e.g. running on the
	# base branch itself, or a branch fully merged into it). Mirror the explicit
	# guards on --delta/--from instead of creating an empty review/ branch.
	[ "$start" != "$tip" ] ||
		die "no commits to review; $srclabel is already at $baselabel"
	range="vs $baselabel"
	if [ -n "$prev" ] && [ "$prev" != "$tip" ] && git merge-base --is-ancestor "$prev" "$tip"; then
		n="$(git rev-list --count "$prev..$tip")"
		echo "note: previously reviewed at $(git rev-parse --short "$prev"); $n new commit(s) since$(advice_suffix ' (use --delta to review only those)')" >&2
	fi
fi

# Read this source's own draft in preference to the PR's walkthrough, if the
# reviewer wrote one. Must run before the --step branch's own walk_read (the note
# there about bypassing a reading order used to see only the author's file, so a
# reviewer with their own draft was told nothing) and before the --keys check, so
# every decision from here on describes the same walkthrough.
walk_use_draft "$src"

if [ "$prepare" -eq 1 ]; then
	# The manifest pins both endpoints, even when a selector is a movable ref.
	set -- -p "$tip"
	if [ -n "$baseref" ] && [ "$baseref" != "$tip" ]; then set -- "$@" -p "$baseref"; fi
	if [ "$delta" -eq 1 ] && [ "$prev" != "$baseref" ] && [ "$prev" != "$tip" ]; then set -- "$@" -p "$prev"; fi
	_rs_pack=$(compare_lease_commit "$_rs_identity $_rs_base_label $tip ${baseref:--} ${prev:--} ${pinned_from:--}" "$@" </dev/null)
	git update-ref "$_rs_tmp" "$_rs_pack"
	_ero_branch=$src
	_ero_tip=$tip
	_ero_lower=$(resolve_lower_bound "$start" "$baseref" "$tip")
	emit_range_reading_offers
	if [ -n "$prev" ]; then
		if [ "$local_mode" -eq 1 ]; then _rs_origin=local; else _rs_origin=remote; fi
		porcelain_row delta "$src" "$prev" "$_rs_origin"
	fi
	porcelain_row start-prepared "$_rs_token"
	_rs_prepared=1
	exit 0
fi

start_keep_range() {
	if [ "$offline_mode" -eq 1 ] && [ -z "${_rs_saved_range:-}" ]; then return 0; fi
	set -- -p "$tip"
	if [ -n "$baseref" ] && [ "$baseref" != "$tip" ]; then set -- "$@" -p "$baseref"; fi
	if [ -n "$prev" ] && [ "$prev" != "$tip" ] && [ "$prev" != "$baseref" ] && git cat-file -e "$prev^{commit}" 2>/dev/null; then
		set -- "$@" -p "$prev"
	fi
	_rs_session=$(compare_lease_commit "$_rs_identity $_rs_base_label $tip ${baseref:--} ${prev:--} ${pinned_from:--}" "$@" </dev/null)
	git update-ref "refs/worktree/review-start/session/$src" "$_rs_session"
}

# draft_command: the git review walkthrough draft invocation for this review,
# flags and all. Built once — three messages below suggest it — with this
# review's own origin and range, since drafting against a different range would
# annotate the wrong file set.
draft_command() {
	_dc_flags=""
	if [ "$offline_mode" -eq 1 ]; then
		_dc_flags=" --offline"
	elif [ "$local_mode" -eq 1 ]; then
		_dc_flags=" --local"
	fi
	if [ "$delta" -eq 1 ]; then
		_dc_flags="$_dc_flags --delta"
	fi
	printf 'git review walkthrough draft%s %s' "$_dc_flags" "$src"
}

# Whose reading order is in force, for the notes below: a reviewer's draft shadows
# the author's walkthrough (walk_read), so blaming "the PR" for the reviewer's own
# order would send them hunting a typo on someone else's branch. Same distinction
# the "(draft)" suffix draws in status and list.
if walk_is_draft "$src"; then
	wtdesc="you have a walkthrough draft for $src"
else
	wtdesc="$src has a walkthrough"
fi

if [ "$step" -eq 1 ]; then
	# --first-parent --no-merges: walk only the branch's own commits, skipping
	# merge commits (e.g. merges of the base branch) so changes that came from
	# the base are never shown as a step.
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"
	[ -n "$commits" ] || die "no commits to review in range"
	count="$(printf '%s\n' "$commits" | wc -l | tr -d ' ')"
	first="$(printf '%s\n' "$commits" | sed -n '1p')"

	# A walkthrough is a whole-review reading aid; --step bypasses it wholesale. Note
	# it (unless --no-walk already opted out) so it's not silently missing.
	if [ "$no_walk" -eq 0 ] && wtcontent="$(walk_read "$tip")" && [ -n "$wtcontent" ]; then
		echo "note: $wtdesc; --step ignores it and reviews commit by commit"
	fi

	git switch -q -c "$rb" "$first" || die "could not create $rb"
	git reset --soft HEAD^
	git config "branch.$rb.reviewsource" "$src"
	git config "branch.$rb.reviewbase" "$base"
	if [ -n "$baseref" ]; then git config "branch.$rb.reviewbasecommit" "$baseref"; fi
	git config "branch.$rb.reviewtip" "$tip"
	git config "branch.$rb.reviewstart" "$start"
	git config "branch.$rb.reviewmode" "step"
	git config "branch.$rb.reviewcount" "$count"
	git config "branch.$rb.reviewstep" "1"
	# Recorded even though a step review reads no walkthrough: it still holds
	# custody of a draft (save/list/forget --saved need the name). See the
	# whole-mode write below for the full rationale.
	git config "branch.$rb.reviewdraft" "$src"
	if [ -n "$prev" ]; then
		git config "branch.$rb.reviewprevreviewed" "$prev"
	fi
	if [ "$local_mode" -eq 1 ]; then
		git config "branch.$rb.reviewlocal" "1"
	fi
	start_keep_range
	review_set_delta "$markerkey" "$tip"
	if [ -n "$returnbranch" ]; then
		git config "branch.$rb.reviewreturn" "$returnbranch"
	fi

	if ! comments_begin_session "$tip" "$baseref"; then echo 'note: comments could not be prepared; their original documents were preserved' >&2; fi
	echo "$rb ready ($range) — walking $count commit(s) one at a time"
	show_commit "$first" 1 "$count"
	exit 0
fi

# Lower bound for the staged diff: normally the range start, but folded past any
# base content already merged into the PR (fold_lower, shared with walkthrough) so
# that content doesn't appear as part of the review. No-op when the base wasn't
# merged in; degrades gracefully on git without merge-tree.
lower="$(fold_lower "$start" "$baseref" "$tip")"

# Walkthrough auto-detection: a .review/walkthrough.md on the tip, unless
# --no-walk or --step, enters walk mode — the same staged whole-PR review plus a
# guided reading cursor filtered to this range. A stale walkthrough that no
# longer intersects the range degrades to a plain whole review with a note (a
# broken/stale walkthrough never aborts a review). --keys is the exception: it
# requires a walk with at least one > key entry and fails before creating the
# branch instead of degrading.
walk=0
walkcount=0
keys_filter=0
if [ "$no_walk" -eq 0 ] && wtcontent="$(walk_read "$tip")" && [ -n "$wtcontent" ]; then
	guided="$(walk_sequence "$tip" "$lower")"
	# grep -c returns 1 (aborting under set -e in POSIX sh) on an empty sequence.
	guidedcount="$(printf '%s\n' "$guided" | grep -c . || true)"
	if [ "$guidedcount" -ge 1 ]; then
		walk=1
		if [ "$keys_only" -eq 1 ]; then
			walkpaths="$(walk_keys_order "$tip" "$lower")"
			walkcount="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
			if [ "$walkcount" -lt 1 ]; then
				die "--keys requires at least one walkthrough entry marked > key in range; mark keys or start without --keys"
			fi
			keys_filter=1
		else
			walkpaths="$(walk_reading_order "$tip" "$lower")"
			walkcount="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
		fi
	else
		if [ "$keys_only" -eq 1 ]; then
			die "--keys requires a walkthrough with entries in range; none apply to this review"
		fi
		degradedfiles="$(range_files "$tip" "$lower" | tr '\n' ' ')"
		echo "note: $wtdesc, but none of its entries apply to this review range; reviewing the whole diff: $degradedfiles"
		# Same offer the start assistant makes for this situation. Guarded on the
		# file, not on what is in force: with a draft already on disk (theirs, stale
		# or empty) this command would refuse for want of --force, and suggesting a
		# command that cannot run is worse than suggesting nothing.
		if advice_enabled && ! walk_has_draft_file "$src"; then
			echo "note: to read it in an order of your own instead: $(draft_command) (nothing gets committed)"
		fi
	fi
elif [ "$keys_only" -eq 1 ]; then
	# An empty draft reaches here having shadowed nothing (walk_read treats it as
	# absent), so "the PR has none" would be true but useless. The file test, not
	# walk_is_draft: what matters is that the file is theirs and on disk, which is
	# exactly what walk_is_draft says no to.
	if walk_has_draft_file "$src"; then
		die "--keys needs a walkthrough to read keys from, and your draft for $src is empty; fill it in (or start it over with '$(draft_command) --force'), or start without --keys"
	fi
	die "--keys requires a walkthrough on the PR; none found (or use without --keys)"
fi

git switch -q -c "$rb" "$tip" || die "could not create $rb"
git reset -q --soft "$lower"

git config "branch.$rb.reviewsource" "$src"
git config "branch.$rb.reviewbase" "$base"
if [ -n "$baseref" ]; then git config "branch.$rb.reviewbasecommit" "$baseref"; fi
git config "branch.$rb.reviewtip" "$tip"
# The name this review's walkthrough draft lives under, read back by
# walk_review_draft_src. Recorded whether or not a draft exists yet, and in every
# mode, because the custody surfaces (list, save, continue, forget) need to answer
# "where would mine be?" for a draft written mid-review. Here it equals the
# source; compare is where the two names diverge.
git config "branch.$rb.reviewdraft" "$src"
if [ -n "$prev" ]; then
	git config "branch.$rb.reviewprevreviewed" "$prev"
fi
if [ "$local_mode" -eq 1 ]; then
	git config "branch.$rb.reviewlocal" "1"
fi
start_keep_range
review_set_delta "$markerkey" "$tip"
if [ -n "$returnbranch" ]; then
	git config "branch.$rb.reviewreturn" "$returnbranch"
fi

if [ "$walk" -eq 1 ]; then
	git config "branch.$rb.reviewmode" "walk"
	git config "branch.$rb.reviewwalkstep" "1"
	git config "branch.$rb.reviewwalkcount" "$walkcount"
	# Where HEAD was just pinned, so later on "did you commit on top of this
	# review?" can be asked of git instead of guessed from the sequence having got
	# shorter (walk_at_base). Its own key rather than reviewstart, since finish's
	# metadata guard treats the step keys as proof of a step review.
	git config "branch.$rb.reviewwalkbase" "$(git rev-parse HEAD)"
	if [ "$keys_filter" -eq 1 ]; then
		git config "branch.$rb.reviewwalkkeys" "1"
	fi
	# A flag, not a name (reviewdraft above holds that): recorded only when the
	# order came from the reviewer's own draft, so absence keeps meaning "the
	# author's". Lets the cursor's diagnostics tell "you deleted your draft" apart
	# from "you committed on top of the review" once the file is gone.
	if walk_is_draft "$src"; then
		git config "branch.$rb.reviewwalkfromdraft" "1"
	fi

	if [ "$keys_filter" -eq 0 ]; then
		# Files in range with no walkthrough entry (typical of a stale walkthrough
		# under --delta) are still covered — appended to the end of the reading
		# order (walk_reading_order) — so note them rather than leave them silent.
		uncovered="$(printf '%s\n' "$walkpaths" | tail -n +"$((guidedcount + 1))")"
		if [ -n "$uncovered" ]; then
			echo "note: file(s) in range not in the walkthrough are added to the end of the reading order: $(printf '%s\n' "$uncovered" | tr '\n' ' ')"
		fi

		# Entries the author flagged "> key": the few files a reviewer must not skim.
		keycount="$(printf '%s\n' "$walkpaths" | walk_count_keys "$tip")"
		keysuffix=""
		if [ "$keycount" -ge 1 ]; then
			keysuffix=" ($keycount key)"
		fi

		echo "$rb ready ($range) — walkthrough: $walkcount $(entry_noun "$walkcount")$keysuffix; read, edit, then run git review next"
	else
		echo "$rb ready ($range) — walkthrough keys-only: $walkcount key$([ "$walkcount" -eq 1 ] || echo s); read, edit, then run git review next"
	fi

	# The author's heads-up, printed once before the first entry. Nothing prints
	# when the walkthrough carries none.
	headsup="$(printf '%s\n' "$wtcontent" | walk_preamble)"
	if [ -n "$headsup" ]; then
		printf -- '----\n%s\n' "$headsup"
	fi

	# show_walk_entry needs the walk globals; cur is the branch we just landed on,
	# total is the reading order's own length, and HEAD is the lower bound (== the
	# range's HEAD side used for the live diff).
	cur="$rb"
	total="$walkcount"
	if ! comments_begin_session "$tip" "$baseref"; then echo 'note: comments could not be prepared; their original documents were preserved' >&2; fi
	show_walk_entry 1
else
	if ! comments_begin_session "$tip" "$baseref"; then echo 'note: comments could not be prepared; their original documents were preserved' >&2; fi
	echo "$rb ready ($range) — the staged diff is the PR; edit, then run git review finish"
	# Landing in whole for want of a reading order is the one moment the reviewer
	# is looking, so offer to write one — unless --no-walk already made that call.
	if advice_enabled && [ "$no_walk" -eq 0 ] && ! walk_read "$tip" >/dev/null; then
		# Two ways to have no reading order need different sentences: a draft that is
		# there but empty used to satisfy walk_read, skipping this note and landing
		# in whole with nothing said — the only silent degradation left in walk mode.
		if walk_has_draft_file "$src"; then
			echo "note: your walkthrough draft for $src is empty, so it gave this review no reading order. Fill it in, or write it again with '$(draft_command) --force' (nothing gets committed)"
		else
			echo "note: $src has no walkthrough. To read it in an order of your own: $(draft_command) (nothing gets committed)"
		fi
	fi
fi
