#!/usr/bin/env sh
#
# git review continue — resume a review put aside with git review save.
#
# Turns review-saved/<branch> back into the active review/<branch>, restoring the
# exact state you left: in whole mode the staged PR diff with your edits in the
# working tree; in step mode the commit you were on, its edits and every other
# banked edit, so next/prev keep working as before.
#
set -eu

prog="git review continue"

usage() {
	cat <<EOF
usage: $prog [<branch>]

Resume a review saved with git review save. With no argument, resume the only
saved review (or list them if there is more than one).
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

arg=""
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		if [ -z "$arg" ]; then
			arg="$1"
		else
			die "unexpected argument $1"
		fi
		;;
	esac
	shift
done

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

# Pick the saved review to resume.
if [ -n "$arg" ]; then
	src="$arg"
	saved="review-saved/$src"
	git rev-parse --verify --quiet "refs/heads/$saved" >/dev/null ||
		die "no saved review for $src (looked for $saved)"
else
	branches="$(git for-each-ref --format='%(refname:short)' refs/heads/review-saved/)"
	[ -n "$branches" ] || die "no saved reviews; save one with git review save"
	n="$(printf '%s\n' "$branches" | wc -l | tr -d ' ')"
	if [ "$n" -gt 1 ]; then
		echo "more than one saved review — name the one to resume:" >&2
		printf '%s\n' "$branches" | sed -n 's#^review-saved/#  git review continue #p' >&2
		exit 1
	fi
	saved="$branches"
	src="${saved#review-saved/}"
fi

rb="review/$src"
git rev-parse --verify --quiet "refs/heads/$rb" >/dev/null &&
	die "$rb is already active; finish or abort it before resuming the saved one"

# Resuming materialises a working tree, so refuse to clobber local changes
# (tracked or untracked — same rule as start/compare).
require_clean_work_tree

mode="$(git config "branch.$saved.reviewmode" || echo whole)"

# restore_draft: bring the reviewer's walkthrough draft back to the active
# namespace. Called from both mode paths immediately before the review branch is
# created — the one point that satisfies both constraints at once:
#
#   * late enough that every guard which can still die has already run: moving it
#     back and then aborting leaves the draft in the active namespace with the
#     review still paused, and clean, seeing no review/<src>, used to delete it.
#   * early enough that nothing has read a walkthrough yet: the walk path rebuilds
#     its cursor through walk_read below, which has to find the draft already in
#     place or it resumes in a different reading order, silently.
#
# The draft's branch comes from walk_review_draft_src rather than being assumed to
# be the review's own source: a compare of origin/feature/x drafts for feature/x,
# and save filed it under that name.
restore_draft() {
	# Resolve the gitdir in this shell so the two lookups below share it: inside a
	# "$(...)" the cache dies with the subshell and each forks its own git rev-parse
	# (see walk_gitdir_init).
	walk_gitdir_init
	# Only the review that filed it takes it back: two paused reviews of one branch
	# file under one name, and a review that carried no draft has no claim on the
	# file sitting there — it used to walk off with another review's prose.
	walk_saved_draft_filed "$saved" || return 0
	_draftsrc="$(walk_review_draft_src "$saved")"
	_saved_draft="$(walk_saved_draft_path "$_draftsrc")"
	if [ -f "$_saved_draft" ]; then
		_live_draft="$(walk_draft_path "$_draftsrc")"
		# Never over a draft that is already there. Both files are hand-written prose
		# and nothing in the resume can tell which the reviewer meant to keep, so
		# refuse and let them say: writing a draft while the review was paused used to
		# have continue silently reinstate the archived one, cursor and all. The
		# asymmetry the destructive verbs are built on — refusing costs a command,
		# guessing costs the only copy.
		if [ -f "$_live_draft" ]; then
			die "a walkthrough draft for $_draftsrc already exists, and the paused review carries one of its own; resuming would overwrite yours. Keep yours by discarding the archived one with 'git review forget --saved $src' (that discards the paused review too), or drop yours with 'git review forget --draft $_draftsrc' and resume."
		fi
		mkdir -p "$(dirname "$_live_draft")"
		mv "$_saved_draft" "$_live_draft"
	fi
}

tip="$(git config "branch.$saved.reviewtip" || true)"
# A saved review missing its tip (hand-edited or half-deleted config) would let
# set -e kill us silently while restoring; report it instead.
[ -n "$tip" ] || die "missing review metadata for $saved; was it created with git review start? Discard it with 'git review forget --saved $src'."

# restore_meta <key>: copy branch.<saved>.<key> to branch.<rb>.<key> when set.
# Explicit if so the function returns 0 for absent optional keys (set -e safety).
restore_meta() {
	v="$(git config "branch.$saved.$1" || true)"
	if [ -n "$v" ]; then
		git config "branch.$rb.$1" "$v"
	fi
}

if [ "$mode" = "step" ]; then
	start="$(git config "branch.$saved.reviewstart" || true)"
	count="$(git config "branch.$saved.reviewcount" || true)"
	step="$(git config "branch.$saved.reviewstep" || true)"
	if [ -z "$start" ] || [ -z "$count" ] || [ -z "$step" ]; then
		die "missing review metadata for $saved; was it created with git review start? Discard it with 'git review forget --saved $src'."
	fi

	restore_draft

	# Bring the banked edits back to where git review next/prev expect them.
	git for-each-ref --format='%(refname)' "refs/review-saved-edits/$src/" | while read -r ref; do
		n="${ref##*/}"
		git update-ref "refs/review-edits/$src/$n" "$(git rev-parse "$ref")"
		git update-ref -d "$ref"
	done

	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"
	cstep="$(printf '%s\n' "$commits" | sed -n "${step}p")"

	# Land on the saved step exactly like review-next's goto_step does: hard-reset
	# to the commit, re-apply its banked edits (temp file, worktree-only — not
	# --3way/--index, or the edit lands staged and vanishes from git diff),
	# then soft-reset so the commit's diff is staged and the edit stays unstaged.
	git switch -q -c "$rb" "$cstep"
	ref="refs/review-edits/$src/$step"
	if git rev-parse --verify --quiet "$ref" >/dev/null; then
		apply_review_patch "${ref}^" "$ref" ||
			die "could not restore your edits for step $step"
	fi
	git reset -q --soft "$cstep^"

	git config "branch.$rb.reviewmode" step
	restore_meta reviewstart
	restore_meta reviewcount
	git config "branch.$rb.reviewstep" "$step"
	restore_meta reviewsource
	restore_meta reviewbase
	restore_meta reviewtip
	restore_meta reviewprevreviewed
	restore_meta reviewlocal
	restore_meta reviewreadonly
	restore_meta reviewreturn
	# The name the draft was filed under, restored in every mode for the same reason
	# save copies it in every mode: the resumed review has to look the file up under
	# the name it was written to, not under its own source.
	restore_meta reviewdraft

	git branch -D "$saved" >/dev/null

	echo "resumed review of $src — step $step/$count"
	show_commit "$cstep" "$step" "$count"
else
	# whole and walk mode: rebuild the pristine review state (PR diff staged at the
	# lower bound) and replay your edits into the working tree; walk restores its
	# reading cursor on top. Read with || true and reported: a deleted
	# reviewsavedlower would otherwise let set -e kill us mid-restore with no
	# message, so bail before creating the branch, as the step path does above.
	lower="$(git config "branch.$saved.reviewsavedlower" || true)"
	[ -n "$lower" ] || die "missing review metadata for $saved; was it created with git review start? Discard it with 'git review forget --saved $src'."

	restore_draft

	git switch -q -c "$rb" "$tip"
	git reset -q --soft "$lower"
	# Binary-safe apply via apply_review_patch (temp file, not command substitution).
	if ! git diff --quiet "$tip" "$saved"; then
		apply_review_patch "$tip" "$saved" ||
			die "could not restore your edits"
	fi

	restore_meta reviewsource
	restore_meta reviewbase
	restore_meta reviewtip
	restore_meta reviewprevreviewed
	restore_meta reviewlocal
	restore_meta reviewreadonly
	restore_meta reviewreturn
	# The name the draft was filed under (see the step path above).
	restore_meta reviewdraft

	if [ "$mode" = "walk" ]; then
		git config "branch.$rb.reviewmode" walk
		restore_meta reviewwalkstep
		restore_meta reviewwalkcount
		restore_meta reviewwalkkeys
		restore_meta reviewwalkfromdraft
		restore_meta reviewwalkbase
		git branch -D "$saved" >/dev/null

		# Re-derive the sequence and reprint the entry you were on, the way the step
		# path reprints its commit. load_walk_review_meta applies the keys-only filter
		# when reviewwalkkeys is set.
		cur="$rb"
		load_walk_review_meta
		echo "resumed review of $src — walkthrough entry $walkstep/$total"
		show_walk_entry "$walkstep"
	else
		git branch -D "$saved" >/dev/null
		echo "resumed review of $src — the staged diff is the PR; edit, then run git review finish"
	fi
fi
