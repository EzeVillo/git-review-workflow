{
  "name": "git-review-vscode",
  "displayName": "git review workflow",
  "description": "Review a git-review-workflow pull request as a native walkthrough panel",
  "version": "0.1.0",
  "publisher": "EzeVillo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:gitReview.walkthrough"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitReview",
          "title": "git review",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "gitReview": [
        {
          "id": "gitReview.walkthrough",
          "name": "Walkthrough",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "gitReview.openEntry",
        "title": "Abrir entrada",
        "category": "git review"
      },
      {
        "command": "gitReview.openChange",
        "title": "Ver cambios",
        "category": "git review",
        "icon": "$(diff)"
      },
      {
        "command": "gitReview.showWhy",
        "title": "Ver el porqué",
        "category": "git review",
        "icon": "$(comment)"
      },
      {
        "command": "gitReview.next",
        "title": "Entrada siguiente",
        "category": "git review",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitReview.prev",
        "title": "Entrada anterior",
        "category": "git review",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitReview.refresh",
        "title": "Refrescar",
        "category": "git review",
        "icon": "$(refresh)"
      },
      {
        "command": "gitReview.installCli",
        "title": "Instalar la CLI",
        "category": "git review"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitReview.next",
          "when": "view == gitReview.walkthrough && gitReview.situation == review && !gitReview.busy",
          "group": "navigation@1"
        },
        {
          "command": "gitReview.prev",
          "when": "view == gitReview.walkthrough && gitReview.situation == review && !gitReview.busy",
          "group": "navigation@2"
        },
        {
          "command": "gitReview.refresh",
          "when": "view == gitReview.walkthrough",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitReview.openChange",
          "when": "view == gitReview.walkthrough && (viewItem == entry-walk || viewItem == entry-step)",
          "group": "inline@1"
        },
        {
          "command": "gitReview.showWhy",
          "when": "view == gitReview.walkthrough && viewItem == entry-walk",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitReview.openEntry",
          "when": "false"
        },
        {
          "command": "gitReview.openChange",
          "when": "gitReview.situation == review"
        },
        {
          "command": "gitReview.showWhy",
          "when": "gitReview.situation == review"
        },
        {
          "command": "gitReview.next",
          "when": "gitReview.situation == review"
        },
        {
          "command": "gitReview.prev",
          "when": "gitReview.situation == review"
        },
        {
          "command": "gitReview.installCli",
          "when": "gitReview.situation == cli-missing || gitReview.situation == cli-outdated"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitReview.walkthrough",
        "when": "gitReview.situation == no-review",
        "contents": "No hay una review activa en este repositorio.\n[Cómo iniciar una review](https://github.com/EzeVillo/git-review-workflow#readme)"
      },
      {
        "view": "gitReview.walkthrough",
        "when": "gitReview.situation == out-of-range",
        "contents": "El cursor quedó fuera de rango: la base se movió.\n[Cómo arreglarlo](command:gitReview.showOutOfRangeHelp)"
      },
      {
        "view": "gitReview.walkthrough",
        "when": "gitReview.situation == cli-missing",
        "contents": "No se encontró la CLI git-review (≥ 0.3.0).\n[Instalar la CLI](command:gitReview.installCli)"
      },
      {
        "view": "gitReview.walkthrough",
        "when": "gitReview.situation == cli-outdated",
        "contents": "La CLI git-review instalada es anterior a 0.3.0.\n[Actualizar la CLI](command:gitReview.installCli)"
      },
      {
        "view": "gitReview.walkthrough",
        "when": "gitReview.situation == error",
        "contents": "Ocurrió un error al leer el estado de la review."
      },
      {
        "view": "gitReview.walkthrough",
        "when": "gitReview.situation == review && gitReview.mode == whole",
        "contents": "Esta review no tiene walkthrough: no hay un recorrido de lectura curado para este PR."
      }
    ],
    "configuration": {
      "title": "git review",
      "properties": {
        "gitReview.path": {
          "type": "string",
          "default": "",
          "description": "Ruta al dispatcher git-review cuando `git` no lo descubre. Vacío = invocar `git review`."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production && vsce package",
    "pretest": "npm run compile && tsc --noEmit -p .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --config test/unit/.mocharc.json",
    "test:integration": "tsc -p . --outDir out && node ./out/test/integration/runTests.js"
  },
  "dependencies": {
    "cross-spawn": "^7.0.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "@types/mocha": "^10.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "glob": "^10.3.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
