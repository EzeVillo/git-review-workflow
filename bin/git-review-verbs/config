#!/usr/bin/env sh
#
# git review config — read or write the product's own configuration keys.
#
# Mirrors git config's own grammar on purpose (a key alone reads, a key plus a
# value writes): it is the vocabulary every user already knows, and the one
# --porcelain gives a caller that has no review to ask yet (contracts/
# config-porcelain.md). Valid with or without an active review, in any git
# repository — there is no exit 2 here, because "no review" is not a condition
# this verb can observe.
#
# --porcelain with a branch also emits reading offers (008) for the tip/range
# context: default remote full, or --local/--offline/--delta. Never fetches.
#
set -eu

prog="git review config"

usage() {
	cat <<EOF
usage: $prog [<key> [<value>]] [--unset <key>] [--porcelain [--local | --offline] [--delta] [<branch>]]

Read or write git-review-workflow's own configuration: the base branch a full
review compares against, and the remote a review is fetched from.

  <key>                 base | remote
  <key> <value>         set <key> to <value>
  --unset <key>         remove <key>
  --porcelain [<branch>]
                        machine-readable output: the effective config plus
                        every candidate branch to review (see the README for
                        the format); with <branch>, also report whether it
                        has a prior review to diff against (--delta) and the
                        reading layouts viable for that tip/range (offer rows)
  --local               with --porcelain <branch>: offers for the local tip
  --offline             with --porcelain <branch>: offers for local tip + base
  --delta               with --porcelain <branch>: offers for the incremental
                        range since the last review tip of that origin

With no arguments, print the effective config for a person to read (two
columns, one row per key; a key with no value is omitted, never blank).
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

# config_key <key>
# Translate a product key to its git config key, or fail on stdout for an
# unknown one (die's caller). The translation is internal on purpose (FR-008):
# nothing outside this function knows reviewworkflow.* exists.
config_key() {
	case "$1" in
	base) echo reviewworkflow.base ;;
	remote) echo reviewworkflow.remote ;;
	*) return 1 ;;
	esac
}

porcelain=0
unset_key=""
local_mode=0
offline_mode=0
delta_mode=0
pos_count=0
pos1=""
pos2=""

# add_pos <arg>
# Collect a positional argument into the first free slot. What each slot means
# (a key/value pair, or a single branch for --porcelain) is decided once every
# argument is in, after the loop — the same reason start resolves src/base
# after its own loop: an option and a positional can arrive in either order.
add_pos() {
	if [ "$pos_count" -eq 0 ]; then
		pos1="$1"
	elif [ "$pos_count" -eq 1 ]; then
		pos2="$1"
	else
		die "unexpected argument $1"
	fi
	pos_count=$((pos_count + 1))
}

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--porcelain)
		porcelain=1
		;;
	--local)
		local_mode=1
		;;
	--offline)
		offline_mode=1
		;;
	--delta)
		delta_mode=1
		;;
	--unset)
		shift
		if [ $# -eq 0 ] || [ -z "$1" ]; then
			die "--unset requires a key"
		fi
		if [ -n "$unset_key" ]; then
			die "--unset given more than once"
		fi
		unset_key="$1"
		;;
	--)
		# End-of-options, the git convention (same idiom as start,
		# bin/git-review-verbs/start:92-109): a value that starts with "-" — a
		# legal branch name — is read as a positional from here on, never as an
		# option. Valid both for a value ("config base -- -foo") and for the
		# --porcelain branch argument ("config --porcelain -- -foo").
		shift
		while [ $# -gt 0 ]; do
			add_pos "$1"
			shift
		done
		break
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		add_pos "$1"
		;;
	esac
	shift
done

if [ "$porcelain" -eq 1 ] && [ -n "$unset_key" ]; then
	die "--porcelain and --unset are mutually exclusive"
fi

if [ "$local_mode" -eq 1 ] || [ "$offline_mode" -eq 1 ] || [ "$delta_mode" -eq 1 ]; then
	if [ "$porcelain" -eq 0 ]; then
		die "--local, --offline and --delta require --porcelain"
	fi
fi

if [ "$local_mode" -eq 1 ] && [ "$offline_mode" -eq 1 ]; then
	die "--local and --offline are mutually exclusive"
fi

# --offline implies local tip (same as start).
if [ "$offline_mode" -eq 1 ]; then
	local_mode=1
fi

mode=""
key=""
value=""
branch=""
if [ -n "$unset_key" ]; then
	[ "$pos_count" -eq 0 ] || die "unexpected argument $pos1"
	key="$unset_key"
	mode="unset"
elif [ "$porcelain" -eq 1 ]; then
	[ "$pos_count" -le 1 ] || die "unexpected argument $pos2"
	branch="$pos1"
	mode="porcelain"
else
	case "$pos_count" in
	0) mode="read-all" ;;
	1)
		key="$pos1"
		mode="read-one"
		;;
	2)
		key="$pos1"
		value="$pos2"
		mode="write"
		;;
	*) die "unexpected argument" ;;
	esac
fi

if [ "$delta_mode" -eq 1 ] && [ -z "$branch" ]; then
	die "--delta requires a branch with --porcelain"
fi
if { [ "$local_mode" -eq 1 ] || [ "$offline_mode" -eq 1 ]; } && [ -z "$branch" ]; then
	die "--local and --offline require a branch with --porcelain"
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

case "$mode" in
read-one | write | unset)
	gkey="$(config_key "$key")" || die "unknown key $key"
	;;
esac

case "$mode" in
read-all)
	base_val="$(git config reviewworkflow.base || true)"
	remote_val="$(git config reviewworkflow.remote || echo origin)"
	if [ -n "$base_val" ]; then
		printf '%-6s  %s\n' base "$base_val"
	fi
	printf '%-6s  %s\n' remote "$remote_val"
	;;
read-one)
	if [ "$key" = remote ]; then
		val="$(git config "$gkey" || echo origin)"
	else
		val="$(git config "$gkey" || true)"
	fi
	if [ -n "$val" ]; then
		printf '%s\n' "$val"
	fi
	;;
write)
	git config "$gkey" "$value" || die "could not set $key"
	;;
unset)
	# Idempotent: unsetting a key that was never set is not an error — nothing
	# about "clean up this config" implies "and fail if there was nothing to
	# clean". git config --unset itself exits 5 for a missing key; that exit
	# code is not part of this verb's contract.
	git config --unset "$gkey" 2>/dev/null || true
	;;
porcelain)
	# Shared helpers (porcelain_row, candidate_branches, emit_reading_offers),
	# sourced from the libexec directory the dispatcher points us at.
	# shellcheck source=../git-review-lib.sh
	. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

	remote_val="$(git config reviewworkflow.remote || echo origin)"
	base_val="$(git config reviewworkflow.base || true)"

	if [ -n "$base_val" ]; then
		porcelain_row config base "$base_val"
	fi
	porcelain_row config remote "$remote_val"

	# Remotes first (for config remote), then branch candidates (for start /
	# config base). Same constant-process budget as before: one extra `git
	# remote` call, not one per name.
	candidate_remotes "$remote_val"
	candidate_branches "$remote_val"

	# Loose walkthrough drafts, with and without a branch argument alike. Not
	# because this verb's output is symmetric — it is not: delta and offer exist
	# only with a branch — but because a draft is a fact about the WORKING TREE,
	# not about the branch you asked after. Conditioning it on the argument would
	# make the same repository report different drafts depending on what was
	# asked, and that relationship does not exist.
	#
	# Zero drafts emits nothing and, importantly, spends nothing: see the guard
	# in emit_draft_records.
	emit_draft_records

	# The two authoring guides, always both, present or not. Unlike the drafts
	# above, absence has to be REPORTED here rather than implied by silence: a
	# client cannot offer to create a guide it was never told about, and having it
	# rebuild the path on its own side is exactly what the reported-path rule
	# exists to prevent.
	#
	# A fact about the REPOSITORY, so it is emitted with and without a branch
	# argument, for the same reason the draft records are.
	emit_guide_records

	# The author's own walkthrough for the branch they are STANDING ON, and its
	# state against what that branch now holds. Emitted present or absent, for the
	# same reason as the guides, and unconditioned on the branch argument for the
	# same reason as the drafts: it is a file of this working tree, not a property
	# of whatever branch the caller asked about.
	emit_walkthrough_record "$base_val" "$remote_val"

	if [ -n "$branch" ]; then
		# Same pair of keys start reads for --delta (bin/git-review-verbs/start):
		# a remote review stores reviewworkflow.<branch>.reviewed; a
		# --local/--offline one stores reviewworkflowlocal.<branch>.reviewed.
		# Emit zero, one or two rows — never OR them into a single tip — so a
		# consumer can offer --delta only for the source that actually has a
		# marker (start --offline --delta must not see a remote-only tip).
		remote_tip="$(git config "reviewworkflow.$branch.reviewed" || true)"
		local_tip="$(git config "reviewworkflowlocal.$branch.reviewed" || true)"
		if [ -n "$remote_tip" ]; then
			porcelain_row delta "$branch" "$remote_tip" remote
		fi
		if [ -n "$local_tip" ]; then
			porcelain_row delta "$branch" "$local_tip" local
		fi

		# Reading offers for this tip/range (008). Default context = remote full.
		# --local/--offline/--delta select the same axes as start, without fetch.
		_offer_source=remote
		if [ "$offline_mode" -eq 1 ]; then
			_offer_source=offline
		elif [ "$local_mode" -eq 1 ]; then
			_offer_source=local
		fi
		emit_reading_offers "$branch" "$remote_val" "$_offer_source" "$delta_mode" || exit 1
	fi
	;;
esac
