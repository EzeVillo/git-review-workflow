#!/usr/bin/env sh
#
# git review status — show the state of the review on the current branch.
#
set -eu

prog="git review status"

usage() {
	cat <<EOF
usage: $prog [--porcelain | --why <path>]

Show the state of the review on the current review/* branch: source PR, mode,
and (in commit-by-commit mode) which commit you are on and which steps have
banked edits.

  --porcelain     machine-readable output, stable across git-review versions
                  (see the README for the format); exit codes 0/1/2/3
  --why <path>    print only the walkthrough's explanatory text for <path>,
                  nothing else (walk mode only)
EOF
}

porcelain=0
why=""
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--porcelain)
		if [ -n "$why" ]; then
			echo "error: --porcelain and --why are mutually exclusive" >&2
			usage >&2
			exit 1
		fi
		porcelain=1
		;;
	--why)
		if [ "$porcelain" -eq 1 ]; then
			echo "error: --porcelain and --why are mutually exclusive" >&2
			usage >&2
			exit 1
		fi
		shift
		if [ $# -eq 0 ] || [ -z "$1" ]; then
			echo "error: --why requires a path" >&2
			usage >&2
			exit 1
		fi
		why="$1"
		;;
	*)
		echo "error: unexpected argument $1" >&2
		usage >&2
		exit 1
		;;
	esac
	shift
done

git rev-parse --git-dir >/dev/null 2>&1 || {
	echo "error: not a git repository" >&2
	exit 1
}

cur="$(git symbolic-ref --quiet --short HEAD || true)"
case "$cur" in
review/*) ;;
*)
	echo "not on a review/* branch (HEAD is ${cur:-detached})" >&2
	exit 2
	;;
esac

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

review_config_init

src="$(review_config_get "branch.$cur.reviewsource" || true)"
tip="$(review_config_get "branch.$cur.reviewtip" || true)"
mode="$(review_config_get "branch.$cur.reviewmode" || echo whole)"
if [ -z "$src" ] || [ -z "$tip" ]; then
	if [ -z "$src" ]; then
		echo "error: missing review metadata; was $cur created with git review start? Switch away, then delete it with 'git branch -D $cur'." >&2
	else
		echo "error: missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'." >&2
	fi
	exit 1
fi

if [ -n "$why" ]; then
	if [ "$mode" != "walk" ]; then
		echo "error: --why only applies to a review with a walkthrough (mode is $mode)" >&2
		exit 1
	fi
	load_walk_review_meta
	if ! printf '%s\n' "$walkpaths" | grep -Fxq "$why"; then
		echo "error: $why is not in the current walkthrough sequence" >&2
		exit 1
	fi
	walk_why "$tip" "$why"
	exit 0
fi

# These are the original comparison endpoints, independent of the cursor and
# of refs moving after start. Older sessions may not carry this additive data.
is_readonly="$(review_config_get "branch.$cur.reviewreadonly" || true)"
cmpbase=""
cmpfrom=""
cmpto=""
if [ "$is_readonly" = "1" ]; then
	cmpbase="$(review_config_get "branch.$cur.reviewcomparebase" || true)"
	cmpfrom="$(review_config_get "branch.$cur.reviewbase" || true)"
	cmpto="$(review_config_get "branch.$cur.reviewcomparetarget" || true)"
fi

if [ "$porcelain" -eq 1 ]; then
	_review_navigation_loaded=0
	review_status_porcelain
	exit 0
fi

printf 'review of %s (tip %s)\n' "$src" "$(git rev-parse --short "$tip")"
printf '  branch  %s\n' "$cur"
if [ "$is_readonly" = "1" ]; then
	if [ -n "$cmpbase" ] && [ -n "$cmpfrom" ] && [ -n "$cmpto" ]; then
		printf '  from    %s (%s)\n  to      %s (%s)\n' "$cmpfrom" "$cmpbase" "$cmpto" "$tip"
	fi
	printf '  note    read-only compare — git review finish will refuse; abort or clean when done\n'
fi
# Whole/walk mid-finish conflict (rare for whole; step is the usual path) still
# needs a banner before the mode block so CLI-only users are not steered to next.
if [ "$(review_config_get "branch.$cur.reviewresume" || true)" = "conflict" ] && [ "$mode" != "step" ]; then
	printf '  note    finish mid-conflict — resolve markers, then git review finish --resume\n'
	printf '          (or git review finish --abort to back out)\n'
fi

if [ "$mode" = "step" ]; then
	count="$(review_config_get "branch.$cur.reviewcount" || true)"
	step="$(review_config_get "branch.$cur.reviewstep" || true)"
	start="$(review_config_get "branch.$cur.reviewstart" || true)"
	# A key deleted by a hand-edit (while reviewmode stays "step") would otherwise
	# let set -e kill the bare read silently mid-script; read with || true and report
	# it. reviewstep falls through to the numeric guard below for a precise message.
	if [ -z "$count" ] || [ -z "$start" ]; then
		echo "error: missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'." >&2
		exit 1
	fi
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"
	# Guard against a step that maps to no commit (corrupt config, hand-edited
	# metadata): otherwise cnow ends up empty and git rev-parse '' crashes while
	# the printf around it still "succeeds", printing a corrupt status line.
	# grep -c exits 1 when the count is 0; under set -e that aborts without a
	# diagnostic. Match walk's `|| true` and validate total below.
	total="$(printf '%s\n' "$commits" | grep -c . || true)"
	case "$step" in
	'' | *[!0-9]*)
		echo "error: corrupt review metadata: reviewstep is '$step', not a positive integer. Discard the review with 'git review abort'." >&2
		exit 1
		;;
	esac
	if [ "$total" -lt 1 ]; then
		echo "error: corrupt review metadata: no commits in range $start..$tip. Discard the review with 'git review abort'." >&2
		exit 1
	fi
	if [ "$step" -lt 1 ] || [ "$step" -gt "$total" ]; then
		echo "error: review step $step out of range (1..$total) — corrupt metadata? Discard the review with 'git review abort'." >&2
		exit 1
	fi
	cnow="$(printf '%s\n' "$commits" | sed -n "${step}p")"
	printf '  mode    step  [%s/%s] on %s %s\n' "$step" "$count" \
		"$(git rev-parse --short "$cnow")" "$(git log -1 --format='%s' "$cnow")"

	# Every banked ref in ONE process instead of a git rev-parse --verify per
	# position, the same technique the --porcelain branch above uses: under Git
	# Bash on Windows, where fork() is emulated, the N rev-parse calls were almost
	# all of a ~3.5s 50-commit status. The membership test is a plain shell `case`
	# over the refs wrapped in newlines; the trailing newline in the pattern is
	# what keeps step 1 from matching refs/review-edits/<src>/10.
	nl="$(printf '\nx')"
	nl="${nl%x}"
	banked_refs="$nl$(git for-each-ref --format='%(refname)' "refs/review-edits/$src/")$nl"
	banked=""
	i=1
	while [ "$i" -le "$count" ]; do
		case "$banked_refs" in
		*"${nl}refs/review-edits/$src/$i$nl"*) banked="$banked $i" ;;
		esac
		i=$((i + 1))
	done
	printf '  banked  %s\n' "${banked:- none}"

	# Files this step's commit touches (same inventory as porcelain `file` rows).
	cfiles="$(commit_files "$cnow")"
	cfilecount="$(printf '%s\n' "$cfiles" | grep -c . || true)"
	if [ "$cfilecount" -eq 0 ]; then
		printf '  files   no files in this commit\n'
	else
		printf '  files   %s\n' "$cfilecount"
		i=1
		printf '%s\n' "$cfiles" | while IFS= read -r f; do
			printf '    %s  %s\n' "$i" "$f"
			i=$((i + 1))
		done
	fi

	# Mid-finish conflict: porcelain already emits finish conflict; human status
	# must not steer the user toward next/prev while markers are live.
	if [ "$(review_config_get "branch.$cur.reviewresume" || true)" = "conflict" ]; then
		printf '  note    finish mid-conflict — resolve markers, then git review finish --resume\n'
		printf '          (or git review finish --abort to back out; next/prev/save are blocked)\n'
	else
		hint="git review next"
		[ "$step" -gt 1 ] && hint="$hint / git review prev"
		if [ "$is_readonly" = "1" ]; then
			printf '  next    read, then %s  (read-only compare; finish refuses)\n' "$hint"
		else
			printf '  next    edit, then %s  (git review finish when done)\n' "$hint"
		fi
	fi
elif [ "$mode" = "walk" ]; then
	# Same load path as --porcelain / next / prev: re-derives the sequence and
	# rejects corrupt walkstep/walkcount consistently (including keys-only).
	load_walk_review_meta
	if [ "$(review_config_get "branch.$cur.reviewwalkkeys" || true)" = "1" ]; then
		keys_only_note="  (keys-only)"
	else
		keys_only_note=""
	fi
	pnow="$(printf '%s\n' "$walkpaths" | sed -n "${walkstep}p")"
	mark=""
	if walk_is_annotated "$tip" "$pnow"; then
		if walk_is_key "$tip" "$pnow"; then
			mark="  (key)"
		fi
	else
		mark="  (uncovered)"
	fi
	# Say whose reading order this is. Not decoration: two days into a review it is
	# easy to read your own why as the author's, and give it an authority it never
	# had. Suffixed to the mode so the rest of the line keeps its shape.
	draft_note=""
	if walk_is_draft "${walk_draft_src:-$src}"; then
		draft_note=" (draft)"
	fi
	printf '  mode    walk%s  [%s/%s] on %s%s%s\n' "$draft_note" "$walkstep" "$total" "$pnow" "$mark" "$keys_only_note"
	hint="git review next"
	[ "$walkstep" -gt 1 ] && hint="$hint / git review prev"
	if [ "$is_readonly" = "1" ]; then
		printf '  next    read, then %s  (read-only compare; finish refuses)\n' "$hint"
	else
		printf '  next    read, then %s  (git review finish when done)\n' "$hint"
	fi
else
	base="$(review_config_get "branch.$cur.reviewbase" || true)"
	printf '  mode    whole%s\n' "${base:+  (base $base)}"
	# The files the range touches: a whole review has no cursor, so this is a
	# plain listing, not a "[k/N]" line — never omitted, never a blank section
	# standing in for zero files (the git-status precedent).
	files="$(range_files "$tip" "$(git rev-parse HEAD)")"
	filecount="$(printf '%s\n' "$files" | grep -c . || true)"
	if [ "$filecount" -eq 0 ]; then
		printf '  files   no files in this range\n'
	else
		printf '  files   %s\n' "$filecount"
		i=1
		printf '%s\n' "$files" | while IFS= read -r f; do
			printf '    %s  %s\n' "$i" "$f"
			i=$((i + 1))
		done
	fi
	if [ "$is_readonly" = "1" ]; then
		printf '  next    read (read-only compare; finish refuses)\n'
	else
		printf '  next    edit, then git review finish\n'
	fi
fi
