<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.ezevillo.gitreview</id>
    <name>git review workflow</name>
    <vendor email="ezevi@users.noreply.github.com" url="https://github.com/EzeVillo/git-review-workflow">EzeVillo</vendor>

    <!--
      This is the Marketplace listing body (HTML), and the only copy of it:
      build.gradle.kts deliberately does not set `description`, which would
      overwrite this one at package time. The first sentence is the shared
      product tagline — byte-identical across the three clients, enforced by
      scripts/check-client-product-surface.mjs (listing.tagline).

      Write for someone who has never heard of this: what it does, why it is
      different, what it needs. Two things do NOT belong here, and
      PluginCompatibilityTest fails on both:
        - the other clients. "Parity with the VS Code extension" is a fact about
          the monorepo. A reader who is installing this one has already picked
          their editor and most likely does not know the others exist.
        - the list of compatible IDEs. Marketplace prints "Compatible with:
          IntelliJ IDEA, WebStorm, …" above this text, derived from <depends>,
          and hides the listing entirely on the incompatible-with products —
          spending the opening paragraph restating that buys nothing.
    -->
    <description><![CDATA[
    <p>Walk a PR in order, then edit and run it — not just read the diff.</p>

    <p><code>git review</code> stages the entire pull request into your working tree as
    uncommitted changes. Reviewing it is then ordinary local work: jump to a
    definition, follow a call, run the tests, fix what you find. When you are done,
    <b>your fixes are extracted onto a branch of their own</b> — the author's commits
    stay exactly as they were.</p>

    <p>The tool window keeps your place in it:</p>
    <ul>
      <li><b>The reading order the author wrote</b>, one file at a time, each with the
      reason that change is there — instead of an alphabetical list of files you have
      to reassemble in your head.</li>
      <li><b>The whole range</b> when there is no reading order: open one diff, or all
      of them at once.</li>
      <li><b>Pause and come back.</b> A review survives switching branches; your edits
      are held until you finish it.</li>
    </ul>

    <p>Requires the <code>git review</code> command-line tool:
    <code>npm install -g git-review-workflow</code>
    (<a href="https://github.com/EzeVillo/git-review-workflow#installation">Homebrew, a Windows
    installer and a no-Node one-liner</a>).</p>
    ]]></description>

    <!--
      Product matrix (single listing, single zip):
      - platform + Git4Idea → any JetBrains IDE that ships both (Marketplace derives
        the "compatible products" list from these, not from a product-code enum).
      - incompatible-with → explicit opt-out for the two we do not support.
      Keep this list in lockstep with pluginVerification.ides in build.gradle.kts
      and PluginCompatibilityTest.
    -->
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <incompatible-with>com.intellij.modules.androidstudio</incompatible-with>
    <incompatible-with>com.intellij.modules.rider</incompatible-with>

    <!-- Stripe title for toolWindow id gitReview.walkthrough (must not rename the id). -->
    <resource-bundle>messages.GitReviewBundle</resource-bundle>

    <!-- since/until-build are patched from gradle.properties by the platform plugin -->

    <extensions defaultExtensionNs="com.intellij">
        <!--
          anchor="right" is the default placement only (FR-008 / invariant exception).
          Nothing in the plugin calls setAnchor/setSplitMode at runtime, so if the
          reviewer moves the tool window the platform keeps their choice.
          Stripe label: messages/GitReviewBundle.properties → toolwindow.stripe.gitReview.walkthrough
        -->
        <!--
          The stripe icon is the product mark, shared with the VS Code extension.
          The platform picks the _dark and @20x20 siblings by name; do not point
          this at a bare AllIcons.* again or the two clients stop matching.
        -->
        <toolWindow
            id="gitReview.walkthrough"
            anchor="right"
            factoryClass="com.ezevillo.gitreview.ui.GitReviewToolWindowFactory"
            icon="/icons/gitReviewToolWindow.svg"
            secondary="false"/>
        <projectService serviceImplementation="com.ezevillo.gitreview.host.GitReviewService"/>
        <applicationService serviceImplementation="com.ezevillo.gitreview.settings.GitReviewSettings"/>
        <projectService serviceImplementation="com.ezevillo.gitreview.settings.LastOpenedStore"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.ezevillo.gitreview.settings.GitReviewConfigurable"
            id="com.ezevillo.gitreview.settings"
            displayName="git review"/>
    </extensions>

    <actions>
        <!-- Tool-window title bar: Refresh, Finish, Save, Cancel, Preview edits (feature 010).
             Icons required: without them the title bar shows empty/placeholder glyphs. -->
        <group id="GitReview.ToolWindowTitle" text="git review title" popup="false">
            <action id="GitReview.Title.Refresh"
                    class="com.ezevillo.gitreview.ui.actions.RefreshAction"
                    text="Refresh"
                    description="Refresh the git review panel"
                    icon="AllIcons.Actions.Refresh"/>
            <action id="GitReview.Title.Finish"
                    class="com.ezevillo.gitreview.ui.actions.FinishReviewAction"
                    text="Finish"
                    description="Finish the active review"
                    icon="AllIcons.Actions.Checked"/>
            <action id="GitReview.Title.Save"
                    class="com.ezevillo.gitreview.ui.actions.SaveReviewAction"
                    text="Save"
                    description="Save the review for later"
                    icon="AllIcons.Actions.MenuSaveall"/>
            <action id="GitReview.Title.Cancel"
                    class="com.ezevillo.gitreview.ui.actions.AbortReviewAction"
                    text="Cancel"
                    description="Cancel the active review"
                    icon="AllIcons.Actions.Rollback"/>
            <action id="GitReview.Title.PreviewEdits"
                    class="com.ezevillo.gitreview.ui.actions.PreviewEditsAction"
                    text="Preview edits"
                    description="Preview banked edits"
                    icon="AllIcons.Actions.Preview"/>
        </group>

        <group id="GitReview.Menu" text="git review" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="GitReview.Refresh"
                    class="com.ezevillo.gitreview.ui.actions.RefreshAction"
                    text="Refresh"
                    description="Refresh the git review panel"/>
            <action id="GitReview.StartReview"
                    class="com.ezevillo.gitreview.ui.actions.StartReviewAction"
                    text="Start a Review"/>
            <action id="GitReview.ContinueReview"
                    class="com.ezevillo.gitreview.ui.actions.ContinueReviewAction"
                    text="Continue Saved Review"/>
            <action id="GitReview.FinishReview"
                    class="com.ezevillo.gitreview.ui.actions.FinishReviewAction"
                    text="Finish Review"/>
            <action id="GitReview.SaveReview"
                    class="com.ezevillo.gitreview.ui.actions.SaveReviewAction"
                    text="Save Review for Later"/>
            <action id="GitReview.AbortReview"
                    class="com.ezevillo.gitreview.ui.actions.AbortReviewAction"
                    text="Cancel Review"/>
            <action id="GitReview.UndoFinish"
                    class="com.ezevillo.gitreview.ui.actions.UndoFinishAction"
                    text="Undo Finish"/>
            <action id="GitReview.ResumeFinish"
                    class="com.ezevillo.gitreview.ui.actions.ResumeFinishAction"
                    text="Resume Finish"/>
            <separator/>
            <action id="GitReview.Next"
                    class="com.ezevillo.gitreview.ui.actions.NextAction"
                    text="Next Entry"/>
            <action id="GitReview.Prev"
                    class="com.ezevillo.gitreview.ui.actions.PrevAction"
                    text="Previous Entry"/>
            <action id="GitReview.GoToEntry"
                    class="com.ezevillo.gitreview.ui.actions.GoToEntryAction"
                    text="Go to Entry"/>
            <action id="GitReview.OpenEntry"
                    class="com.ezevillo.gitreview.ui.actions.OpenEntryAction"
                    text="Open Entry"/>
            <action id="GitReview.OpenChange"
                    class="com.ezevillo.gitreview.ui.actions.OpenChangeAction"
                    text="Open Changes"/>
            <action id="GitReview.OpenAllChanges"
                    class="com.ezevillo.gitreview.ui.actions.OpenAllChangesAction"
                    text="Open All Changes"/>
            <action id="GitReview.ShowWhy"
                    class="com.ezevillo.gitreview.ui.actions.ShowWhyAction"
                    text="Show Why"/>
            <separator/>
            <action id="GitReview.SetBase"
                    class="com.ezevillo.gitreview.ui.actions.SetBaseAction"
                    text="Set the Base Branch"/>
            <action id="GitReview.SetRemote"
                    class="com.ezevillo.gitreview.ui.actions.SetRemoteAction"
                    text="Set the Remote"/>
            <action id="GitReview.CleanReview"
                    class="com.ezevillo.gitreview.ui.actions.CleanReviewAction"
                    text="Clean"/>
            <action id="GitReview.ForgetReview"
                    class="com.ezevillo.gitreview.ui.actions.ForgetReviewAction"
                    text="Forget Saved Review or Delta Marker"/>
            <action id="GitReview.DiscardInventory"
                    class="com.ezevillo.gitreview.ui.actions.DiscardInventoryAction"
                    text="Discard Inventory Review"/>
            <action id="GitReview.PreviewEdits"
                    class="com.ezevillo.gitreview.ui.actions.PreviewEditsAction"
                    text="Preview Edits"/>
            <action id="GitReview.PreviewEditsStat"
                    class="com.ezevillo.gitreview.ui.actions.PreviewEditsStatAction"
                    text="Preview Edits (stat)"/>
            <action id="GitReview.CompareReview"
                    class="com.ezevillo.gitreview.ui.actions.CompareReviewAction"
                    text="Compare Revisions"/>
            <action id="GitReview.WalkthroughInit"
                    class="com.ezevillo.gitreview.ui.actions.WalkthroughInitAction"
                    text="Walkthrough: Init"/>
            <action id="GitReview.WalkthroughBuild"
                    class="com.ezevillo.gitreview.ui.actions.WalkthroughBuildAction"
                    text="Walkthrough: Build"/>
            <action id="GitReview.InstallCli"
                    class="com.ezevillo.gitreview.ui.actions.InstallCliAction"
                    text="How to Install the CLI"/>
            <action id="GitReview.ShowCliLog"
                    class="com.ezevillo.gitreview.ui.actions.ShowCliLogAction"
                    text="Show CLI Log"
                    description="Show the git-review CLI invocation log"/>
        </group>
    </actions>
</idea-plugin>
