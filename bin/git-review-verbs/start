#!/usr/bin/env sh
#
# git review start — stage a pull request diff on a review/<branch> branch.
#
# Two independent axes:
#   range  — where the review starts: the merge-base with the base branch
#            (default), your last review (--delta), or an explicit commit
#            (--from <commit>).
#   layout — how you see it: the whole range as one staged diff (default), or
#            one commit at a time (--step, advance with git review next).
#
set -eu

prog="git review start"

usage() {
	cat <<EOF
usage: $prog [<branch>] [<base> | --base <base> | --delta | --from <commit>] [--step | --no-walk | --keys] [--local | --offline]

Stage a pull request diff on a review/<branch> branch for inline review.
With no <branch>, review the branch you currently have checked out.

  <branch>          branch to review; omit it to review the current branch
  <base>            commit-ish to diff against — a branch, tag or commit
                    (required for a full review; set a default with:
                    git config reviewworkflow.base <branch>)
  --base <base>     the base to diff against; use it to pass a base while
                    letting <branch> default to the current branch
  --delta           review only the commits added since your last review
  --from <commit>   review only the commits after <commit>
  --step            review one commit at a time; advance with git review next
  --no-walk         ignore any walkthrough on the PR; review the whole diff
  --keys            walk mode restricted to entries marked > key (requires a
                    walkthrough with at least one key in range; not with
                    --step or --no-walk)
  --local           review your local <branch>, not origin's copy; the base
                    is still fetched and resolved against origin
  --offline         like --local, but also skip fetching and resolve the base
                    from your local branches too
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

src=""
base=""
base_explicit=0
from=""
delta=0
step=0
no_walk=0
keys_only=0
local_mode=0
offline_mode=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	-d | --delta) delta=1 ;;
	--step) step=1 ;;
	--no-walk) no_walk=1 ;;
	--keys) keys_only=1 ;;
	--local) local_mode=1 ;;
	--offline)
		local_mode=1
		offline_mode=1
		;;
	--base)
		shift
		[ $# -gt 0 ] || die "--base requires a base"
		[ -n "$1" ] || die "--base requires a base"
		[ "$base_explicit" -eq 0 ] || die "base given more than once"
		base="$1"
		base_explicit=1
		;;
	--base=*)
		[ "$base_explicit" -eq 0 ] || die "base given more than once"
		base="${1#--base=}"
		[ -n "$base" ] || die "--base requires a base"
		base_explicit=1
		;;
	--from)
		shift
		[ $# -gt 0 ] || die "--from requires a commit"
		from="$1"
		[ -n "$from" ] || die "--from requires a commit"
		;;
	--from=*)
		from="${1#--from=}"
		[ -n "$from" ] || die "--from requires a commit"
		;;
	--)
		# End-of-options, the git convention: everything after is positional,
		# so a branch whose name starts with "-" (or collides with a flag) can
		# still be reviewed, e.g. git review start -- --weird develop.
		shift
		while [ $# -gt 0 ]; do
			if [ -z "$src" ]; then
				src="$1"
			elif [ -z "$base" ]; then
				base="$1"
				base_explicit=1
			else
				die "unexpected argument $1"
			fi
			shift
		done
		break
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		if [ -z "$src" ]; then
			src="$1"
		elif [ -z "$base" ]; then
			base="$1"
			base_explicit=1
		else
			die "unexpected argument $1"
		fi
		;;
	esac
	shift
done

if [ "$delta" -eq 1 ] && [ -n "$from" ]; then
	die "use only one of --delta and --from"
fi

if [ "$base_explicit" -eq 1 ] && { [ "$delta" -eq 1 ] || [ -n "$from" ]; }; then
	die "base is ignored with --delta/--from; pass only one"
fi

if [ "$keys_only" -eq 1 ]; then
	if [ "$step" -eq 1 ]; then
		die "--keys cannot be combined with --step"
	fi
	if [ "$no_walk" -eq 1 ]; then
		die "--keys cannot be combined with --no-walk"
	fi
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# Shared helpers, sourced from the libexec directory the dispatcher points us at.
# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

# With no <branch>, review the branch you currently have checked out. This is
# git's own default — push, status, log and rebase all act on the current branch
# when you name nothing. It only resolves the name; the mode (remote vs --local)
# is still chosen by flags. The check against the review/*, review-saved/* and
# review-fixes/* namespaces avoids the nonsense of reviewing a review branch.
if [ -z "$src" ]; then
	cur="$(git symbolic-ref --quiet --short HEAD || true)"
	[ -n "$cur" ] || die "no branch given and HEAD is detached; name a branch to review"
	case "$cur" in
	review/* | review-saved/* | review-fixes/*) die "refusing to review a review branch (HEAD is $cur); name a branch to review" ;;
	esac
	src="$cur"
fi

# Remote to review from; defaults to origin, override with reviewworkflow.remote.
remote="$(git config reviewworkflow.remote || echo origin)"

# Remember where to return to when the review is aborted.
returnbranch="$(git symbolic-ref --quiet --short HEAD || true)"

if [ -z "$base" ]; then
	base="$(git config reviewworkflow.base || true)"
fi

require_clean_work_tree

# --local reviews your local <branch> directly; the default reviews the remote's.
# The base is a separate concern: it is the shared merge target, so it still
# resolves against origin (and origin is still fetched) even under --local —
# only --offline, which implies --local, also takes the base from your local
# branches and skips the network entirely. The two axes are kept apart
# everywhere: which ref the tip comes from, how it is named in messages, and
# the delta marker — local markers live in their own config section
# (reviewworkflowlocal.*) so a local and a remote review of the same branch
# name never overwrite each other's progress. A separate section, rather than a
# reviewworkflow.<src>.local.reviewed key, is deliberate: the latter would be
# ambiguous for a branch literally named "<src>.local".
if [ "$offline_mode" -eq 0 ]; then
	git fetch --quiet "$remote" || die "could not update from $remote"
fi
if [ "$local_mode" -eq 1 ]; then
	srcref="refs/heads/$src"
	srclabel="$src"
	markerkey="reviewworkflowlocal.$src.reviewed"
else
	srcref="refs/remotes/$remote/$src"
	srclabel="$remote/$src"
	markerkey="reviewworkflow.$src.reviewed"
fi

# Resolve the base into a ref and a human label. A base is normally a branch, so
# try the branch namespace first — the remote's copy, or the local branch with
# --offline — to keep the familiar origin/<base> labels and the merged-base
# folding below. Anything that is not a branch there still works as a read-only
# lower bound via any commit-ish: a tag, a SHA, or an origin/<x> spelled out in
# full. baseref stays empty when the base does not resolve at all; the
# full-review path treats that as fatal ("not found"), while the delta/from
# folding treats an unresolvable base as a no-op, exactly as before.
baseref=""
baselabel="$base"
if [ -n "$base" ]; then
	if [ "$offline_mode" -eq 1 ]; then
		if git rev-parse --verify --quiet "refs/heads/$base^{commit}" >/dev/null; then
			baseref="refs/heads/$base"
		fi
	else
		if git rev-parse --verify --quiet "refs/remotes/$remote/$base^{commit}" >/dev/null; then
			baseref="refs/remotes/$remote/$base"
			baselabel="$remote/$base"
		fi
	fi
	if [ -z "$baseref" ]; then
		bcommit="$(git rev-parse --verify --quiet "$base^{commit}" || true)"
		if [ -n "$bcommit" ]; then
			baseref="$bcommit"
		fi
	fi
fi

git rev-parse --verify --quiet "$srcref" >/dev/null ||
	die "$srclabel not found"

rb="review/$src"
git rev-parse --verify --quiet "refs/heads/$rb" >/dev/null &&
	die "$rb already exists; run git review clean $src first"
git rev-parse --verify --quiet "refs/heads/review-saved/$src" >/dev/null &&
	die "you have a saved review of $src; resume it with git review continue $src or discard it with git review forget --saved $src"

tip="$(git rev-parse "$srcref")"
prev="$(git config "$markerkey" || true)"

# A remote review targets the remote's copy of the branch, never your local one,
# which git review start never updates. If a local branch of the same name exists
# and points elsewhere, you are reviewing a different snapshot than the one you
# have checked out — and a later git review finish --onto-source, which writes to
# the local branch, will refuse unless it sits at the reviewed tip. Warn rather than
# silently review the wrong thing; --local reviews what you have checked out.
if [ "$local_mode" -eq 0 ]; then
	localtip="$(git rev-parse --verify --quiet "refs/heads/$src" || true)"
	if [ -n "$localtip" ] && [ "$localtip" != "$tip" ]; then
		echo "note: reviewing $srclabel ($(git rev-parse --short "$tip")), which differs from your local $src ($(git rev-parse --short "$localtip")); use --local to review what you have checked out" >&2
	fi
fi

# Resolve the lower bound of the review range (exclusive).
if [ "$delta" -eq 1 ]; then
	[ -n "$prev" ] || die "no previous review of $src recorded; run a full review first"
	[ "$prev" != "$tip" ] || die "no new commits since your last review of $src"
	git merge-base --is-ancestor "$prev" "$tip" ||
		die "$src was force-pushed since your last review; run a full review instead"
	start="$prev"
	range="since last review ($(git rev-parse --short "$prev"))"
elif [ -n "$from" ]; then
	start="$(git rev-parse --verify --quiet "$from^{commit}")" || die "unknown commit: $from"
	git merge-base --is-ancestor "$start" "$tip" ||
		die "$from is not an ancestor of $srclabel"
	[ "$start" != "$tip" ] || die "no commits to review after $from"
	range="since $(git rev-parse --short "$start")"
else
	[ -n "$base" ] ||
		die "no base branch set; pass one as an argument or with --base, or run: git config reviewworkflow.base <branch>"
	[ -n "$baseref" ] ||
		die "$baselabel not found"
	start="$(git merge-base "$baseref" "$srcref")" ||
		die "could not compute merge-base with $baselabel"
	# Nothing to review when the source is already at the base (e.g. running on the
	# base branch itself, or a branch fully merged into it). Mirror the explicit
	# guards on --delta/--from instead of creating an empty review/ branch.
	[ "$start" != "$tip" ] ||
		die "no commits to review; $srclabel is already at $baselabel"
	range="vs $baselabel"
	if [ -n "$prev" ] && [ "$prev" != "$tip" ] && git merge-base --is-ancestor "$prev" "$tip"; then
		n="$(git rev-list --count "$prev..$tip")"
		echo "note: previously reviewed at $(git rev-parse --short "$prev"); $n new commit(s) since (use --delta to review only those)" >&2
	fi
fi

# Read this source's own draft in preference to the PR's walkthrough, if the
# reviewer wrote one. Before the --step branch below and not after it: --step's
# own walk_read is the note that says a reading order is being bypassed, and with
# the context set later that note was the one thing in the suite that still saw
# only the author's file — so a reviewer who wrote an order and then asked for
# --step was told nothing at all, while the same PR annotated by its author said
# so. It is also before the first walk_read and the --keys check, so every
# decision from here on describes the same walkthrough.
walk_use_draft "$src"

# draft_command: the git review walkthrough draft invocation for this review,
# flags and all. Three of the messages below suggest it, so it is built once, with
# this review's own origin and range: drafting against a different range than the
# one being reviewed would annotate the wrong file set, and on a branch with no
# copy on the remote the bare form just fails.
draft_command() {
	_dc_flags=""
	if [ "$offline_mode" -eq 1 ]; then
		_dc_flags=" --offline"
	elif [ "$local_mode" -eq 1 ]; then
		_dc_flags=" --local"
	fi
	if [ "$delta" -eq 1 ]; then
		_dc_flags="$_dc_flags --delta"
	fi
	printf 'git review walkthrough draft%s %s' "$_dc_flags" "$src"
}

# Whose reading order is in force, for the notes below. A reviewer's draft shadows
# the author's walkthrough (walk_read), so a note that blames "the PR" for an order
# that is actually the reviewer's own sends them to read someone else's branch
# looking for their own typo — and the PR may carry no walkthrough at all. Same
# distinction the "(draft)" suffix draws in status and list, on the surface the
# reviewer sees first.
if walk_is_draft "$src"; then
	wtdesc="you have a walkthrough draft for $src"
else
	wtdesc="$src has a walkthrough"
fi

if [ "$step" -eq 1 ]; then
	# --first-parent --no-merges: walk only the branch's own commits, skipping
	# merge commits (e.g. merges of the base branch) so changes that came from
	# the base are never shown as a step.
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"
	[ -n "$commits" ] || die "no commits to review in range"
	count="$(printf '%s\n' "$commits" | wc -l | tr -d ' ')"
	first="$(printf '%s\n' "$commits" | sed -n '1p')"

	# A walkthrough is a whole-review reading aid; --step reviews commit by commit
	# and bypasses it wholesale. Note it (unless the reviewer already opted out with
	# --no-walk) so someone expecting the guided reading order is not left wondering
	# where it went.
	if [ "$no_walk" -eq 0 ] && wtcontent="$(walk_read "$tip")" && [ -n "$wtcontent" ]; then
		echo "note: $wtdesc; --step ignores it and reviews commit by commit"
	fi

	git switch -q -c "$rb" "$first" || die "could not create $rb"
	git reset --soft HEAD^
	git config "branch.$rb.reviewsource" "$src"
	git config "branch.$rb.reviewbase" "$base"
	git config "branch.$rb.reviewtip" "$tip"
	git config "branch.$rb.reviewstart" "$start"
	git config "branch.$rb.reviewmode" "step"
	git config "branch.$rb.reviewcount" "$count"
	git config "branch.$rb.reviewstep" "1"
	# Where this review's draft lives, recorded here too — see the whole-mode write
	# below for what the name is for. A step review reads no walkthrough, but it
	# holds custody of one all the same: save files the draft with it, list badges
	# the row and forget --saved discards it. Here the name happens to equal the
	# source, so leaving it out was invisible; in compare it is not, and a key that
	# only some modes write is a key every reader has to second-guess.
	git config "branch.$rb.reviewdraft" "$src"
	if [ -n "$prev" ]; then
		git config "branch.$rb.reviewprevreviewed" "$prev"
	fi
	if [ "$local_mode" -eq 1 ]; then
		git config "branch.$rb.reviewlocal" "1"
	fi
	git config "$markerkey" "$tip"
	if [ -n "$returnbranch" ]; then
		git config "branch.$rb.reviewreturn" "$returnbranch"
	fi

	echo "$rb ready ($range) — walking $count commit(s) one at a time"
	show_commit "$first" 1 "$count"
	exit 0
fi

# Lower bound for the staged diff. Normally it is the range start, but if the
# base branch has been merged into the PR, fold that already-merged base content
# into the lower bound so changes that came from the base do not appear as part
# of the review. fold_lower (shared with git review walkthrough) is a no-op when
# the base was not merged in, and degrades gracefully on git without merge-tree.
lower="$(fold_lower "$start" "$baseref" "$tip")"

# Walkthrough auto-detection. When the frozen tip carries a .review/walkthrough.md
# and the reviewer did not opt out (--no-walk) or into --step, enter walk mode:
# the same staged, editable whole-PR review, plus a guided reading cursor over
# it. The sequence is filtered to this review's range, so a stale walkthrough
# (e.g. under --delta) that no longer intersects the range degrades to a plain
# whole review with a note — a broken or stale walkthrough never aborts a review.
# --keys is the exception: it requires a walk with at least one > key entry and
# fails before creating the branch rather than degrading.
walk=0
walkcount=0
keys_filter=0
if [ "$no_walk" -eq 0 ] && wtcontent="$(walk_read "$tip")" && [ -n "$wtcontent" ]; then
	guided="$(walk_sequence "$tip" "$lower")"
	# grep -c returns 1 (aborting under set -e in POSIX sh) on an empty sequence.
	guidedcount="$(printf '%s\n' "$guided" | grep -c . || true)"
	if [ "$guidedcount" -ge 1 ]; then
		walk=1
		if [ "$keys_only" -eq 1 ]; then
			walkpaths="$(walk_keys_order "$tip" "$lower")"
			walkcount="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
			if [ "$walkcount" -lt 1 ]; then
				die "--keys requires at least one walkthrough entry marked > key in range; mark keys or start without --keys"
			fi
			keys_filter=1
		else
			walkpaths="$(walk_reading_order "$tip" "$lower")"
			walkcount="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
		fi
	else
		if [ "$keys_only" -eq 1 ]; then
			die "--keys requires a walkthrough with entries in range; none apply to this review"
		fi
		degradedfiles="$(range_files "$tip" "$lower" | tr '\n' ' ')"
		echo "note: $wtdesc, but none of its entries apply to this review range; reviewing the whole diff: $degradedfiles"
		# The same offer the start assistant makes for this situation (the "draft"
		# offer of config --porcelain, which a stale walkthrough gets instead of
		# "walk"). Without it the assistant proposed a way out that the terminal
		# never mentioned. Guarded on the file, not on what is in force: with a draft
		# already on disk — theirs, stale or empty — this command would refuse for
		# want of --force, and suggesting a command that cannot run is worse than
		# suggesting nothing.
		if ! walk_has_draft_file "$src"; then
			echo "note: to read it in an order of your own instead: $(draft_command) (nothing gets committed)"
		fi
	fi
elif [ "$keys_only" -eq 1 ]; then
	# An empty draft reaches here having shadowed nothing (walk_read treats it as
	# absent), so "the PR has none" would be true and useless — the file standing
	# between them and walk mode is their own, and it is empty. The file test, not
	# walk_is_draft: what matters here is that the file is theirs and on disk,
	# which is exactly what walk_is_draft now says no to.
	if walk_has_draft_file "$src"; then
		die "--keys needs a walkthrough to read keys from, and your draft for $src is empty; fill it in (or start it over with '$(draft_command) --force'), or start without --keys"
	fi
	die "--keys requires a walkthrough on the PR; none found (or use without --keys)"
fi

git switch -q -c "$rb" "$tip" || die "could not create $rb"
git reset -q --soft "$lower"

git config "branch.$rb.reviewsource" "$src"
git config "branch.$rb.reviewbase" "$base"
git config "branch.$rb.reviewtip" "$tip"
# The name this review's walkthrough draft lives under, decided here and read back
# by everything that has to find the file (walk_review_draft_src). Recorded whether
# or not a draft exists yet, and in every mode, because the question it answers is
# "where would mine be?" — which is what a draft written mid-review, and the
# custody surfaces (list, save, continue, forget), need. Here it is the source
# itself; compare is where the two come apart.
git config "branch.$rb.reviewdraft" "$src"
if [ -n "$prev" ]; then
	git config "branch.$rb.reviewprevreviewed" "$prev"
fi
if [ "$local_mode" -eq 1 ]; then
	git config "branch.$rb.reviewlocal" "1"
fi
git config "$markerkey" "$tip"
if [ -n "$returnbranch" ]; then
	git config "branch.$rb.reviewreturn" "$returnbranch"
fi

if [ "$walk" -eq 1 ]; then
	git config "branch.$rb.reviewmode" "walk"
	git config "branch.$rb.reviewwalkstep" "1"
	git config "branch.$rb.reviewwalkcount" "$walkcount"
	# Where HEAD was just pinned, so that later on "did you commit on top of this
	# review?" can be asked of git instead of guessed from the reading sequence
	# having got shorter (walk_at_base). Its own key rather than reviewstart:
	# finish's metadata guard treats the step keys as proof of a step review, and
	# every walk key is spelled reviewwalk* for exactly that reason.
	git config "branch.$rb.reviewwalkbase" "$(git rev-parse HEAD)"
	if [ "$keys_filter" -eq 1 ]; then
		git config "branch.$rb.reviewwalkkeys" "1"
	fi
	# Whether this reading order came from the reviewer's own draft. A flag and not
	# a name — reviewdraft above already holds the name — recorded only when the
	# draft is the one being read, so its absence keeps meaning "the author's".
	# It is what lets the cursor's diagnostics tell "you deleted your draft" apart
	# from "you committed on top of the review" when the sequence changes under
	# them: once the file is gone, nothing else can tell those two apart.
	if walk_is_draft "$src"; then
		git config "branch.$rb.reviewwalkfromdraft" "1"
	fi

	if [ "$keys_filter" -eq 0 ]; then
		# Files in the review range with no walkthrough entry: the walkthrough may be
		# stale (typical when re-reviewing with --delta). The review still covers them
		# — they are appended to the end of the reading order (walk_reading_order) — so
		# note them rather than leave them to be discovered silently.
		uncovered="$(printf '%s\n' "$walkpaths" | tail -n +"$((guidedcount + 1))")"
		if [ -n "$uncovered" ]; then
			echo "note: file(s) in range not in the walkthrough are added to the end of the reading order: $(printf '%s\n' "$uncovered" | tr '\n' ' ')"
		fi

		# Entries the author flagged "> key": the few files a reviewer must not skim.
		keycount="$(printf '%s\n' "$walkpaths" | walk_count_keys "$tip")"
		keysuffix=""
		if [ "$keycount" -ge 1 ]; then
			keysuffix=" ($keycount key)"
		fi

		echo "$rb ready ($range) — walkthrough: $walkcount $(entry_noun "$walkcount")$keysuffix; read, edit, then run git review next"
	else
		echo "$rb ready ($range) — walkthrough keys-only: $walkcount key$([ "$walkcount" -eq 1 ] || echo s); read, edit, then run git review next"
	fi

	# The author's heads-up, printed once before the first entry: what is delicate
	# in this PR, read before opening a file. Absent on a walkthrough that carries
	# none (nothing is printed then, not an empty block).
	headsup="$(printf '%s\n' "$wtcontent" | walk_preamble)"
	if [ -n "$headsup" ]; then
		printf -- '----\n%s\n' "$headsup"
	fi

	# show_walk_entry needs the walk globals; cur is the branch we just landed on,
	# total is the reading order's own length, and HEAD is the lower bound (== the
	# range's HEAD side used for the live diff).
	cur="$rb"
	total="$walkcount"
	show_walk_entry 1
else
	echo "$rb ready ($range) — the staged diff is the PR; edit, then run git review finish"
	# Landing in whole because nobody wrote a reading order is the moment the
	# reviewer would want to know they can write one themselves — and the only
	# moment they are looking. Suppressed when they opted out with --no-walk:
	# they already made the call.
	if [ "$no_walk" -eq 0 ] && ! walk_read "$tip" >/dev/null; then
		# Two ways to have no reading order, and they need different sentences. A
		# draft that is there but empty used to produce neither: it satisfied
		# walk_read, so this note was skipped, and the review landed in whole with
		# nothing said at all — the only silent degradation left in walk mode.
		if walk_has_draft_file "$src"; then
			echo "note: your walkthrough draft for $src is empty, so it gave this review no reading order. Fill it in, or write it again with '$(draft_command) --force' (nothing gets committed)"
		else
			echo "note: $src has no walkthrough. To read it in an order of your own: $(draft_command) (nothing gets committed)"
		fi
	fi
fi
