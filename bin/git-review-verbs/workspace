#!/usr/bin/env sh
#
# Review pinned revisions without rewriting a directory already in use.

set -eu

usage() {
	cat <<'EOF'
usage: git review workspace open [--step] [--read-only] <new-directory> -- <base> <target>
       git review workspace (status | next | prev | diff)
       git review workspace checkout [--porcelain] [<new-directory>]
       git review workspace finish <new-directory> [<other-workspace>...]
       git review workspace finish --with-shared <new-directory>
       git review workspace resume <new-directory>

Open an independent review workspace. Use --step to read a commit at a time.
Next and Previous move the reading cursor. Checkout opens the selected commit
in a new directory. Finish stages edits from these workspaces on the reviewed
tip in a new directory. From an active review, use --with-shared to include
prepared Shared comments. Resume a conflicted finish from its output directory
after staging your resolution. Previous directories remain available.
EOF
}

die() {
	printf 'error: %s\n' "$1" >&2
	exit 1
}

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

workspace_failed() {
	if [ "$1" -ne 0 ]; then
		printf 'note: workspace files retained at %s\n' "$destination" >&2
	fi
}

# Git can populate an index with names that the filesystem maps to one file.
# Compare the actual pathnames as enumerated by Git with an empty index, so
# Git cannot substitute the index spelling for a directory entry. Gitlinks
# are represented by empty directories until the reviewer initializes them.
verify_workspace_tree() (
	git diff-files --quiet --ignore-submodules=all -- || exit 1
	gitdir=$(git rev-parse --absolute-git-dir) || exit 1
	verify_dir=$(mktemp -d "$gitdir/workspace-verify.XXXXXX") || exit 1
	trap 'rm -f "$verify_dir/raw" "$verify_dir/index-paths" "$verify_dir/disk-paths"; rmdir "$verify_dir"' 0
	git -c core.quotePath=true ls-files --stage >"$verify_dir/raw" || exit 1
	LC_ALL=C awk -F '\t' '$1 !~ /^160000 / {print $2}' "$verify_dir/raw" >"$verify_dir/index-paths" || exit 1
	LC_ALL=C sort -o "$verify_dir/index-paths" "$verify_dir/index-paths" || exit 1
	GIT_INDEX_FILE="$verify_dir/empty" git -c core.quotePath=true -c core.ignoreCase=false ls-files --others >"$verify_dir/raw" || exit 1
	LC_ALL=C sort "$verify_dir/raw" >"$verify_dir/disk-paths" || exit 1
	cmp -s "$verify_dir/index-paths" "$verify_dir/disk-paths"
)

write_finish_progress() {
	printf '%s %s %s\n' "$1" "$patch_count" "$2" >"$queue/progress.next" || return 1
	mv -f "$queue/progress.next" "$queue/progress"
}

apply_workspace_patches() {
	queue=$GIT_DIR/review-workspace-finish
	mkdir "$queue" || return 1
	i=$patch_first
	while [ "$i" -le "$patch_count" ]; do
		cp "$patch_dir/$i" "$queue/$i" || return 1
		i=$((i + 1))
	done
	git -c core.hooksPath=/dev/null update-ref refs/review-workspace/finish-tip "$checkout_base" || return 1
	i=$patch_first
	write_finish_progress "$i" ready || return 1
	while [ "$i" -le "$patch_count" ]; do
		if [ -s "$queue/$i" ]; then
			write_finish_progress "$i" applying || return 1
			if ! git -c core.hooksPath=/dev/null apply --binary --3way --index --whitespace=nowarn "$queue/$i"; then
				unmerged=$(git ls-files --unmerged)
				if [ -n "$unmerged" ]; then
					write_finish_progress "$((i + 1))" conflict || return 1
					die 'resolve and stage the conflict, then run git review workspace resume <new-directory> from this output'
				fi
				write_finish_progress "$i" ready || return 1
				die 'patch application failed; git review workspace resume <new-directory> can retry from this output'
			fi
		fi
		i=$((i + 1))
		write_finish_progress "$i" ready || return 1
	done
	verify_workspace_tree || die 'the filesystem could not represent the finished index exactly'
	write_finish_progress "$i" complete
}

# Populate only a directory reserved by this invocation. A local fetch copies
# the pinned objects to an independent repository, including shallow history.
# In particular no alternate object store or source worktree is needed later.
create_workspace() (
	requested=$1
	checkout_base=$2
	checkout_tip=$3
	kind=$4
	parent=$(dirname -- "$requested")
	leaf=$(basename -- "$requested")
	case "$leaf" in ''|.|..|/) die 'choose a new workspace directory' ;; esac
	parent=$(CDPATH='' cd -P -- "$parent" && pwd -P) || die 'workspace parent directory does not exist'
	destination=${parent%/}/$leaf
	fetch_gitdir=$(git rev-parse --absolute-git-dir) || exit 1
	remote=$(git config --get reviewworkflow.remote || printf origin)
	remote_url=$(git remote get-url "$remote" 2>/dev/null || git remote get-url origin 2>/dev/null || true)
	case "$remote_url" in
	''|/*|*:*|\\*) ;;
	*) remote_url="$(git rev-parse --show-toplevel)/$remote_url" ;;
	esac
	local_vars=$(git rev-parse --local-env-vars) || exit 1
	for var in $local_vars; do unset "$var"; done
	if git -C "$parent" rev-parse --git-dir >/dev/null 2>&1; then
		die 'choose a directory outside existing Git repositories'
	fi
	if ! mkdir -- "$destination"; then
		die 'workspace destination must be a new directory'
	fi
	# Keep partial output on failure. Even a directory that was empty at
	# reservation can receive user files while Git is running.
	trap 'workspace_failed "$?"' 0
	trap 'exit 130' INT
	trap 'exit 143' TERM
	cd -- "$destination" || exit 1
	export GIT_DIR="$destination/.git" GIT_WORK_TREE="$destination"
	if [ "${#checkout_tip}" -eq 64 ]; then
		GIT_DEFAULT_HASH=sha256 git init -q --template= || exit 1
	else
		GIT_DEFAULT_HASH=sha1 git init -q --template= || exit 1
	fi
	# Older upload-pack versions accept only advertised tips by default. This
	# subprocess serves the local repository's exact pinned objects.
	git -c core.hooksPath=/dev/null fetch -q --no-tags --update-shallow \
		--upload-pack='git -c uploadpack.allowAnySHA1InWant=true upload-pack' -- \
		"$fetch_gitdir" "$range_base" "$range_tip" "$checkout_base" "$checkout_tip" || exit 1
	if [ -n "$remote_url" ]; then git config --local remote.origin.url "$remote_url" || exit 1; fi
	git symbolic-ref HEAD "refs/heads/$kind" || exit 1
	git -c core.hooksPath=/dev/null update-ref HEAD "$checkout_base" || exit 1
	# The index starts empty. Unpack the target, leaving HEAD at the lower
	# endpoint so the diff is staged.
	git -c core.hooksPath=/dev/null -c submodule.recurse=false read-tree -m -u "$checkout_tip" || exit 1
	verify_workspace_tree || die 'the filesystem could not represent the checkout exactly'
	if [ "$kind" = review-fixes ]; then
		if [ -n "${finish_owner:-}" ]; then
			git config --local reviewworkspace.finishowner "$finish_owner" || exit 1
			git config --local reviewworkspace.finishsource "$finish_source" || exit 1
			git config --local reviewworkspace.finishsession "$finish_session" || exit 1
			git config --local reviewworkspace.finishshared "$finish_shared" || exit 1
			git config --local reviewworkspace.finishdelivery "$finish_delivery" || exit 1
			if [ -n "${finish_target:-}" ]; then git config --local reviewworkspace.finishtarget "$finish_target" || exit 1; fi
		fi
		apply_workspace_patches || exit 1
	else
		{
			printf 'create refs/review-workspace/base %s\n' "$range_base"
			printf 'create refs/review-workspace/tip %s\n' "$range_tip"
			printf 'create refs/review-workspace/materialized %s\n' "$checkout_tip"
			if [ -n "$cursor" ]; then printf 'create refs/review-workspace/cursor %s\n' "$cursor"; fi
			if [ "$read_only" -eq 1 ]; then printf 'create refs/review-workspace/readonly %s\n' "$range_tip"; fi
		} | git -c core.hooksPath=/dev/null update-ref --stdin || exit 1
		if [ -n "${_review_step_workspace_id:-}" ]; then
			git config --local reviewworkspace.session "$_review_step_workspace_id" || exit 1
			if [ -s "$step_patch" ]; then git apply --binary "$step_patch" || exit 1; fi
		fi
	fi
	git rev-parse --show-toplevel
)

read_range() {
	range_base=$(git rev-parse --verify --quiet refs/review-workspace/base) || die 'run this command inside a review workspace'
	range_tip=$(git rev-parse --verify refs/review-workspace/tip)
	materialized=$(git rev-parse --verify refs/review-workspace/materialized)
	cursor=$(git rev-parse --verify --quiet refs/review-workspace/cursor || true)
	read_only=0
	if git show-ref --verify --quiet refs/review-workspace/readonly; then read_only=1; fi
}

write_workspace_diff() {
	git -c diff.relative=false diff --binary --full-index --no-ext-diff --no-textconv \
		--src-prefix=a/ --dst-prefix=b/ --ignore-submodules=dirty "$1" "$2" --
}

write_workspace_patch() {
	unmerged=$(git ls-files --unmerged) || return 1
	[ -z "$unmerged" ] || die 'resolve and stage conflicts before exporting workspace edits'
	tree=$(review_snapshot_worktree) || return 1
	write_workspace_diff "$materialized" "$tree"
}

write_workspace_patch_from() (
	selected_path=$1
	expected_base=$range_base
	expected_tip=$range_tip
	local_vars=$(git rev-parse --local-env-vars) || exit 1
	for var in $local_vars; do unset "$var"; done
	cd -- "$selected_path" || exit 1
	[ -z "$(git rev-parse --show-prefix)" ] || die 'specify the root of the workspace'
	read_range
	if [ "$range_base" != "$expected_base" ] || [ "$range_tip" != "$expected_tip" ]; then
		die "workspace reviews a different range: $selected_path"
	fi
	[ "$read_only" -eq 0 ] || die "this workspace is a read-only comparison: $selected_path"
	write_workspace_patch
)

load_active_workspace_review() {
	cur=$(git symbolic-ref --quiet --short HEAD || true)
	case "$cur" in review/*) ;; *) die 'run finish inside a review workspace or active review' ;; esac
	comments_lock_branch "$cur" || exit 1
	if [ "${1:-new}" = new ]; then require_not_finish_conflict "$cur"; fi
	require_not_pending_finish "$cur"
	[ "$(review_config_get "branch.$cur.reviewreadonly" || true)" != 1 ] || die 'this review is a read-only comparison'
	[ -n "$(review_config_get "branch.$cur.reviewsource" || true)" ] || die 'missing review metadata'
	range_tip=$(review_config_get "branch.$cur.reviewtip") || die 'missing review tip'
	range_base=$range_tip
}

write_active_review_patches() {
	mode=$(review_config_get "branch.$cur.reviewmode" || true)
	if [ "$mode" != step ]; then
		for key in reviewstart reviewcount reviewstep reviewreadstep reviewstepworkspaces; do
			[ -z "$(review_config_get "branch.$cur.$key" || true)" ] || die 'review metadata contains step keys for a different mode'
		done
	fi
	case "$mode" in
	step)
		load_step_review_meta "$cur"
		review_step_workspace_registry || exit 1
		patch_count=0
		while IFS= read -r materialized; do
			patch_count=$((patch_count + 1))
			if [ "$patch_count" -eq "$step" ]; then
				write_workspace_patch >"$patch_dir/$patch_count"
				continue
			fi
			path=$(review_step_workspace_path "$patch_count") || exit 1
			if [ -n "$path" ]; then
				(
					review_enter_step_workspace "$path" "$materialized" || exit 1
					write_workspace_patch
				) >"$patch_dir/$patch_count"
			else
				banked=$(git rev-parse --verify --quiet "refs/review-edits/$src/$patch_count" || true)
				if [ -n "$banked" ]; then
					write_workspace_diff "$materialized" "$banked" >"$patch_dir/$patch_count"
				else
					: >"$patch_dir/$patch_count"
				fi
			fi
		done <<EOF
$commits
EOF
		;;
''|whole|walk)
		patch_count=1
		materialized=$range_tip
		write_workspace_patch >"$patch_dir/$patch_count"
		;;
	*) die 'invalid review mode' ;;
	esac
}

write_active_shared_patch() {
	[ -n "$cc_session" ] && [ -n "$cc_context" ] || return 0
	prepared=$(comments_revision "$cc_dir/shared.md") || exit 1
	finish_shared=$prepared
	[ "$prepared" != absent ] || return 0
	baseline=$(comments_revision "$cc_dir/source-baseline.md") || exit 1
	[ "$prepared" != "$baseline" ] || return 0
	comments_safe_path "$cc_dir/source-conflict" || exit 1
	[ ! -e "$cc_dir/source-conflict" ] || die 'source and retained Shared changed separately; resolve both versions before delivery'
	entry=$(git ls-tree "$range_tip" -- .review/comments.md) || exit 1
	mode=100644
	case "$entry" in
	'') baseline_blob=absent ;;
	'100644 blob '*|'100755 blob '*)
		mode=${entry%% *}
		baseline_blob=$(git rev-parse --verify "$range_tip:.review/comments.md") || exit 1
		;;
	*) die 'Shared delivery destination is not a regular file' ;;
	esac
	[ "$baseline_blob" = "$baseline" ] || die 'Shared baseline differs from the pinned review tip; prepared comments were preserved'
	blob=$(git hash-object -w --no-filters -- "$cc_dir/shared.md") || exit 1
	[ "$blob" = "$prepared" ] || die 'Shared preparation changed while exporting'
	finish_delivery=$blob
	shared_tree=$(
		export GIT_INDEX_FILE="$patch_dir/shared-index"
		git read-tree "$range_tip" || exit 1
		git update-index --add --cacheinfo "$mode,$blob,.review/comments.md" || exit 1
		git write-tree
	) || exit 1
	# Freeze Shared last so the same queue can resume it after a code conflict.
	patch_count=$((patch_count + 1))
	write_workspace_diff "$range_tip" "$shared_tree" >"$patch_dir/$patch_count"
}

enter_active_finish_output() {
	review_enter_nested_worktree "$1" || return 1
	[ -z "$(git rev-parse --show-prefix)" ] || die 'use the root of the finish workspace'
	if [ "$(git config --local reviewworkspace.finishowner || true)" != "$source_gitdir" ] ||
		[ "$(git config --local reviewworkspace.finishsource || true)" != "$cur" ] ||
		[ "$(git config --local reviewworkspace.finishsession || true)" != "$cc_session" ] ||
		[ "$(git rev-parse --verify --quiet refs/review-workspace/finish-tip)" != "$range_tip" ]; then
		die 'finish workspace belongs to another review'
	fi
	finish_gitdir=$(git rev-parse --absolute-git-dir) || return 1
	read -r _ _ phase <"$finish_gitdir/review-workspace-finish/progress"
}

remember_active_finish_output() {
	[ -d "$1/.git" ] || return 0
	recoverable=$(
		enter_active_finish_output "$1" || exit 1
		git rev-parse --show-toplevel
	) 2>/dev/null || return 0
	git config "branch.$cur.reviewworkspacepending" "$recoverable"
}

prepare_workspace_state_directory() (
	ancestor=$1
	while [ ! -d "$ancestor" ]; do
		parent=$(dirname "$ancestor") || exit 1
		[ "$parent" != "$ancestor" ] || exit 1
		ancestor=$parent
	done
	if (review_enter_nested_worktree "$ancestor" && git rev-parse --git-dir >/dev/null 2>&1); then
		die 'the workspace state directory must be outside existing Git repositories'
	fi
	mkdir -p "$1"
)

allocate_finish_output() {
	# shellcheck disable=SC2031 # HOME is inherited from the invoking shell.
	finish_root=${XDG_STATE_HOME:-${HOME:?}/.local/state}/git-review/finishes
	prepare_workspace_state_directory "$finish_root" || return 1
	finish_parent=$(mktemp -d "$finish_root/finish.XXXXXX") || return 1
	printf '%s/edits\n' "$finish_parent"
}

launch_review_checkout() (
	verb=$1
	shift
	case "$verb" in start|compare|continue) ;; *) die 'launch requires start, compare or continue' ;; esac
	for argument do
		case "$argument" in
		--) break ;;
		--workspace|--prepare|--release|--sources|--offers|-h|--h)
			die 'isolated launch requires a review mutation' ;;
		esac
	done
	storage=$(review_persistence_gitdir) || exit 1
	launch_source=$(git symbolic-ref --quiet --short HEAD || true)
	launch_refs=$(git for-each-ref --format='%(objectname) %(refname)' \
		"refs/worktree/review-$verb/pending/" "refs/worktree/review-$verb/draft/" "refs/worktree/review-$verb/draft-key/") || exit 1
	# shellcheck disable=SC2031 # HOME is inherited from the invoking shell.
	root=${XDG_STATE_HOME:-${HOME:?}/.local/state}/git-review/reviews
	prepare_workspace_state_directory "$root" || exit 1
	parent=$(mktemp -d "$root/review.XXXXXX") || exit 1
	destination=$parent/checkout
	trap 'workspace_failed "$?"' 0
	seed=${GIT_REVIEW_LAUNCH_SEED:-HEAD}
	git -c core.hooksPath=/dev/null worktree add -q --detach --no-checkout -- "$destination" "$seed" >&2 || exit 1
	review_enter_nested_worktree "$destination" || exit 1
	gitdir=$(git rev-parse --absolute-git-dir) || exit 1
	printf '%s\n' "$storage" >"$gitdir/review-checkout-origin" || exit 1
	git -c core.hooksPath=/dev/null -c submodule.recurse=false read-tree -m -u HEAD || exit 1
	verify_workspace_tree || die 'the filesystem could not represent the opening checkout exactly'
	while read -r oid ref; do
		[ -n "$ref" ] || continue
		git -c core.hooksPath=/dev/null update-ref "$ref" "$oid" || exit 1
	done <<EOF
$launch_refs
EOF
	unset GIT_REVIEW_EXPECT_STATE
	GIT_REVIEW_LAUNCH_SOURCE=$launch_source GIT_REVIEW_MANAGED_CHECKOUT=1 \
		"$GIT_REVIEW_LIBEXEC/git-review-verbs/$verb" "$@" || exit $?
	branch=$(git symbolic-ref --quiet --short HEAD) || exit 1
	case "$branch" in review/*) ;; *) die 'isolated launch did not start a review' ;; esac
	root=$(git rev-parse --show-toplevel) || exit 1
	git config "branch.$branch.reviewworkspacepath" "$root" || exit 1
	if [ "$verb" != continue ]; then
		verify_workspace_tree || die 'the filesystem could not represent the review checkout exactly'
	fi
	porcelain_row review-checkout "$root"
)

# A named source destination uses the repository's branch, held by a new
# worktree. Keep the independent patch output available for recovery as well.
publish_active_source_checkout() (
	staged=$1
	update=$2
	src=$(review_config_get "branch.$cur.reviewsource") || exit 1
	finish_check_source "$src" "$range_tip" "$update"
	old=$finish_source_head
	(
		review_enter_nested_worktree "$staged" || exit 1
		git -c diff.relative=false diff --cached --binary --full-index --no-ext-diff --no-textconv \
			--src-prefix=a/ --dst-prefix=b/ HEAD --
	) >"$patch_dir/source.patch" || exit 1
	parent=$(mktemp -d "$(dirname "$staged")/source.XXXXXX") || exit 1
	destination=$parent/checkout
	if [ -z "$old" ]; then
		git -c core.hooksPath=/dev/null worktree add -q --detach --no-checkout -- "$destination" "$range_tip" || exit 1
	else
		git -c core.hooksPath=/dev/null worktree add -q --no-checkout -- "$destination" "$src" || exit 1
	fi
	review_enter_nested_worktree "$destination" || exit 1
	trap 'if [ "$?" -ne 0 ]; then
		if [ -n "$old" ] && [ "$(git symbolic-ref -q HEAD || true)" = "refs/heads/$src" ] &&
			[ "$(git rev-parse HEAD || true)" = "$old" ]; then review_detach_checkout || true; fi
		printf "note: source checkout files retained at %s\n" "$destination" >&2
	fi' 0
	if [ -n "$old" ]; then
		if [ "$(git symbolic-ref -q HEAD)" != "refs/heads/$src" ] || [ "$(git rev-parse HEAD)" != "$old" ]; then
			die 'the local source changed while opening its checkout'
		fi
	fi
	git -c core.hooksPath=/dev/null -c submodule.recurse=false read-tree -m -u "$range_tip" || exit 1
	verify_workspace_tree || die 'the filesystem could not represent the source checkout exactly'
	if [ -s "$patch_dir/source.patch" ]; then git apply --index --binary "$patch_dir/source.patch" || exit 1; fi
	verify_workspace_tree || die 'the filesystem could not represent the corrected source checkout exactly'
	if [ -z "$old" ]; then
		git -c core.hooksPath=/dev/null switch -q --no-overwrite-ignore -c "$src" || exit 1
	else
		git -c core.hooksPath=/dev/null update-ref "refs/heads/$src" "$range_tip" "$old" || exit 1
	fi
	git rev-parse --show-toplevel
)

complete_active_workspace_review() {
	prepared=absent
	if [ -n "$cc_dir" ]; then prepared=$(comments_revision "$cc_dir/shared.md") || exit 1; fi
	completed_path=$(
		enter_active_finish_output "$1" || exit 1
		[ "$(git config --local reviewworkspace.finishshared || true)" = "$prepared" ] ||
			die 'prepared Shared comments changed since this workspace was created'
		[ "$phase" = complete ] || die 'resume the finish workspace before closing the review'
		[ "$(git rev-parse HEAD)" = "$range_tip" ] || die 'finish workspace HEAD changed'
		delivery=$(git config --local reviewworkspace.finishdelivery) || exit 1
		if [ "$delivery" != absent ] && [ "$(git rev-parse --verify --quiet :.review/comments.md)" != "$delivery" ]; then
			die 'the staged Shared comments differ from the prepared delivery'
		fi
		git rev-parse --show-toplevel
	) || exit 1
	[ "$(git symbolic-ref --quiet --short HEAD || true)" = "$cur" ] || die 'review branch changed during finish'
	target=$(review_enter_nested_worktree "$completed_path" || exit 1; git config --local reviewworkspace.finishtarget || true) || exit 1
	if [ -n "$target" ]; then
		case "$target" in source) update=0 ;; update-source) update=1 ;; *) die 'invalid destination in the finish workspace' ;; esac
		published=$(review_enter_nested_worktree "$completed_path" || exit 1; git config --local reviewworkspace.publishedcheckout || true) || exit 1
		if [ -z "$published" ]; then
			published=$(publish_active_source_checkout "$completed_path" "$update") || exit 1
			(review_enter_nested_worktree "$completed_path" && git config --local reviewworkspace.publishedcheckout "$published") || exit 1
		fi
		completed_path=$published
	fi
	if [ -n "$cc_context" ]; then
		if review_find_session start "${cur#review/}" >/dev/null; then review_retain_objects=1; fi
		comments_publish "$cc_context" "$cc_dir" || exit 1
		[ "$(comments_revision "$cc_dir/shared.md")" = "$prepared" ] ||
			die 'prepared Shared comments changed during finish; the review remains open'
	fi
	git config "branch.$cur.reviewworkspacefinish" "$completed_path"
	git config --unset "branch.$cur.reviewworkspacepending" || true
	printf '%s\n' "$completed_path"
}

resume_active_workspace_finish() {
	pending=$(git config "branch.$cur.reviewworkspacepending") || die 'no pending finish workspace'
	pending_phase=$(enter_active_finish_output "$pending" && printf '%s\n' "$phase") || exit 1
	if [ "$pending_phase" = complete ]; then complete_active_workspace_review "$pending"; return; fi
	output=$(allocate_finish_output) || exit 1
	if resumed=$(
		enter_active_finish_output "$pending" || exit 1
		exec "$GIT_REVIEW_LIBEXEC/git-review-verbs/workspace" resume "$output"
	); then
		remember_active_finish_output "$resumed"
		complete_active_workspace_review "$resumed"
	else
		remember_active_finish_output "$output"
		exit 1
	fi
}

read_steps() {
	commits=$(git rev-list --reverse --first-parent --no-merges "$range_base..$range_tip")
	[ -n "$commits" ] || die 'there are no commits to read in the selected range'
}

show_position() {
	if [ -z "$cursor" ]; then
		git --no-pager diff --stat --no-ext-diff "$range_base" "$range_tip" --
		return
	fi
	set_position
	show_workspace_commit "$cursor" "$position" "$total"
}

show_workspace_commit() {
	show_commit "$1" "$2" "$3" 'Use git review workspace checkout to edit or test this commit in a new directory.'
}

set_position() {
	read_steps
	total=$(printf '%s\n' "$commits" | wc -l | tr -d ' ')
	position=$(printf '%s\n' "$commits" | awk -v commit="$cursor" '$0 == commit { print NR }')
	[ -n "$position" ] || die 'workspace cursor is outside the pinned range'
}

checkout_review_step() {
	requested_path=$1
	load_step_review_meta ''
	require_not_finish_conflict "$cur"
	require_not_pending_finish "$cur"
	if [ "$readstep" -eq "$step" ]; then
		git rev-parse --show-toplevel
		return
	fi
	comments_lock_branch "$cur" || exit 1
	trap 'if [ -n "${step_patch:-}" ]; then rm -f "$step_patch"; fi; comments_unlock' 0
	trap 'exit 130' INT
	trap 'exit 143' TERM
	selected_commit=$(printf '%s\n' "$commits" | sed -n "${readstep}p")
	review_step_workspace_registry || exit 1
	if [ -z "$_review_step_workspace_registry" ]; then
		common=$(git rev-parse --git-common-dir)
		common=$(CDPATH='' cd -- "$common" && pwd -P)
		mkdir -p "$common/review-step-workspaces"
		_review_step_workspace_registry=$(mktemp -d "$common/review-step-workspaces/step.XXXXXX")
		_review_step_workspace_id=${_review_step_workspace_registry##*/}
		git config "branch.$cur.reviewstepworkspaces" "$_review_step_workspace_id"
	fi
	registered=$(review_step_workspace_path "$readstep") || exit 1
	if [ -n "$registered" ]; then
		( review_enter_step_workspace "$registered" "$selected_commit" ) || exit 1
		printf '%s\n' "$registered"
		return
	fi
	if [ -z "$requested_path" ]; then
		# shellcheck disable=SC2031 # Inherit HOME from the invoking shell.
		root=${XDG_STATE_HOME:-${HOME:?}/.local/state}/git-review/workspaces
		prepare_workspace_state_directory "$root/$_review_step_workspace_id" || exit 1
		requested_path=$root/$_review_step_workspace_id/$readstep
	fi
	range_base=$(git rev-parse --verify "$selected_commit^")
	range_tip=$selected_commit
	cursor=''
	read_only=0
	if [ "$(git config "branch.$cur.reviewreadonly" || true)" = 1 ]; then read_only=1; fi
	step_patch=$(mktemp "$_review_step_workspace_registry/banked.XXXXXX")
	banked=$(git rev-parse --verify --quiet "refs/review-edits/$src/$readstep" || true)
	if [ -n "$banked" ]; then
		git -c diff.relative=false diff --binary --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/ \
			"$selected_commit" "$banked" -- >"$step_patch"
	fi
	directory=$(create_workspace "$requested_path" "$range_base" "$range_tip" review-workspace) || exit 1
	git config --file "$_review_step_workspace_registry/paths" "step.s$readstep.path" "$directory"
	printf '%s\n' "$directory"
}

command=${1:--h}
case "$command" in
launch)
	shift
	[ "$#" -ge 1 ] || die 'launch expects a review command'
	launch_review_checkout "$@"
	exit
	;;
-h|--h) usage; exit 0 ;;
esac
shift
case "$command" in
open)
	step_mode=0
	read_only=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--step) step_mode=1 ;;
		--read-only) read_only=1 ;;
		*) break ;;
		esac
		shift
	done
	if [ "$#" -ne 4 ] || [ "$2" != -- ]; then
		die 'open expects a new directory, --, and two revisions'
	fi
	range_base=$(review_commit_oid "$3") || die "unknown base revision: $3"
	range_tip=$(review_commit_oid "$4") || die "unknown target revision: $4"
	if review_uses_replacements && [ -n "$(git replace --list)" ]; then
		die 'workspaces require the original commit objects; disable replacement refs for this invocation'
	fi
	grafts=${GIT_GRAFT_FILE-$(git rev-parse --git-path info/grafts)}
	[ ! -s "$grafts" ] || die 'workspaces do not support grafted history'
	if [ "${GIT_SHALLOW_FILE+x}" = x ]; then
		die 'workspaces require the repository shallow boundary; unset GIT_SHALLOW_FILE'
	fi
	cursor=''
	checkout_base=$range_base
	checkout_tip=$range_tip
	if [ "$step_mode" -eq 1 ]; then
		read_steps
		cursor=$(printf '%s\n' "$commits" | sed -n '1p')
		checkout_tip=$cursor
		checkout_base=$(git rev-parse --verify "$cursor^")
	fi
	create_workspace "$1" "$checkout_base" "$checkout_tip" review-workspace
	;;
status|next|prev|diff)
	[ "$#" -eq 0 ] || die "$command takes no arguments"
	read_range
	case "$command" in
	status) show_position ;;
	diff)
		if [ -n "$cursor" ]; then set -- "$cursor^" "$cursor"; else set -- "$range_base" "$range_tip"; fi
		git --no-pager diff --no-ext-diff --no-textconv "$@" --
		;;
	next|prev)
		[ -n "$cursor" ] || die 'commit navigation requires a workspace opened with --step'
		set_position
		if [ "$command" = next ]; then destination=$((position + 1)); else destination=$((position - 1)); fi
		if [ "$destination" -lt 1 ] || [ "$destination" -gt "$total" ]; then
			show_workspace_commit "$cursor" "$position" "$total"
			exit 0
		fi
		selected=$(printf '%s\n' "$commits" | sed -n "${destination}p")
		git update-ref refs/review-workspace/cursor "$selected" "$cursor"
		show_workspace_commit "$selected" "$destination" "$total"
		;;
	esac
	;;
checkout)
	porcelain=0
	if [ "${1:-}" = --porcelain ]; then porcelain=1; shift; fi
	[ "$#" -le 1 ] || die 'checkout expects at most one new directory'
	if ! git show-ref --verify --quiet refs/review-workspace/base; then
		result=$(checkout_review_step "${1:-}") || exit $?
	else
		[ "$#" -eq 1 ] || die 'checkout expects a new directory in an isolated workspace'
		read_range
		if [ -n "$cursor" ]; then
			checkout_base=$(git rev-parse --verify "$cursor^")
			checkout_tip=$cursor
		else
			checkout_base=$range_base
			checkout_tip=$range_tip
		fi
		result=$(create_workspace "$1" "$checkout_base" "$checkout_tip" review-workspace) || exit $?
	fi
	if [ "$porcelain" -eq 1 ]; then porcelain_row step-checkout "$result"; else printf '%s\n' "$result"; fi
	;;
finish)
	with_shared=0
	close_review=0
	finish_target=''
	case "${1:-}" in
	--with-shared) with_shared=1; shift ;;
	--close) with_shared=1; close_review=1; shift ;;
	--close-onto-source) with_shared=1; close_review=1; finish_target=source; shift ;;
	--close-update-source) with_shared=1; close_review=1; finish_target=update-source; shift ;;
	--close-resolved) with_shared=1; close_review=2; shift ;;
	--resume-close) with_shared=1; close_review=3; shift ;;
	esac
	[ "$#" -ge 1 ] || die 'finish expects a new directory'
	output=$1
	shift
	source_gitdir=$(git rev-parse --absolute-git-dir)
	patch_dir=$(mktemp -d "$source_gitdir/workspace-patch.XXXXXX")
	trap 'rm -f "$patch_dir"/*; rmdir "$patch_dir"; comments_unlock' 0
	trap 'exit 130' INT
	trap 'exit 143' TERM
	patch_first=1
	if git show-ref --verify --quiet refs/review-workspace/base; then
		[ "$with_shared" -eq 0 ] || die '--with-shared requires an active review with comments'
		read_range
		[ "$read_only" -eq 0 ] || die 'this workspace is a read-only comparison'
		patch_count=1
		write_workspace_patch >"$patch_dir/$patch_count"
		for input do
			patch_count=$((patch_count + 1))
			write_workspace_patch_from "$input" >"$patch_dir/$patch_count"
		done
	else
		[ "$#" -eq 0 ] || die 'an active review automatically collects its registered checkouts'
		case "$close_review" in
		2) load_active_workspace_review resume; complete_active_workspace_review "$output"; exit 0 ;;
		3) load_active_workspace_review resume; resume_active_workspace_finish; exit 0 ;;
		*) load_active_workspace_review ;;
		esac
		finish_shared=absent finish_delivery=absent
		if [ "$close_review" -eq 1 ]; then
			if [ -n "$finish_target" ]; then
				finish_pr=$(review_config_get "branch.$cur.reviewsource") || exit 1
				if [ "$finish_target" = source ]; then update=0; else update=1; fi
				finish_check_source "$finish_pr" "$range_tip" "$update"
			fi
			if [ -z "$output" ]; then output=$(allocate_finish_output) || exit 1; fi
			finish_owner=$source_gitdir finish_source=$cur finish_session=$cc_session
		fi
		write_active_review_patches
		if [ "$with_shared" -eq 1 ]; then write_active_shared_patch; fi
	fi
	if [ "$close_review" -eq 1 ]; then
		if ! completed=$(create_workspace "$output" "$range_tip" "$range_tip" review-fixes); then
			remember_active_finish_output "$output"
			exit 1
		fi
		remember_active_finish_output "$completed"
		complete_active_workspace_review "$completed"
	else
		create_workspace "$output" "$range_tip" "$range_tip" review-fixes
	fi
	;;
resume)
	[ "$#" -eq 1 ] || die 'resume expects a new directory'
	finish_tip=$(git rev-parse --verify --quiet refs/review-workspace/finish-tip) ||
		die 'run resume inside an unfinished workspace output'
	gitdir=$(git rev-parse --absolute-git-dir)
	patch_dir=$gitdir/review-workspace-finish
	[ -f "$patch_dir/progress" ] || die 'workspace finish progress is missing'
	read -r patch_first patch_count phase <"$patch_dir/progress"
	case "$patch_first:$patch_count" in
	*[!0-9:]*|:*|*:) die 'invalid workspace finish progress' ;;
	esac
	case "$phase" in
	complete) die 'this workspace finish is already complete' ;;
	applying) die 'workspace finish was interrupted during patch application; inspect this output and retry finish from the original workspaces' ;;
	ready|conflict) ;;
	*) die 'invalid workspace finish progress' ;;
	esac
	[ "$(git rev-parse --verify HEAD)" = "$finish_tip" ] || die 'workspace output HEAD changed; keep the resolution staged at the original tip'
	[ -z "$(git ls-files --unmerged)" ] || die 'resolve and stage all conflicts before resuming'
	git diff-files --quiet --ignore-submodules=dirty -- || die 'stage your resolution before resuming'
	tree=$(git write-tree)
	finish_owner=$(git config --local reviewworkspace.finishowner || true)
	if [ -n "$finish_owner" ]; then
		finish_source=$(git config --local reviewworkspace.finishsource)
		finish_session=$(git config --local reviewworkspace.finishsession)
		finish_shared=$(git config --local reviewworkspace.finishshared)
		finish_delivery=$(git config --local reviewworkspace.finishdelivery)
		finish_target=$(git config --local reviewworkspace.finishtarget || true)
	fi
	checkpoint=$(git -c user.name='git review' -c user.email=workspace@localhost -c commit.gpgSign=false \
		commit-tree "$tree" -p "$finish_tip" -m 'workspace finish checkpoint')
	range_base=$finish_tip
	range_tip=$finish_tip
	create_workspace "$1" "$finish_tip" "$checkpoint" review-fixes
	;;
*) die "unknown workspace command: $command" ;;
esac
