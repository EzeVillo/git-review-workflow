#!/usr/bin/env sh
#
# git review continue — resume a review put aside with git review save.
#
# Turns review-saved/<branch> back into the active review/<branch>, restoring the
# exact state you left: in whole mode the staged PR diff with your edits in the
# working tree; in step mode the original checkout, its edits and the reading
# cursor, with any isolated checkouts still available at their saved paths.
#
set -eu

prog="git review continue"

usage() {
	cat <<EOF
usage: $prog [--porcelain] [<branch>]

Resume a review saved with git review save. With no argument, resume the only
saved review (or list them if there is more than one).
An isolated review resumes in a new checkout and prints its path.
  --porcelain  return the resulting panel state instead of human output
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

arg=""
porcelain=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--porcelain) porcelain=1 ;;
	--)
		shift
		if [ "$#" -ne 1 ] || [ -n "$arg" ]; then die 'expected a single saved review name'; fi
		arg=$1
		break
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		if [ -z "$arg" ]; then
			arg="$1"
		else
			die "unexpected argument $1"
		fi
		;;
	esac
	shift
done

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

if [ -n "${GIT_REVIEW_EXPECT_STATE:-}" ]; then
	if ! review_continue_guard_capture; then die 'could not read review metadata'; fi
	if [ "$continue_guard" != "$GIT_REVIEW_EXPECT_STATE" ]; then
		echo 'error: review state changed' >&2
		exit 4
	fi
fi

# Pick the saved review to resume.
if [ -n "$arg" ]; then
	src="$arg"
	saved="review-saved/$src"
	git rev-parse --verify --quiet "refs/heads/$saved" >/dev/null ||
		die "no saved review for $src (looked for $saved)"
else
	branches="$(git for-each-ref --format='%(refname:short)' refs/heads/review-saved/)"
	[ -n "$branches" ] || die "no saved reviews; save one with git review save"
	n="$(printf '%s\n' "$branches" | wc -l | tr -d ' ')"
	if [ "$n" -gt 1 ]; then
		echo "more than one saved review — name the one to resume:" >&2
		printf '%s\n' "$branches" | sed -n 's#^review-saved/#  git review continue #p' >&2
		exit 1
	fi
	saved="$branches"
	src="${saved#review-saved/}"
fi

rb="review/$src"
git rev-parse --verify --quiet "refs/heads/$rb" >/dev/null &&
	die "$rb is already active; finish or abort it before resuming the saved one"
review_require_branch_slot "$rb"

# Like Save, batch each custody phase while retaining fresh reads before/after
# the lock and immediately before publication. No snapshot crosses a boundary.
_review_close_snapshot=1
continue_cleanup() {
	comments_transfer_rollback || true
	comments_unlock
	if [ "$1" -ne 0 ] && [ "${_continue_open:-0}" -eq 1 ]; then
		echo "error: resuming $src stopped after checkout; the saved review and its original edits are still available" >&2
	fi
}
comments_lock_branch "$saved" || exit 1
trap 'continue_cleanup "$?"' 0
trap 'exit 1' 1 2 15

review_config_read "branch.$saved.reviewworkspacepath"
if [ -n "$_review_config_value" ] && [ "${GIT_REVIEW_MANAGED_CHECKOUT:-0}" != 1 ]; then
	review_config_read "branch.$saved.reviewtip"
	saved_tip=$_review_config_value
	[ -n "$saved_tip" ] || die 'missing saved review tip'
	seed_step=0 seed_start=''
	review_config_read "branch.$saved.reviewmode"
	if [ "$_review_config_value" = step ]; then
		review_config_read "branch.$saved.reviewstart"
		seed_start=$_review_config_value
		[ -n "$seed_start" ] || die 'missing saved step range'
		review_config_read "branch.$saved.reviewstep"
		seed_step=$_review_config_value
		case "$seed_step" in ''|0|*[!0-9]*) die 'invalid saved step' ;; esac
	fi
	GIT_REVIEW_LAUNCH_SEED=$(review_launch_seed "$seed_step" "$seed_start" "$saved_tip") || exit 1
	export GIT_REVIEW_LAUNCH_SEED
	# The child validates and locks the same custody before transferring it.
	comments_unlock
	exec "$GIT_REVIEW_LIBEXEC/git-review-verbs/workspace" launch continue -- "$src"
fi

# The destination can now be checked without assessing the caller's dirty tree.
require_clean_work_tree
comments_transfer_preflight "$saved" "$rb" || exit 1

review_config_read "branch.$saved.reviewmode" whole
mode=$_review_config_value

# Check the draft path before checkout. Keep the archived copy until the
# active branch has taken over the saved session.
prepare_draft_restore() {
	# Resolve the gitdir in this shell so the two lookups below share it: inside a
	# "$(...)" the cache dies with the subshell and each forks its own git rev-parse
	# (see walk_gitdir_init).
	walk_gitdir_init
	# Only the review that filed it takes it back: two paused reviews of one branch
	# file under one name, and a review that carried no draft has no claim on the
	# file sitting there — it used to walk off with another review's prose.
	walk_saved_draft_filed "$saved" || return 0
	_draftsrc="$(walk_review_draft_src "$saved")"
	_saved_draft="$(walk_saved_draft_path "$_draftsrc")"
	if [ -f "$_saved_draft" ]; then
		_live_draft="$(walk_draft_path "$_draftsrc")"
		# Never over a draft that is already there. Both files are hand-written prose
		# and nothing in the resume can tell which the reviewer meant to keep, so
		# refuse and let them say: writing a draft while the review was paused used to
		# have continue silently reinstate the archived one, cursor and all. The
		# asymmetry the destructive verbs are built on — refusing costs a command,
		# guessing costs the only copy.
		if [ -f "$_live_draft" ]; then
			die "a walkthrough draft for $_draftsrc already exists, and the paused review carries one of its own; resuming would overwrite yours. Keep yours by discarding the archived one with 'git review forget --saved $src' (that discards the paused review too), or drop yours with 'git review forget --draft $_draftsrc' and resume."
		fi
	fi
}

review_config_read "branch.$saved.reviewtip"
tip=$_review_config_value
# A saved review missing its tip (hand-edited or half-deleted config) would let
# set -e kill us silently while restoring; report it instead.
[ -n "$tip" ] || die "missing review metadata for $saved; was it created with git review start? Discard it with 'git review forget --saved $src'."

# restore_meta <key>: copy branch.<saved>.<key> to branch.<rb>.<key> when set.
# Explicit if so the function returns 0 for absent optional keys (set -e safety).
restore_meta() {
	review_config_read "branch.$saved.$1"
	v=$_review_config_value
	if [ -n "$v" ]; then
		git config "branch.$rb.$1" "$v"
	fi
}

if [ "$mode" = "step" ]; then
	review_config_read "branch.$saved.reviewstart"
	start=$_review_config_value
	review_config_read "branch.$saved.reviewcount"
	count=$_review_config_value
	review_config_read "branch.$saved.reviewstep"
	step=$_review_config_value
	review_config_read "branch.$saved.reviewreadstep" "$step"
	readstep=$_review_config_value
	if [ -z "$start" ] || [ -z "$count" ] || [ -z "$step" ]; then
		die "missing review metadata for $saved; was it created with git review start? Discard it with 'git review forget --saved $src'."
	fi
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"
	cstep="$(printf '%s\n' "$commits" | sed -n "${step}p")"
	case "$readstep" in ''|*[!0-9]*) die 'invalid saved step reading cursor' ;; esac
	selected=$(printf '%s\n' "$commits" | sed -n "${readstep}p")
	[ -n "$selected" ] || die 'saved step reading cursor is outside the review range'
else
	review_config_read "branch.$saved.reviewsavedlower"
	lower=$_review_config_value
	[ -n "$lower" ] || die "missing review metadata for $saved; was it created with git review start? Discard it with 'git review forget --saved $src'."
fi

prepare_draft_restore
comments_transfer "$saved" "$rb" || exit 1

if [ "$mode" = "step" ]; then
	# Rebuild the original checkout with the commit diff staged and the saved
	# edits unstaged. External checkouts remain at their registered paths.
	review_open_branch start "$src" "$cstep"
	ref="refs/review-saved-edits/$src/$step"
	if ! git show-ref --verify --quiet "$ref"; then
		# Older versions could move the bank before a failed checkout.
		ref="refs/review-edits/$src/$step"
	fi
	if git rev-parse --verify --quiet "$ref" >/dev/null; then
		if ! apply_review_patch "${ref}^" "$ref"; then
			review_cancel_open || true
			die "could not restore your edits for step $step"
		fi
	fi
	review_stage_open "$cstep^"
	_continue_open=1

	git config "branch.$rb.reviewmode" step
	restore_meta reviewstart
	restore_meta reviewcount
	git config "branch.$rb.reviewstep" "$step"
	restore_meta reviewreadstep
	restore_meta reviewstepworkspaces
else
	# whole and walk mode: rebuild the pristine review state (PR diff staged at the
	# lower bound) and replay your edits into the working tree; walk restores its
	# reading cursor on top.
	review_open_branch start "$src" "$tip"
	# Binary-safe apply via apply_review_patch (temp file, not command substitution).
	if ! git diff --quiet "$tip" "$saved"; then
		if ! apply_review_patch "$tip" "$saved"; then
			review_cancel_open || true
			die "could not restore your edits"
		fi
	fi
	review_stage_open "$lower"
	_continue_open=1

	if [ "$mode" = "walk" ]; then
		git config "branch.$rb.reviewmode" walk
		restore_meta reviewwalkstep
		restore_meta reviewwalkcount
		restore_meta reviewwalkkeys
		restore_meta reviewwalkfromdraft
		restore_meta reviewwalkbase
	fi
fi

restore_meta reviewsource
restore_meta reviewbase
restore_meta reviewbasecommit
restore_meta reviewrangefrom
restore_meta reviewtip
restore_meta reviewprevreviewed
restore_meta reviewlocal
restore_meta reviewreadonly
restore_meta reviewcomparebase
restore_meta reviewcomparetarget
restore_meta reviewreturn
restore_meta reviewdraft
if [ "${GIT_REVIEW_MANAGED_CHECKOUT:-0}" = 1 ]; then
	git config "branch.$rb.reviewworkspacepath" "$(git rev-parse --show-toplevel)"
fi
if [ "$mode" = step ]; then review_copy_edit_refs saved-edits edits "$src"; fi
if [ -n "${_live_draft:-}" ]; then
	mkdir -p "$(dirname "$_live_draft")"
	# Reserve the live path without overwriting a draft created during checkout.
	(set -C; cat "$_saved_draft" >"$_live_draft") || die "could not restore the draft at $_live_draft"
fi
git branch -D "$saved" >/dev/null
_continue_open=0
comments_transfer_commit || echo 'note: could not remove the comments rollback manifest' >&2
review_release_edit_refs || echo 'note: the original saved edit refs were kept' >&2
if [ -n "${_live_draft:-}" ] && cmp -s "$_saved_draft" "$_live_draft"; then
	rm -f "$_saved_draft" || echo 'note: the original archived draft was kept' >&2
fi

# As with Save, a failed final read must not invite a second mutation. Release
# custody first; only a complete envelope is an authoritative reply to clients.
comments_unlock
if [ "$porcelain" -eq 1 ]; then
	set +e
	(review_continued_state)
	_reply_status=$?
	set -e
	if [ "$_reply_status" -ne 0 ]; then
		echo 'note: review resumed; final state could not be read' >&2
	fi
else
	case "$mode" in
	step)
		echo "resumed review of $src — step $readstep/$count"
		show_commit "$selected" "$readstep" "$count"
		;;
	walk)
		# Report the restored cursor (including the keys-only filter).
		cur="$rb"
		review_config_init
		[ "$_review_config_ready" -eq 1 ] || die 'could not read review metadata'
		load_walk_review_meta "$cur"
		echo "resumed review of $src — walkthrough entry $walkstep/$total"
		show_walk_entry "$walkstep"
		;;
	*)
		echo "resumed review of $src — the staged diff is the PR; edit, then run git review finish"
		;;
	esac
fi
