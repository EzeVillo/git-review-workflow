#!/usr/bin/env sh
#
# git review finish — extract your review edits from the current review/* branch.
#
# By default it creates review-fixes/<branch> on top of the PR tip with your
# edits staged. With --onto-source it stages your edits on the PR branch itself
# instead. Either way the result stays local; review and commit it yourself.
#
# --abort undoes the last finish and drops you back on review/<branch> exactly
# where you were editing, the same way git merge --abort backs out a merge. To
# make that possible, a fresh finish first records an undo point (the review
# branch's HEAD, index and working tree, à la ORIG_HEAD) before it mutates
# anything, so --abort is a verbatim restore regardless of whole/step mode.
#
set -eu

prog="git review finish"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
	cat <<EOF
usage: $prog [--onto-source | --update-source] [--resume | --abort [--force]]
       $prog --workspace [<directory>] [--resume]
       $prog --destinations --porcelain

Extract your review edits from the current review/* branch.

  (default)        create review-fixes/<branch> on top of the PR tip and stage your edits
  --onto-source    instead, stage your edits on the PR branch itself
  --update-source  fast-forward the local PR branch to the reviewed tip, then stage
  --workspace      close the review and stage code and Shared in a new directory
  --resume         continue after resolving conflicts from a commit-by-commit replay
  --abort          undo the last finish and return to editing the review
  --force          with --abort, discard changes made to the finish branch since
EOF
}

onto=0
update_source=0
destinations=0
porcelain=0
resume=0
abort=0
force=0
workspace=''
workspace_requested=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--onto-source) onto=1 ;;
	--update-source) onto=1; update_source=1 ;;
	--destinations) destinations=1 ;;
	--porcelain) porcelain=1 ;;
	--resume) resume=1 ;;
	--abort) abort=1 ;;
	--force) force=1 ;;
	--workspace)
		[ "$workspace_requested" -eq 0 ] || die '--workspace given more than once'
		workspace_requested=1
		case "${2:-}" in
		''|-*) ;;
		*) shift; workspace=$1 ;;
		esac
		;;
	*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	esac
	shift
done

cur="$(git symbolic-ref --quiet --short HEAD || true)"
[ -n "$cur" ] || {
	echo "error: not on a branch" >&2
	exit 1
}

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

if [ "$workspace_requested" -eq 1 ]; then
	[ "$onto$destinations$porcelain$abort$force" = 00000 ] || die 'combine --workspace only with --resume'
	if [ "$resume" -eq 1 ]; then
		if [ -z "$workspace" ]; then close=--resume-close; else close=--close-resolved; fi
	else
		close=--close
	fi
	exec "$GIT_REVIEW_LIBEXEC/git-review-verbs/workspace" finish "$close" "$workspace"
fi

if [ "$destinations" -eq 1 ]; then
	[ "$onto$resume$abort$force$porcelain" = 00001 ] || die 'use --destinations with --porcelain alone'
	finish_destinations "$cur"
	exit
fi
if [ "$porcelain" -eq 1 ] || { [ "$resume" -eq 1 ] && [ "$update_source" -eq 1 ]; }; then
	die 'invalid finish options'
fi

if [ "$resume$abort$force" = 000 ] && [ -n "$(review_config_get "branch.$cur.reviewworkspacepath" || true)" ]; then
	case "$onto$update_source" in
	11) close=--close-update-source ;;
	10) close=--close-onto-source ;;
	*) close=--close ;;
	esac
	exec "$GIT_REVIEW_LIBEXEC/git-review-verbs/workspace" finish "$close" ''
fi

# Stage the same bytes as the ordinary finish, but keep the real index (and
# its unmerged entries) intact until the candidate passes the conflict check.
stage_finish_resolution() (
	index=$(git rev-parse --git-path index) || exit 1
	lock=$index.lock
	if ! (set -C; : >"$lock") 2>/dev/null; then
		echo "error: could not stage the finish resolution; the Git index is locked" >&2
		exit 1
	fi
	candidate=
	trap 'rm -f "$lock" "$lock.lock" ${candidate:+"$candidate"}' 0
	trap 'exit 1' 1 2 15
	cp -p "$index" "$lock" || exit 1
	export GIT_INDEX_FILE="$lock"
	unmerged=$(git -c core.quotePath=true ls-files --unmerged --full-name) || exit 1
	review_worktree_files stage || exit 1

	# Git checks added lines and respects conflict-marker-size. A whitespace
	# diagnostic alone is not a conflict and must not block an otherwise valid
	# resolution. Suppress whitespace rules by default; paths can override them.
	if diagnostics=$(LC_ALL=C git -c core.whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab \
		diff --cached --check --no-color --no-ext-diff --no-textconv --no-relative "$tip" --); then
		:
	elif [ "$?" -ne 2 ]; then
		echo "error: could not check the finish resolution" >&2
		exit 1
	fi
	markers=$(printf '%s\n' "$diagnostics" | sed -n '/:[0-9][0-9]*: leftover conflict marker$/p')
	if [ -n "$markers" ]; then
		echo "error: resolve the remaining conflict markers before continuing the finish:" >&2
		printf '%s\n' "$markers" >&2
		exit 1
	fi

	# A binary conflict can leave stage 2 in the working tree without markers.
	# Keeping that version needs an explicit git add/rm, otherwise it is
	# indistinguishable from leaving the conflict untouched.
	if [ -n "$unmerged" ]; then
		candidate=$(mktemp "$lock.XXXXXX") || exit 1
		git -c core.quotePath=true ls-files --stage --full-name >"$candidate" || exit 1
		unconfirmed=$(printf '%s\n' "$unmerged" | awk -F '\t' '
			FILENAME == "-" {
				split($1, entry, " ")
				paths[$2] = 1
				if (entry[3] == 2) ours[$2] = entry[1] " " entry[2]
				next
			}
			$2 in paths {
				split($1, entry, " ")
				if (ours[$2] == entry[1] " " entry[2]) print $2
				delete paths[$2]
			}
			END {
				for (path in paths)
					if (!(path in ours)) print path
			}
		' - "$candidate") || exit 1
		if [ -n "$unconfirmed" ]; then
			echo "error: confirm the resolution of these paths with git add or git rm before continuing the finish:" >&2
			printf '%s\n' "$unconfirmed" >&2
			exit 1
		fi
		rm -f "$candidate" || exit 1
	fi

	# The lock path may immediately belong to another writer after publication.
	trap - 0 1 2 15
	if ! mv "$lock" "$index"; then
		rm -f "$lock" "$lock.lock"
		exit 1
	fi
)

# record_exit: once a finish has produced its branch ($1), snapshot that branch's
# HEAD and working tree onto the review branch's config so a later --abort can tell
# whether you have changed it since — and tell you up front that abort will not
# silently throw that work away. Recorded only on a completed finish, never for one
# stopped mid-conflict.
record_exit() {
	_finish_comments_failed=0
	comments_finish_complete "$cur" "$1" || _finish_comments_failed=1
	_finish_exit_tree=$(review_snapshot_worktree) || die 'could not capture the finish destination for undo'
	git config "branch.$cur.reviewundoouthead" "$(git rev-parse HEAD)"
	git config "branch.$cur.reviewundoouttree" "$_finish_exit_tree"
	echo "note: commits you make on $1 are kept, and uncommitted edits too while you stay on $1$(advice_suffix ' — git review finish --abort refuses to discard them without --force')." >&2
	if [ "$_finish_comments_failed" -ne 0 ]; then exit 1; fi
}

# --abort restores the undo point of the finish being undone. Runs before the
# review/* check on purpose: after a finish, HEAD sits on review-fixes/<branch>
# (or the PR branch, with --onto-source), never on review/<branch> — and abort
# may run from any other branch too; resolve_abort_target picks the target.
#
# resolve_abort_target: set asrc + rb for the finish to undo, or exit.
# 1) HEAD on review-fixes/<src>, review/<src>, or the PR branch with an undo
#    on review/<that name> → that target.
# 2) Else every review/* with reviewundohead (same universe as list's finish
#    rows). Zero → error. One → that one. Several → prefer a completed finish
#    (reviewundoouthead set: pending after a successful finish); if exactly
#    one completed, use it; otherwise refuse and list them (no silent pick).
resolve_abort_target() {
	asrc=""
	rb=""
	case "$cur" in
	review-fixes/*)
		asrc="${cur#review-fixes/}"
		rb="review/$asrc"
		;;
	review/*)
		asrc="${cur#review/}"
		rb="review/$asrc"
		;;
	*)
		# Onto-source leaves HEAD on the PR branch itself (<src>), not on
		# review-fixes/*. Only accept that name when review/<src> has an undo.
		if [ -n "$(git config "branch.review/$cur.reviewundohead" || true)" ]; then
			asrc="$cur"
			rb="review/$asrc"
		fi
		;;
	esac
	if [ -n "$rb" ] && [ -n "$(git config "branch.$rb.reviewundohead" || true)" ]; then
		return 0
	fi

	# HEAD did not name a live undo (wrong branch, or develop after walking
	# away). Scan the repo. Newline-delimited so paths with spaces stay intact.
	n=0
	first=""
	completed_n=0
	completed=""
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		case "$ref" in
		review/*) ;;
		*) continue ;;
		esac
		[ -n "$(git config "branch.$ref.reviewundohead" || true)" ] || continue
		n=$((n + 1))
		[ -z "$first" ] && first="$ref"
		if [ -n "$(git config "branch.$ref.reviewundoouthead" || true)" ]; then
			completed_n=$((completed_n + 1))
			completed="$ref"
		fi
	done <<EOF
$(git for-each-ref --format='%(refname:short)' refs/heads)
EOF

	if [ "$n" -eq 0 ]; then
		echo "error: no finish to abort" >&2
		exit 1
	fi
	if [ "$n" -eq 1 ]; then
		rb="$first"
		asrc="${rb#review/}"
		return 0
	fi
	# Several undos: a completed finish (pending) is the usual one to undo from
	# another branch; mid-conflict undos lack outhead and need the review tree.
	if [ "$completed_n" -eq 1 ]; then
		rb="$completed"
		asrc="${rb#review/}"
		return 0
	fi

	echo "error: multiple finishes to abort; switch to the branch of the one you want and retry:" >&2
	while IFS= read -r ref; do
		[ -n "$ref" ] || continue
		case "$ref" in
		review/*) ;;
		*) continue ;;
		esac
		[ -n "$(git config "branch.$ref.reviewundohead" || true)" ] || continue
		_src="${ref#review/}"
		_kind="$(git config "branch.$ref.reviewundokind" || echo fixes)"
		_resume="$(git config "branch.$ref.reviewresume" || true)"
		if [ "$_resume" = "conflict" ]; then
			echo "  $ref  (finish conflict — switch to this branch)" >&2
		elif [ "$_kind" = "onto-source" ]; then
			echo "  $ref  (finish pending — switch to $_src)" >&2
		else
			echo "  $ref  (finish pending — switch to review-fixes/$_src)" >&2
		fi
	done <<EOF
$(git for-each-ref --format='%(refname:short)' refs/heads)
EOF
	exit 1
}

do_abort() {
	resolve_abort_target

	head="$(git config "branch.$rb.reviewundohead" || true)"
	[ -n "$head" ] || {
		echo "error: no finish to abort (no undo point for $rb)" >&2
		exit 1
	}
	git rev-parse --verify --quiet "refs/heads/$rb" >/dev/null || {
		echo "error: $rb is gone; cannot restore the review" >&2
		exit 1
	}

	# The pre-finish index/working tree live only in refs/review-undo/<src>/. If
	# those refs were deleted by hand while the config undo record survived, resolve
	# them up front and bail with a clear pointer — otherwise rev-parse dies below
	# with an opaque "Needed a single revision", possibly after reset --hard has
	# already mutated the tree.
	idxtree="$(git rev-parse --verify --quiet "refs/review-undo/$asrc/index^{tree}" || true)"
	wttree="$(git rev-parse --verify --quiet "refs/review-undo/$asrc/worktree^{tree}" || true)"
	if [ -z "$idxtree" ] || [ -z "$wttree" ]; then
		echo "error: the undo snapshot for $rb is gone (refs/review-undo/$asrc deleted); cannot restore the review." >&2
		echo "the leftover undo record is stale — run git review clean $asrc to clear it." >&2
		exit 1
	fi

	kind="$(git config "branch.$rb.reviewundokind" || echo fixes)"
	srccreated="$(git config "branch.$rb.reviewundosrccreated" || echo 0)"
	editstep="$(git config "branch.$rb.reviewundoeditstep" || true)"
	editold="$(git config "branch.$rb.reviewundoeditold" || true)"

	# Guard: a finish leaves your edits on the branch it produced (review-fixes, or
	# the PR branch with --onto-source). Changing that branch since — new commits, or
	# an edited working tree — would have --abort throw that work away; like
	# git branch -d, refuse and point at it, with --force tearing it down anyway.
	# Skipped when no exit state was recorded: mid-conflict never produced the
	# branch, so --abort there discards the resolution, like git rebase --abort.
	outhead="$(git config "branch.$rb.reviewundoouthead" || true)"
	outtree="$(git config "branch.$rb.reviewundoouttree" || true)"
	source_before="$(git config "branch.$rb.reviewundosourcebefore" || true)"
	source_target="$(git config "branch.$rb.reviewtip" || true)"
	source_move="$(git config "branch.$rb.reviewundosourcemove" || true)"
	source_now=''
	if [ -n "$source_before" ] && [ "$source_move" = 1 ]; then
		source_now="$(git rev-parse --verify --quiet "refs/heads/$asrc" || true)"
		if [ "$source_now" != "$source_before" ] && [ "$source_now" != "$source_target" ] && [ "$force" -eq 0 ] && [ "$cur" = "$asrc" ]; then
			die "$asrc has changes since the finish; aborting would discard them. Use --force to discard."
		fi
		if [ -z "$source_now" ] && [ -n "$outhead" ]; then die "the PR branch $asrc was deleted after finish"; fi
		if [ "$source_now" = "$source_target" ] || [ -n "$outhead" ]; then finish_require_source_worktree "$asrc"; fi
	fi
	if [ "$force" -eq 0 ] && [ -n "$outhead" ]; then
		if [ "$kind" = "onto-source" ]; then
			outbranch="$asrc"
		else
			outbranch="review-fixes/$asrc"
		fi
		diverged=0
		nowhead="$(git rev-parse --verify --quiet "refs/heads/$outbranch" || true)"
		if [ -n "$nowhead" ] && [ "$nowhead" != "$outhead" ]; then
			diverged=1
		fi
		# Only the working tree of the branch we are actually on is meaningful; if
		# you switched away, fall back to the committed-divergence check above.
		if [ "$diverged" -eq 0 ] && [ "$cur" = "$outbranch" ] && [ -n "$outtree" ] &&
		[ "$(review_snapshot_worktree)" != "$outtree" ]; then
			diverged=1
		fi
		if [ "$diverged" -eq 1 ]; then
			echo "error: $outbranch has changes since the finish; aborting would discard them." >&2
			echo "your work stays on $outbranch — switch there to keep it, or rerun with --force to discard." >&2
			exit 1
		fi
	fi

	rewind_source=0
	if [ -n "$source_before" ] && [ "$source_move" = 1 ] &&
		{ [ "$source_now" = "$source_target" ] || { [ "$force" -eq 1 ] && [ -n "$outhead" ]; }; }; then
		rewind_source=1
	fi
	set -- "$head" "$wttree"
	if [ "$cur" != "$rb" ] || [ "$rewind_source" -eq 1 ]; then
		set -- "$@" "refs/heads/$rb"
	fi
	if [ "$rewind_source" -eq 1 ] && [ "$cur" != "$asrc" ]; then
		set -- "$@" "$source_now"
	fi
	review_guard_checkout_paths "$@" || exit 1

	# Return to the review branch and restore the exact pre-finish state: HEAD, then
	# the working tree (read-tree -m -u brings back additions/edits/deletions and
	# captured untracked files), then the index. Skip the checkout when already on
	# the review branch (mid-conflict abort): the index may hold unmerged entries a
	# same-branch checkout chokes on; reset --hard below clears them.
	comments_lock_branch "$rb" || exit 1
	trap 'comments_unlock' 0
	comments_finish_undo "$rb" || exit 1
	source_rewound=0
	if [ "$rewind_source" -eq 1 ]; then
		# Hold the PR checkout until the guarded ref update is done. Releasing
		# it first would let another worktree check out the tip we are rewinding.
		if [ "$cur" != "$asrc" ]; then
			review_checkout_tree "$source_now" switch -q --no-overwrite-ignore "$asrc"
			# The intermediate checkout may have created another obstruction.
			review_guard_checkout_paths "refs/heads/$rb" "$head" "$wttree" || exit 1
		fi
		[ "$(git symbolic-ref --quiet HEAD || true)" = "refs/heads/$asrc" ] ||
			die "could not take over the PR branch $asrc to undo finish"
		git update-ref "refs/heads/$asrc" "$source_before" "$source_now"
		cur=$asrc
		source_rewound=1
	fi
	if [ "$cur" != "$rb" ]; then
		if ! review_checkout_tree "refs/heads/$rb" switch -q --discard-changes --no-overwrite-ignore "$rb"; then
			if [ "$source_rewound" -eq 1 ] &&
				[ "$(git symbolic-ref --quiet HEAD || true)" = "refs/heads/$asrc" ]; then
				git update-ref "refs/heads/$asrc" "$source_now" "$source_before"
			fi
			exit 1
		fi
		# The checkout hook can write files before the undo trees are restored.
		review_guard_checkout_paths "$head" "$wttree" || exit 1
	fi
	review_checkout_tree "$head" reset -q --hard "$head"
	review_checkout_tree "$wttree" read-tree -m -u "$wttree"
	git read-tree "$idxtree"

	# Restore the current step's banked edit ref to what it was before finish
	# banked it (or remove it if finish was the one that created it).
	if [ -n "$editstep" ]; then
		eref="refs/review-edits/$asrc/$editstep"
		if [ "$editold" = "none" ] || [ -z "$editold" ]; then
			git update-ref -d "$eref" 2>/dev/null || true
		else
			git update-ref "$eref" "$editold"
		fi
	fi

	# Drop the branch finish created, leaving only review/<branch>. --onto-source
	# deletes the PR branch when finish created it; when it pre-existed, finish only
	# staged onto it, so reset it back to the reviewed tip ($outhead) — discarding
	# any commits made since, which is what reaching here (untouched, or --force)
	# means. Default (fixes) only deletes review-fixes/* when this finish created it
	# (srccreated=1), never a pre-existing one. Skipped when no exit state was
	# recorded (mid-conflict never touched the destination).
	if [ "$kind" = "onto-source" ]; then
		if [ "$srccreated" = "1" ] &&
			git rev-parse --verify --quiet "refs/heads/$asrc" >/dev/null; then
			git branch -D "$asrc" >/dev/null
		elif [ -n "$outhead" ] && [ -z "$source_before" ] &&
			git rev-parse --verify --quiet "refs/heads/$asrc" >/dev/null; then
			git update-ref "refs/heads/$asrc" "$outhead"
		fi
	elif [ "$srccreated" = "1" ] &&
		git rev-parse --verify --quiet "refs/heads/review-fixes/$asrc" >/dev/null; then
		git branch -D "review-fixes/$asrc" >/dev/null
	fi

	# Clear a mid-conflict marker (finish may have been aborted part-way) and the
	# whole undo record.
	git config --unset "branch.$rb.reviewresume" 2>/dev/null || true
	for k in reviewundohead reviewundokind reviewundosrccreated \
		reviewundoeditstep reviewundoeditold reviewundoouthead reviewundoouttree reviewundosourcebefore reviewundosourcemove; do
		git config --unset "branch.$rb.$k" 2>/dev/null || true
	done
	review_branch_refs undo "$asrc" |
		while read -r ref; do
			git update-ref -d "$ref"
		done

	echo "aborted finish; back on $rb — keep editing, then run git review finish"
}

if [ "$abort" -eq 1 ]; then
	if [ "$resume" -eq 1 ] || [ "$onto" -eq 1 ]; then
		echo "error: --abort takes no other options" >&2
		exit 1
	fi
	if [ -n "$(review_config_get "branch.$cur.reviewworkspacefinish" || true)$(review_config_get "branch.$cur.reviewworkspacepending" || true)" ]; then
		trap 'comments_unlock' 0
		trap 'exit 1' 1 2 15
		comments_lock_branch "$cur" || exit 1
		comments_finish_undo "$cur" || exit 1
		git config --unset "branch.$cur.reviewworkspacepending" || true
		git config --unset "branch.$cur.reviewworkspacefinish" || true
		printf 'aborted workspace finish; review reopened on %s\n' "$cur"
		exit 0
	fi
	do_abort
	exit 0
fi

if [ "$force" -eq 1 ]; then
	echo "error: --force only applies to --abort" >&2
	exit 1
fi

if [ -n "$(review_config_get "branch.$cur.reviewworkspacefinish" || true)" ]; then
	require_not_pending_finish "$cur"
fi
if [ "$resume" -eq 0 ] && [ -n "$(review_config_get "branch.$cur.reviewworkspacepending" || true)" ]; then
	require_not_finish_conflict "$cur"
fi

if [ "$resume" -eq 1 ]; then
	if [ -n "$(review_config_get "branch.$cur.reviewworkspacepending" || true)" ]; then
		exec "$GIT_REVIEW_LIBEXEC/git-review-verbs/workspace" finish --resume-close ''
	fi
	_resume_comments_context=''
	for _resume_review in $(git for-each-ref --format='%(refname:short)' refs/heads/review/); do
		comments_preflight_branch "$_resume_review" || exit 1
		[ -n "$cc_session" ] || continue
		if [ "$(comments_field "$cc_dir/delivery" state)" = pending ] && [ "$(comments_field "$cc_dir/delivery" branch)" = "$cur" ]; then
			if [ -n "$_resume_comments_context" ]; then comments_error 'more than one comments delivery is pending'; exit 1; fi
			_resume_comments_context=$cc_context
		fi
	done
	if [ -n "$_resume_comments_context" ]; then
		trap 'comments_unlock' 0
		comments_prepare "$_resume_comments_context" 0 0 '' ''
		exit $?
	fi
fi

case "$cur" in
review/*) ;;
*)
	echo "error: not on a review/* branch (HEAD is $cur)" >&2
	exit 2
	;;
esac

src="$(git config "branch.$cur.reviewsource" || true)"
tip="$(git config "branch.$cur.reviewtip" || true)"
if [ -z "$src" ] || [ -z "$tip" ]; then
	if [ -z "$src" ]; then
		echo "error: missing review metadata; was $cur created with git review start? Switch away, then delete it with 'git branch -D $cur'." >&2
	else
		echo "error: missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'." >&2
	fi
	exit 1
fi

# A compare review (git review compare) has no writable source branch — it only
# stages a diff to read — so there is nothing to extract. Refuse explicitly rather
# than producing an empty or meaningless review-fixes branch.
if [ "$(git config "branch.$cur.reviewreadonly" || true)" = "1" ]; then
	echo "error: $cur is a read-only compare review; there is nothing to write back" >&2
	echo "compare just stages a diff to read — run git review clean ${cur#review/} when done." >&2
	exit 1
fi

# Provides load_step_review_meta (the metadata guard other step commands share)
# and apply_review_patch (binary-safe patch apply, used by both the step replay
# and the final extract onto review-fixes / the PR branch).
# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

comments_lock_branch "$cur" || exit 1
trap 'comments_unlock' 0
trap 'exit 1' 1 2 15

# A step review records reviewmode=step alongside reviewstart/reviewcount/
# reviewstep; a whole review records none of them (walk's mirror keys are
# reviewwalk* — see AGENTS.md's state model for why the two never share a key). If
# reviewmode were lost to a hand-edit but the step keys survived, falling through
# to the whole-mode tail below would diff the step commit — not the tip — against
# the tip, silently reversing later commits into the extracted fix. Report the
# inconsistency instead.
mode="$(git config "branch.$cur.reviewmode" || true)"
if [ "$mode" != "step" ]; then
	for k in reviewstart reviewcount reviewstep reviewreadstep reviewstepworkspaces; do
		[ -z "$(git config "branch.$cur.$k" || true)" ] || {
			echo "error: corrupt review metadata: $cur has step-review keys but reviewmode is not 'step'. Discard the review with 'git review abort'." >&2
			exit 1
		}
	done
fi
# The mirror guard for walk mode: reviewwalkstep/reviewwalkcount with any other
# mode means hand-edited or corrupt metadata. Walk needs no special extraction —
# its edits live in the working tree — so it correctly falls through to the
# whole-mode tail below.
if [ "$mode" != "walk" ]; then
	for k in reviewwalkstep reviewwalkcount reviewwalkkeys reviewwalkfromdraft reviewwalkbase; do
		[ -z "$(git config "branch.$cur.$k" || true)" ] || {
			echo "error: corrupt review metadata: $cur has walkthrough keys but reviewmode is not 'walk'. Discard the review with 'git review abort'." >&2
			exit 1
		}
	done
fi

# record_undo: snapshot everything finish is about to mutate so --abort can put
# it back verbatim — the review branch's HEAD, its index, and its working tree
# (captured via a throwaway index so brand-new untracked edits are included).
# The trees are pinned under refs/review-undo/<src>/ so gc cannot drop them.
record_undo() {
	wttree=$(review_snapshot_worktree) || die 'could not capture the review working tree for undo'
	idxtree="$(git write-tree)"
	orig="$(git rev-parse HEAD)"

	git update-ref "refs/review-undo/$src/head" "$orig"
	git update-ref "refs/review-undo/$src/index" \
		"$(git commit-tree "$idxtree" -m 'git review finish undo (index)')"
	git update-ref "refs/review-undo/$src/worktree" \
		"$(git commit-tree "$wttree" -m 'git review finish undo (worktree)')"

	git config "branch.$cur.reviewundohead" "$orig"
	if [ "$onto" -eq 1 ]; then
		git config "branch.$cur.reviewundokind" "onto-source"
		if [ "$update_source" -eq 1 ]; then
			git config "branch.$cur.reviewundosourcebefore" "$finish_source_head"
			git update-ref "refs/review-undo/$src/source-before" "$finish_source_head"
		fi
		# Remember whether the PR branch already existed, so --abort only deletes
		# it when finish was the one that created it.
		if git rev-parse --verify --quiet "refs/heads/$src" >/dev/null; then
			git config "branch.$cur.reviewundosrccreated" 0
		else
			git config "branch.$cur.reviewundosrccreated" 1
		fi
	else
		git config "branch.$cur.reviewundokind" "fixes"
		# finish creates review-fixes/<src> (it refuses when that branch already
		# exists, before record_undo). Mark created so --abort only deletes the
		# branch this finish made, never a pre-existing review-fixes/* someone
		# left around.
		git config "branch.$cur.reviewundosrccreated" 1
	fi

	# In step mode finish overwrites the current step's banked edit ref; record
	# its prior value (or "none") so --abort restores exactly that.
	if [ "$mode" = "step" ]; then
		ustep="$(git config "branch.$cur.reviewstep" || echo 1)"
		git config "branch.$cur.reviewundoeditstep" "$ustep"
		uold="$(git rev-parse --verify --quiet "refs/review-edits/$src/$ustep" || true)"
		git config "branch.$cur.reviewundoeditold" "${uold:-none}"
	else
		git config --unset "branch.$cur.reviewundoeditstep" 2>/dev/null || true
		git config --unset "branch.$cur.reviewundoeditold" 2>/dev/null || true
	fi
}

# A finish records an undo point that lives until --abort (or the review is torn
# down). If one already exists when starting fresh, a prior finish on this branch
# is unresolved: finishing again would clobber the undo point's HEAD/index/
# worktree snapshots while leaving the old exit state behind, so a later --abort
# would restore a mix of the two and could delete the earlier finish's branch.
# Refuse like git refuses a second merge/rebase in progress, and point at the way
# out.
if [ "$resume" -eq 0 ] && [ -n "$(git config "branch.$cur.reviewundohead" || true)" ]; then
	if [ "$(git config "branch.$cur.reviewresume" || true)" = "conflict" ]; then
		echo "error: a finish on $cur stopped at a conflict and is still pending." >&2
		echo "resolve the markers and run git review finish --resume, or git review finish --abort to back out." >&2
	else
		echo "error: a previous finish on $cur has not been resolved." >&2
		echo "run git review finish --abort to undo it (or git review abort to drop the whole review) before finishing again." >&2
	fi
	exit 1
fi

# Refuse a pre-existing review-fixes/<src> *before* recording undo. Checking after
# undo left a trapped session: finish --abort used to delete that pre-existing
# branch (treating it as "created by finish") and destroy prior work.
if [ "$resume" -eq 0 ] && [ "$onto" -eq 0 ]; then
	if git rev-parse --verify --quiet "refs/heads/review-fixes/$src" >/dev/null; then
		echo "error: review-fixes/$src already exists; remove it first" >&2
		exit 1
	fi
fi
if [ "$resume" -eq 0 ] && [ "$onto" -eq 1 ]; then
	finish_check_source "$src" "$tip" "$update_source"
	if [ "$update_source" -eq 1 ]; then review_guard_checkout_paths "$finish_source_head" || exit 1; fi
fi
_finish_loaded_step=0
if [ "$resume" -eq 0 ]; then
	review_guard_checkout_paths "$tip" || exit 1
	if [ "$mode" = step ] && [ -n "$(review_config_get "branch.$cur.reviewstepworkspaces" || true)" ]; then
		load_step_review_meta "$cur"
		review_refresh_step_workspaces || die 'could not capture edits from the step workspaces'
		_finish_loaded_step=1
	fi
fi

# Only a fresh finish records an undo point; --resume continues the same finish
# and must keep the point its first invocation took.
if [ "$resume" -eq 0 ]; then
	record_undo
fi

# In commit-by-commit mode, bank the current commit's edits, move to the tip and
# replay every banked edit there, so what follows sees the same state as a normal
# whole-PR review. With --resume we skip the replay: the working tree already
# holds the resolved edits.
if [ "$mode" = "step" ] && [ "$resume" -eq 0 ]; then
	if [ "$_finish_loaded_step" -eq 0 ]; then load_step_review_meta "$cur"; fi
	cstep="$(printf '%s\n' "$commits" | sed -n "${step}p")"
	review_worktree_files stage
	tree="$(git write-tree)"
	if [ "$tree" != "$(git rev-parse "$cstep^{tree}")" ]; then
		edit="$(git commit-tree "$tree" -p "$cstep" -m "review edits step $step")"
		git update-ref "refs/review-edits/$src/$step" "$edit"
	else
		# Reverting the step back to a clean tree must clear any edits we banked
		# earlier, or they resurrect in the replay below.
		git update-ref -d "refs/review-edits/$src/$step" 2>/dev/null || true
	fi
	review_checkout_tree "$tip" reset -q --hard "$tip"
	conflict=0
	i=1
	while [ "$i" -le "$count" ]; do
		ref="refs/review-edits/$src/$i"
		if git rev-parse --verify --quiet "$ref" >/dev/null; then
			# Keep going on conflict so every edit lands; conflicts are left as
			# markers for the user to resolve. apply_review_patch routes the diff
			# through a file so a binary banked edit is not corrupted.
			apply_review_patch "${ref}^" "$ref" --3way ||
				conflict=1
		fi
		i=$((i + 1))
	done
	if [ "$conflict" -eq 1 ]; then
		git config "branch.$cur.reviewresume" conflict
		echo "conflict: some banked edits overlap the PR tip." >&2
		echo "resolve the conflicts, then run:" >&2
		echo "    git review finish --resume" >&2
		echo "(destination is remembered from this finish; --onto-source is not required again.)" >&2
		echo "(git review finish --abort here discards the resolution, like git rebase --abort.)" >&2
		exit 1
	fi
elif [ "$resume" -eq 1 ]; then
	if [ "$(git config "branch.$cur.reviewresume" || true)" != "conflict" ]; then
		echo "error: nothing to resume" >&2
		exit 1
	fi
	# Destination was pinned when record_undo ran; never re-derive it from the
	# CLI flag alone. Forcing from reviewundokind means a plain --resume after
	# finish --onto-source still lands on the PR branch (and the reverse cannot
	# silently create review-fixes/* while abort still thinks onto-source).
	_kind="$(git config "branch.$cur.reviewundokind" || echo fixes)"
	case "$_kind" in
	onto-source) onto=1 ;;
	fixes) onto=0 ;;
	*)
		echo "error: corrupt review metadata: reviewundokind is '$_kind'. Discard the finish with 'git review finish --abort'." >&2
		exit 1
		;;
	esac
	if [ "$onto" -eq 1 ]; then
		_expected_source=$(git config "branch.$cur.reviewundosourcebefore" || true)
		if [ -n "$_expected_source" ]; then update_source=1; fi
		finish_check_source "$src" "$tip" "$update_source"
		if [ "$update_source" -eq 1 ] && [ "$finish_source_head" != "$_expected_source" ]; then
			die "local $src changed during finish"
		fi
		if [ "$update_source" -eq 1 ]; then review_guard_checkout_paths "$finish_source_head" || exit 1; fi
	fi
	stage_finish_resolution || exit 1
	git config --unset "branch.$cur.reviewresume" || true
fi

# Detect real review edits against the PR tip *before* folding them into a
# session commit: committing an unchanged staged tree moved HEAD off the base and
# broke walk, and the old early-exit left you stranded on review/* "in progress"
# with no review-fixes destination. Compare the staged tree to the tip and only
# commit when they differ; finish always lands on the destination branch and
# keeps the undo point either way, including the empty-extract case
# (review-fixes/<src> at the tip with nothing staged).
if [ "$resume" -eq 0 ]; then
	review_worktree_files stage
fi
has_edits=1
if git diff --cached --quiet "$tip"; then
	has_edits=0
else
	git commit -q -m "review session ($src)"
fi

# A commit hook may have created a new obstruction after the initial check.
# Resuming a conflict also reaches here without the fresh Finish preflight.
if [ "$has_edits" -eq 1 ] || [ "$resume" -eq 1 ]; then
	_finish_checkout=$tip
	if [ "$update_source" -eq 1 ]; then _finish_checkout=$finish_source_head; fi
	review_guard_checkout_paths "$_finish_checkout" || exit 1
fi

if [ "$onto" -eq 1 ]; then
	if [ "$update_source" -eq 1 ]; then
		# With no corrections the index already holds the tip's tree. Align the
		# review HEAD so switching to the older PR does not carry a staged diff.
		if [ "$has_edits" -eq 0 ]; then
			git reset -q --soft "$tip"
		fi
		# Claim the branch through Git before moving it. Its checkout protects
		# the other worktrees while Git fast-forwards the ref, index and files.
		if ! review_checkout_tree "$finish_source_head" switch -q --no-overwrite-ignore "$src"; then
			die "could not switch to $src; recover with git review finish --abort"
		fi
		if [ "$(git symbolic-ref --quiet HEAD || true)" != "refs/heads/$src" ] ||
			[ "$(git rev-parse --verify HEAD)" != "$finish_source_head" ]; then
			die "local $src changed during finish; recover with git review finish --abort"
		fi
		git config "branch.$cur.reviewundosourcemove" 1
		review_guard_nested_worktrees "$tip" || exit 1
		# Branch merge options can request a squash, which succeeds without moving HEAD.
		if ! review_checkout_tree "$tip" -c merge.autostash=false merge --ff-only --no-squash --no-overwrite-ignore --quiet "$tip" ||
			[ "$(git symbolic-ref --quiet HEAD || true)" != "refs/heads/$src" ] ||
			[ "$(git rev-parse --verify HEAD)" != "$tip" ]; then
			die "could not fast-forward $src; recover with git review finish --abort"
		fi
	elif git rev-parse --verify --quiet "refs/heads/$src" >/dev/null; then
		if [ "$(git rev-parse --verify "refs/heads/$src")" != "$tip" ]; then
			echo "error: local $src is not at the reviewed tip; move or delete it first" >&2
			echo "the undo point is still recorded — recover with: git review finish --abort" >&2
			exit 1
		fi
		review_checkout_tree "$tip" switch -q --no-overwrite-ignore "$src"
	else
		review_checkout_tree "$tip" switch -q --no-overwrite-ignore -c "$src" "$tip"
	fi
	if [ "$has_edits" -eq 1 ]; then
		apply_review_patch "$tip" "$cur" --index --3way || {
			echo "error: could not apply review changes onto $src" >&2
			echo "the undo point is still recorded — recover with: git review finish --abort" >&2
			exit 1
		}
		record_exit "$src"
		echo "$src ready with your edits staged — review and commit"
	else
		record_exit "$src"
		echo "no review changes to apply; on $src at the reviewed tip" >&2
	fi
else
	fb="review-fixes/$src"
	# Pre-checked before record_undo; re-check in case something raced, and keep
	# the undo so --abort can restore the session without touching $fb (srccreated
	# is 1 only for the branch *this* finish creates — which it has not yet).
	git rev-parse --verify --quiet "refs/heads/$fb" >/dev/null && {
		echo "error: $fb already exists; remove it first" >&2
		echo "the undo point is still recorded — recover with: git review finish --abort" >&2
		exit 1
	}
	review_checkout_tree "$tip" switch -q --no-overwrite-ignore -c "$fb" "$tip"
	if [ "$has_edits" -eq 1 ]; then
		apply_review_patch "$tip" "$cur" --index --3way || {
			echo "error: could not apply review changes onto $fb" >&2
			echo "the undo point is still recorded — recover with: git review finish --abort" >&2
			exit 1
		}
		record_exit "$fb"
		echo "$fb ready with your edits staged — review and commit"
	else
		record_exit "$fb"
		echo "no review changes to apply; on $fb at the reviewed tip" >&2
	fi
fi
