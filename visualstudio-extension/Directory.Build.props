<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Keep in sync with contracts/client-product-surface.yaml and root VERSION clients. -->
    <GitReviewClientVersion>0.1.0</GitReviewClientVersion>
  </PropertyGroup>
</Project>
