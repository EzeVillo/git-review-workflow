#!/usr/bin/env sh
#
# git review save — pause the review on the current branch and put it aside.
#
# review/<branch> becomes review-saved/<branch>, carrying everything needed to
# resume exactly where you left off:
#   whole mode  the staged PR diff and your uncommitted edits, captured as a
#               commit whose diff against the tip is just your edits.
#   step mode   the step you are on, its edits, and every edit banked on other
#               commits — the banked-edit refs move out of refs/review-edits/
#               (which git review clean prunes) into refs/review-saved-edits/, so
#               a clean never touches a saved review.
#
set -eu

prog="git review save"

usage() {
	cat <<EOF
usage: $prog [--porcelain]

Pause the review on the current review/* branch: stash it as review-saved/<branch>
and return to the branch you started from. Resume it later with git review continue.
  --porcelain  return the resulting panel state instead of human output
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

porcelain=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h) usage; exit 0 ;;
	--porcelain) porcelain=1 ;;
	*) echo "error: unexpected argument $1" >&2; usage >&2; exit 1 ;;
	esac
	shift
done

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

review_close_init
case "$cur" in
review/*) ;;
*)
	echo "error: not on a review/* branch (HEAD is ${cur:-detached})" >&2
	exit 2
	;;
esac

# A mid-finish conflict keeps undo/resume on this branch; saving would rename it
# away and leave refs/review-undo orphaned with conflict markers banked as edits.
require_not_finish_conflict "$cur"

# A completed finish leaves reviewundohead while you sit on review-fixes (or the PR
# branch); saving from a hand-switched review/* would rename the branch that owns
# the undo and orphan review-fixes / the undo point.
require_not_pending_finish "$cur"

review_config_read "branch.$cur.reviewsource"
src=$_review_config_value
review_config_read "branch.$cur.reviewtip"
tip=$_review_config_value
if [ -z "$src" ] || [ -z "$tip" ]; then
	if [ -z "$src" ]; then
		die "missing review metadata; was $cur created with git review start? Switch away, then delete it with 'git branch -D $cur'."
	fi
	die "missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'."
fi

saved="review-saved/$src"
git rev-parse --verify --quiet "refs/heads/$saved" >/dev/null &&
	die "$saved already exists; resume it with git review continue or discard it with git review forget --saved $src"
review_require_branch_slot "$saved"

save_cleanup() {
	if [ -n "${_save_draft_copy:-}" ]; then rm -f "$_save_draft_copy" || true; fi
	comments_transfer_rollback || true
	comments_unlock
	if [ "$1" -ne 0 ] && [ "${_save_reserved:-0}" -eq 1 ]; then
		echo "error: saving $src stopped after reserving $saved; the original review was kept" >&2
	fi
}
comments_lock_branch "$cur" || exit 1
trap 'save_cleanup "$?"' 0
trap 'exit 1' 1 2 15
comments_transfer_preflight "$cur" "$saved" || exit 1

review_config_read "branch.$cur.reviewmode" whole
mode=$_review_config_value

# Where to return to: the branch you started from, else the base — like abort.
review_config_read "branch.$cur.reviewreturn"
ret=$_review_config_value
review_config_read "branch.$cur.reviewbase"
base=$_review_config_value
target=""
if [ -n "$ret" ] && git rev-parse --verify --quiet "refs/heads/$ret" >/dev/null; then
	target="$ret"
elif [ -n "$base" ] && git rev-parse --verify --quiet "refs/heads/$base" >/dev/null; then
	target="$base"
fi
[ -n "$target" ] || die "could not determine a branch to return to; switch away manually first"

# Git refuses to switch to a branch checked out elsewhere. Ask before banking
# edits, transferring comments or moving a draft. Match the complete porcelain
# ref, without interpreting the worktree path or relying on newer Git atoms.
_save_worktrees="$(git worktree list --porcelain)" || die "could not check worktrees for the return branch '$target'"
if printf '%s\n' "$_save_worktrees" | grep -Fqx "branch refs/heads/$target"; then
	die "cannot save: return branch '$target' is checked out in another worktree; switch that worktree to a different branch and retry"
fi
review_guard_ignored_paths "refs/heads/$target" || exit 1

# Does the archive already hold a draft under the name this review would file its
# own under? The move at the end of this script is an mv: without this guard it
# replaced whatever was there and said nothing — the one place in the suite where
# hand-written prose was destroyed silently. A free review-saved/<src> is not
# enough, because two reviews can want one file name (start feature/x and compare
# develop origin/feature/x both draft for feature/x); asked of the paused reviews
# rather than of the file's name, for the same reason forget --draft --all has to.
#
# Refuse when a paused review still claims it (its prose is the only copy); replace
# it, out loud, when nothing does — an entry no review can reclaim is what
# forget --draft --all already sweeps. Checked here, before anything is written,
# while the move itself stays last: a guard that can still die has no business
# running after the review has been put aside. Conditioned on this review having a
# draft at all, on exactly the file test the move makes: no file, no mv, nothing to
# protect.
walk_gitdir_init
_save_draftsrc="$(walk_review_draft_src "$cur")"
_save_replaces=0
if [ -n "$_save_draftsrc" ] && [ -f "$(walk_draft_path "$_save_draftsrc")" ] &&
	[ -f "$(walk_saved_draft_path "$_save_draftsrc")" ]; then
	_save_claimant=""
	while IFS="$(printf '\t')" read -r _sc_name _sc_rb; do
		if [ "$_sc_name" = "$_save_draftsrc" ]; then
			_save_claimant="$_sc_rb"
			break
		fi
	done <<EOF
$(walk_saved_draft_claims)
EOF
	if [ -n "$_save_claimant" ]; then
		die "$_save_claimant is paused on a walkthrough draft for $_save_draftsrc, and this review would file its own under the same name; resume that review with 'git review continue' and finish or discard it, or discard it with 'git review forget --saved ${_save_claimant#review-saved/}', then save this one."
	fi
	_save_replaces=1
fi

# copy_meta <key>: copy branch.<cur>.<key> to branch.<saved>.<key> when set.
# The explicit if (rather than a && one-liner) keeps the function's exit status 0
# when the key is absent, so it does not trip set -e for the optional keys.
copy_meta() {
	review_config_read "branch.$cur.$1"
	v=$_review_config_value
	if [ -n "$v" ]; then
		git config "branch.$saved.$1" "$v"
	fi
}

if [ "$mode" = "step" ]; then
	review_config_read "branch.$cur.reviewstart"
	start=$_review_config_value
	review_config_read "branch.$cur.reviewcount"
	count=$_review_config_value
	review_config_read "branch.$cur.reviewstep"
	step=$_review_config_value
	# A key deleted by a hand-edit (while reviewmode stays "step") would otherwise
	# let set -e kill the bare read silently mid-script; read with || true and report
	# it. Unlike status/preview there is no later numeric guard, so cover step too.
	if [ -z "$start" ] || [ -z "$count" ] || [ -z "$step" ]; then
		die "missing review metadata; was $cur created with git review start? Discard the review with 'git review abort'."
	fi
	commits="$(git rev-list --reverse --first-parent --no-merges "$start..$tip")"

	# Bank the edits on the commit we are sitting on, the same way review-next does
	# before it moves, so the current step's work joins the other banked steps.
	cstep="$(printf '%s\n' "$commits" | sed -n "${step}p")"
fi

# Fail custody before capturing the review or reserving the destination.
comments_transfer "$cur" "$saved" || exit 1

tree=$(review_snapshot_worktree) || die 'could not capture the review working tree'
if [ "$mode" = "step" ]; then
	_save_edit=''
	if [ "$tree" != "$(git rev-parse "$cstep^{tree}")" ]; then
		_save_edit="$(git commit-tree "$tree" -p "$cstep" -m "review edits step $step")"
	fi
	_saved_commit=$tip
else
	lower="$(git rev-parse HEAD)"
	# The lower parent keeps a synthetic folded base reachable across a gc.
	_saved_commit="$(git commit-tree "$tree" -p "$tip" -p "$lower" -m "git review save: $src")"
fi

# The preflight is advisory. A branch can be created between that check and
# here. Reserve it with Git before copying or releasing any review state.
printf 'create refs/heads/%s %s\n' "$saved" "$_saved_commit" | git update-ref --no-deref --stdin ||
	die "could not create $saved"
_save_reserved=1

if [ "$mode" = "step" ]; then
	# The current step comes from the working tree. Skip the older bank entry
	# even when the reviewer reverted it to the original tree.
	review_copy_edit_refs edits saved-edits "$src" "$step"
	_step_dest="refs/review-saved-edits/$src/$step"
	if [ -n "$_save_edit" ]; then
		git update-ref "$_step_dest" "$_save_edit"
	elif _old_saved_edit=$(git show-ref --hash --verify "$_step_dest" 2>/dev/null); then
		git update-ref --no-deref -d "$_step_dest" "$_old_saved_edit"
	fi
	git config "branch.$saved.reviewmode" step
	copy_meta reviewstart
	copy_meta reviewcount
	copy_meta reviewstep
	note="on step $step/$count"
else
	git config "branch.$saved.reviewsavedlower" "$lower"
	if [ "$mode" = "walk" ]; then
		git config "branch.$saved.reviewmode" walk
		copy_meta reviewwalkstep
		copy_meta reviewwalkcount
		copy_meta reviewwalkkeys
		copy_meta reviewwalkfromdraft
		copy_meta reviewwalkbase
		review_config_read "branch.$cur.reviewwalkstep" '?'
		wstep=$_review_config_value
		review_config_read "branch.$cur.reviewwalkcount" '?'
		wcount=$_review_config_value
		note="walkthrough review on entry $wstep/$wcount"
	else
		git config "branch.$saved.reviewmode" whole
		note="whole-PR review"
	fi
fi

# Metadata common to both modes.
copy_meta reviewsource
copy_meta reviewbase
copy_meta reviewbasecommit
copy_meta reviewrangefrom
copy_meta reviewtip
copy_meta reviewprevreviewed
copy_meta reviewlocal
# Where this review's draft lives. Outside the mode branch, like the move below:
# a draft sits next to any mode, and a saved review that lost this name would have
# its archived draft looked up under the source instead — the wrong file, or none.
copy_meta reviewdraft
# compare reviews: finish must keep refusing after save → continue.
copy_meta reviewreadonly
copy_meta reviewcomparebase
copy_meta reviewcomparetarget
git config "branch.$saved.reviewreturn" "$target"

# Keep the live draft and edit bank until Git has left the review. The saved
# branch already owns a snapshot of the current working tree or the step edits.
# Give the checkout the captured index so it also removes newly added files
# that were untracked in the live index.
git read-tree "$tree"
if ! git switch -q --discard-changes --no-overwrite-ignore "$target"; then
	die "could not return to $target; the review and its saved code snapshot were kept"
fi

# Put the reviewer's own walkthrough draft where a paused review's reading order
# belongs, the same way the banked edits moved to refs/review-saved-edits/ above.
# Named by walk_review_draft_src, because the draft's branch is not always the
# review's — a compare of origin/feature/x drafts for feature/x — and moving the
# wrong name would leave the real file behind, in the namespace clean is
# hands-off in, owned by a review that no longer exists.
#
# Keep the source until the archived draft has a published owner.
#
# The gitdir is resolved here, in this shell: the two lookups below happen inside
# "$(...)", where a cache written by walk_draft_path dies with the subshell and
# each would spawn its own git rev-parse (see walk_gitdir_init).
walk_gitdir_init
draftsrc="$(walk_review_draft_src "$cur")"
_save_draft="$(walk_draft_path "$draftsrc")"
_save_filed=0
if [ -f "$_save_draft" ]; then
	_saved_draft="$(walk_saved_draft_path "$draftsrc")"
	mkdir -p "$(dirname "$_saved_draft")"
	# Said, not discovered: the guard above established that nothing can reclaim
	# what is there, but it is still prose someone typed, and this is the only mv in
	# the suite that lands on top of some.
	if [ "$_save_replaces" -eq 1 ]; then
		_save_draft_copy=$(mktemp "$_saved_draft.save.XXXXXX")
		cp "$_save_draft" "$_save_draft_copy"
		mv "$_save_draft_copy" "$_saved_draft"
		_save_draft_copy=''
		echo "note: replaced an archived walkthrough draft for $draftsrc that no paused review could restore" >&2
	else
		(set -C; cat "$_save_draft" >"$_saved_draft") || die "could not archive the draft at $_saved_draft"
	fi
	_save_filed=1
fi

# Whether this review is the one that filed the archived draft under its name, for
# every reader that has to tell two paused reviews of one branch apart
# (walk_saved_draft_filed). Written both ways, and only here, where the move has
# either happened or not: an absent key means "paused before this key existed", so
# leaving the 0 out would put every draftless review straight back in that bucket
# and hand it the next review's prose at continue.
git config "branch.$saved.reviewdraftfiled" "$_save_filed"

# The saved branch now holds the code and draft. Releasing the active branch
# also releases its config. Keep its bank until that deletion succeeds.
git branch -D "$cur" >/dev/null
_save_reserved=0
comments_transfer_commit || echo 'note: could not remove the comments rollback manifest' >&2
review_release_edit_refs || echo 'note: the original active edit refs were kept' >&2
if [ "$_save_filed" -eq 1 ] && cmp -s "$_save_draft" "$_saved_draft"; then
	rm -f "$_save_draft" || echo 'note: the original live draft was kept' >&2
fi

# Reporting must not hold Comments custody or change the successful result.
comments_unlock
if [ "$porcelain" -eq 1 ]; then
	set +e
	(review_saved_state)
	_reply_status=$?
	set -e
	if [ "$_reply_status" -ne 0 ]; then
		echo "note: review saved; final state could not be read" >&2
	fi
else
	echo "saved review of $src ($note) as $saved; returned to $target"
	echo "resume it with git review continue"
fi
