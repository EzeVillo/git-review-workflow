#!/usr/bin/env sh
#
# git review list — list every review/* branch in progress.
#
# git review status reports only the review on the current branch; this shows all
# of them at once, so you can see what you have open across branches. The current
# branch is marked with a "*".
#
# It also lists the review-fixes/* branches a finish left behind — the one kind of
# leftover no surface used to name. They are not reviews (nothing to resume), so
# they come last and under their own heading, with what git can say about how safe
# each one is to drop: whether it still holds commits the base does not have.
#
set -eu

prog="git review list"

usage() {
	cat <<EOF
usage: $prog [--porcelain]

List every review/* branch in progress, with its source PR, mode and — in
commit-by-commit mode — which commit you are on ([k/N]). The branch you are on
is marked with a "*". Reviews paused with git review save are listed too, under
"saved", and the review-fixes/* branches left by a finish under "fixes".

  --porcelain     machine-readable output (see the README for the format)
EOF
}

porcelain=0
case "${1:-}" in
-h | --h)
	usage
	exit 0
	;;
--porcelain)
	porcelain=1
	;;
"") ;;
*)
	echo "error: unexpected argument $1" >&2
	usage >&2
	exit 1
	;;
esac

git rev-parse --git-dir >/dev/null 2>&1 || {
	echo "error: not a git repository" >&2
	exit 1
}

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"


(review_list_report "$porcelain")
