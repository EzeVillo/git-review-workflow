#!/usr/bin/env sh
#
# git review compare <a> <b> — stage the diff between two commit-ish, read-only.
#
# Unlike git review start there is no writable source branch: it materialises the
# diff <a>..<b> (<a> the lower bound, <b> the tip) as a staged review you can
# annotate inline, and git review finish refuses on it. --step walks the range one
# commit at a time, like start --step, advancing with git review next.
#
set -eu

prog="git review compare"

usage() {
	cat <<EOF
usage: $prog <a> <b> [--step | --no-walk | --keys]

Stage the diff between two commit-ish on a review/<b> branch for inline reading.
This is a read-only review: there is no branch to write back to, so git review
finish refuses on it.

  <a>        the lower bound (a branch, tag or commit) — what to diff from
  <b>        the upper bound — what to diff to; names the review branch
  --step     read one commit at a time; advance with git review next
  --no-walk  ignore any walkthrough on <b>; read the whole diff
  --keys     walk mode restricted to entries marked > key (requires a
             walkthrough with at least one key in range; not with --step
             or --no-walk)
EOF
}

die() {
	echo "error: $1" >&2
	exit 1
}

a=""
b=""
have_a=0
have_b=0
step=0
no_walk=0
keys_only=0
# Collect the two positional commit-ish; mirror start's parser, including -- as the
# end-of-options separator so a commit-ish that starts with "-" stays positional.
add_positional() {
	if [ "$have_a" -eq 0 ]; then
		a="$1"
		have_a=1
	elif [ "$have_b" -eq 0 ]; then
		b="$1"
		have_b=1
	else
		die "unexpected argument $1"
	fi
}
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --h)
		usage
		exit 0
		;;
	--step) step=1 ;;
	--no-walk) no_walk=1 ;;
	--keys) keys_only=1 ;;
	--)
		shift
		while [ $# -gt 0 ]; do
			add_positional "$1"
			shift
		done
		break
		;;
	-*)
		echo "error: unknown option $1" >&2
		usage >&2
		exit 1
		;;
	*)
		add_positional "$1"
		;;
	esac
	shift
done

if [ "$have_a" -ne 1 ] || [ "$have_b" -ne 1 ]; then
	die "need two commit-ish to compare: $prog <a> <b>"
fi

if [ "$keys_only" -eq 1 ]; then
	if [ "$step" -eq 1 ]; then
		die "--keys cannot be combined with --step"
	fi
	if [ "$no_walk" -eq 1 ]; then
		die "--keys cannot be combined with --no-walk"
	fi
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# shellcheck source=../git-review-lib.sh
. "${GIT_REVIEW_LIBEXEC:?}/git-review-lib.sh"

acommit="$(git rev-parse --verify --quiet "$a^{commit}")" || die "unknown commit: $a"
bcommit="$(git rev-parse --verify --quiet "$b^{commit}")" || die "unknown commit: $b"
[ "$acommit" != "$bcommit" ] || die "$a and $b are the same commit; nothing to compare"

require_clean_work_tree

# Remember where to return to when the compare is aborted.
returnbranch="$(git symbolic-ref --quiet --short HEAD || true)"

# A refname-safe identity for the review branch, taken from <b> (the tip). A tag
# or branch name passes through for a readable review/<b>; anything git would
# reject as a ref component (HEAD~3, a^, x:y) falls back to <b>'s short hash, so
# the branch and refs/review-edits/<name>/* stay valid. Identity for
# status/list/clean only, never a writeback target — compare is read-only.
if git check-ref-format "review/$b" 2>/dev/null; then
	name="$b"
else
	name="$(git rev-parse --short "$bcommit")"
fi

rb="review/$name"
git rev-parse --verify --quiet "refs/heads/$rb" >/dev/null &&
	die "$rb already exists; run git review clean $name first"
git rev-parse --verify --quiet "refs/heads/review-saved/$name" >/dev/null &&
	die "you have a saved review of $name; resume it with git review continue $name or discard it with git review forget --saved $name"

# The draft context, set only when <b> actually names a branch the reviewer has
# drafted for: compare is the one reader that works with revisions, and two SHAs
# or tags have no reading order but the PR's own. A local branch is its own source
# name; a remote-tracking one is the name minus its remote's first segment —
# stripping to the last segment would look up "checkout" for feature/checkout.
#
# This is the SINGLE derivation of a draft name in the suite. It is recorded below
# (reviewdraft) and read back from there ever after, so the name a draft is written
# under and the name it is looked up under cannot come from two computations: they
# used to, invisibly — the draft written from inside this review went to
# origin/feature/x while every other entry point looked under feature/x.
#
# Above the --step branch, because that branch exits: below it, a compare --step of
# a remote-tracking branch recorded no name at all and every reader fell back to
# the review's source.
draftsrc="$name"
if git rev-parse --verify --quiet "refs/heads/$b" >/dev/null; then
	draftsrc="$b"
	walk_use_draft "$draftsrc"
elif git rev-parse --verify --quiet "refs/remotes/$b" >/dev/null; then
	draftsrc="${b#*/}"
	walk_use_draft "$draftsrc"
fi

if [ "$step" -eq 1 ]; then
	# --first-parent --no-merges: walk only the range's own commits, skipping merge
	# commits, exactly like start --step so git review next/prev behave identically.
	commits="$(git rev-list --reverse --first-parent --no-merges "$acommit..$bcommit")"
	[ -n "$commits" ] || die "no commits to compare in range $a..$b"
	count="$(printf '%s\n' "$commits" | wc -l | tr -d ' ')"
	first="$(printf '%s\n' "$commits" | sed -n '1p')"

	git switch -q -c "$rb" "$first" || die "could not create $rb"
	git reset --soft HEAD^
	git config "branch.$rb.reviewsource" "$name"
	git config "branch.$rb.reviewbase" "$a"
	git config "branch.$rb.reviewtip" "$bcommit"
	git config "branch.$rb.reviewstart" "$acommit"
	git config "branch.$rb.reviewmode" "step"
	git config "branch.$rb.reviewcount" "$count"
	git config "branch.$rb.reviewstep" "1"
	git config "branch.$rb.reviewreadonly" "1"
	# The draft's name, from the single derivation above — see the whole-mode write
	# below. A step review reads no walkthrough but still holds custody of one.
	git config "branch.$rb.reviewdraft" "$draftsrc"
	if [ -n "$returnbranch" ]; then
		git config "branch.$rb.reviewreturn" "$returnbranch"
	fi

	echo "$rb ready (compare $a..$b, read-only) — walking $count commit(s) one at a time"
	show_commit "$first" 1 "$count"
	exit 0
fi

# Walkthrough auto-detection, exactly like git review start: a .review/walkthrough.md
# on <b> whose entries intersect the range enters walk mode, which only adds a
# reading cursor — reviewreadonly is set below either way, so finish refuses in
# every mode. --keys fails before the branch is created when there is no walk or
# no key in range (same as start).
walk=0
walkcount=0
keys_filter=0
if [ "$no_walk" -eq 0 ] && wtcontent="$(walk_read "$bcommit")" && [ -n "$wtcontent" ]; then
	guided="$(walk_sequence "$bcommit" "$acommit")"
	# grep -c returns 1 (aborting under set -e in POSIX sh) on an empty sequence.
	guidedcount="$(printf '%s\n' "$guided" | grep -c . || true)"
	if [ "$guidedcount" -ge 1 ]; then
		walk=1
		if [ "$keys_only" -eq 1 ]; then
			walkpaths="$(walk_keys_order "$bcommit" "$acommit")"
			walkcount="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
			if [ "$walkcount" -lt 1 ]; then
				die "--keys requires at least one walkthrough entry marked > key in range; mark keys or compare without --keys"
			fi
			keys_filter=1
		else
			walkpaths="$(walk_reading_order "$bcommit" "$acommit")"
			walkcount="$(printf '%s\n' "$walkpaths" | grep -c . || true)"
		fi
	else
		if [ "$keys_only" -eq 1 ]; then
			die "--keys requires a walkthrough with entries in range; none apply to $a..$b"
		fi
		degradedfiles="$(range_files "$bcommit" "$acommit" | tr '\n' ' ')"
		# Attributed to whoever wrote the order that failed to apply, as start does:
		# the draft belongs to the branch, which for a remote-tracking <b> is not
		# even spelled the same as the review.
		if [ -n "${walk_draft_src:-}" ] && walk_is_draft "$walk_draft_src"; then
			echo "note: you have a walkthrough draft for $walk_draft_src, but none of its entries apply to $a..$b; reading the whole diff: $degradedfiles"
		else
			echo "note: $b has a walkthrough, but none of its entries apply to $a..$b; reading the whole diff: $degradedfiles"
		fi
	fi
elif [ "$keys_only" -eq 1 ]; then
	die "--keys requires a walkthrough on $b; none found (or compare without --keys)"
fi

# Whole range: create review/<name> at <b> and soft-reset to <a> so the staged diff
# is exactly <a>..<b>, with a clean working tree — the same shape as start, minus the
# merged-base folding (compare's bounds are explicit) and any writeback metadata.
git switch -q -c "$rb" "$bcommit" || die "could not create $rb"
git reset -q --soft "$acommit"

git config "branch.$rb.reviewsource" "$name"
git config "branch.$rb.reviewbase" "$a"
git config "branch.$rb.reviewtip" "$bcommit"
git config "branch.$rb.reviewreadonly" "1"
# Where this review's draft lives, from the single derivation above. Recorded in
# every mode and whether or not a draft exists yet, because the surfaces that need
# it are not the walk ones: a draft written inside a whole-mode compare, and its
# custody in list, save, continue and forget. For a loose revision it is the
# review's own identity — the only name a comparison has.
git config "branch.$rb.reviewdraft" "$draftsrc"
if [ -n "$returnbranch" ]; then
	git config "branch.$rb.reviewreturn" "$returnbranch"
fi

if [ "$walk" -eq 1 ]; then
	git config "branch.$rb.reviewmode" "walk"
	git config "branch.$rb.reviewwalkstep" "1"
	git config "branch.$rb.reviewwalkcount" "$walkcount"
	# The base HEAD was just pinned to, so the cursor's diagnostics can ask git
	# whether HEAD moved instead of inferring it (walk_at_base). Same key as start.
	git config "branch.$rb.reviewwalkbase" "$(git rev-parse HEAD)"
	if [ "$keys_filter" -eq 1 ]; then
		git config "branch.$rb.reviewwalkkeys" "1"
	fi
	# Whether this reading order came from the reviewer's own draft — the same flag
	# start writes, for the same diagnostics. The name is reviewdraft above; this
	# says only that the order being walked is the one in that file.
	if [ -n "${walk_draft_src:-}" ] && walk_is_draft "$walk_draft_src"; then
		git config "branch.$rb.reviewwalkfromdraft" "1"
	fi

	if [ "$keys_filter" -eq 0 ]; then
		# Files in range with no walkthrough entry: appended to the end of the reading
		# order (walk_reading_order), so name them rather than let them be discovered
		# silently — same as start.
		uncovered="$(printf '%s\n' "$walkpaths" | tail -n +"$((guidedcount + 1))")"
		if [ -n "$uncovered" ]; then
			echo "note: file(s) in range not in the walkthrough are added to the end of the reading order: $(printf '%s\n' "$uncovered" | tr '\n' ' ')"
		fi

		keycount="$(printf '%s\n' "$walkpaths" | walk_count_keys "$bcommit")"
		keysuffix=""
		if [ "$keycount" -ge 1 ]; then
			keysuffix=" ($keycount key)"
		fi
		echo "$rb ready (compare $a..$b, read-only walkthrough$keysuffix) — read, then git review next (git review finish will refuse)"
	else
		echo "$rb ready (compare $a..$b, read-only walkthrough keys-only: $walkcount key$([ "$walkcount" -eq 1 ] || echo s)) — read, then git review next (git review finish will refuse)"
	fi
	# The author's heads-up, once, before the first entry — same as in start.
	headsup="$(printf '%s\n' "$wtcontent" | walk_preamble)"
	if [ -n "$headsup" ]; then
		printf -- '----\n%s\n' "$headsup"
	fi
	cur="$rb"
	tip="$bcommit"
	total="$walkcount"
	show_walk_entry 1
else
	echo "$rb ready (compare $a..$b, read-only) — the staged diff is for reading; git review finish will refuse"
fi
