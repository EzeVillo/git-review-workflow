<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="com.ezevillo.gitreview.vs" Version="0.1.0" Language="en-US" Publisher="EzeVillo" />
    <DisplayName>git review workflow</DisplayName>
    <!-- Reader-facing copy, not a summary of the monorepo: no sibling clients, no
         restating the supported-VS list the gallery already shows. Opens with the
         shared tagline (contracts/client-product-surface.yaml → listing.tagline). -->
    <Description xml:space="preserve">Walk a PR in order, then edit and run it — not just read the diff. git review stages the entire pull request into your working tree as uncommitted changes, so reviewing it is ordinary local work: go to a definition, run the tests, fix what you find. Your fixes are then extracted onto a branch of their own, leaving the author's commits exactly as they were. The tool window keeps your place: the reading order the author wrote, one file at a time with the reason each change is there. Requires the git review command-line tool.</Description>
    <MoreInfo>https://github.com/EzeVillo/git-review-workflow/tree/main/visualstudio-extension#readme</MoreInfo>
    <License>..\..\LICENSE</License>
    <GettingStartedGuide>..\..\README.md</GettingStartedGuide>
    <ReleaseNotes>..\..\CHANGELOG.md</ReleaseNotes>
    <!-- Same product mark as VS Code (media/icon.png) and JetBrains pluginIcon. -->
    <Icon>Resources\Icon.png</Icon>
    <PreviewImage>Resources\Icon-256.png</PreviewImage>
    <Tags>git; review; pull request; code review; walkthrough; scm; diff</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
